{
  "schema": "TERRITORIAL_OBSERVATION_CONTRACT_V1",
  "required_constituencies": 52,
  "required_seats": 350,
  "input_type": "explicit_constituency_poll_or_other_explicit_territorial_observation",
  "allowed": [
    "party_votes_by_constituency",
    "party_vote_shares_by_constituency",
    "territorial_draws_with_provenance"
  ],
