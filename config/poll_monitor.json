{
  "schema": "POLL_MONITOR_CONFIG_V3",
  "coverage_contract": {
    "scope": "configured_national_poll_universe",
    "require_all_nonoptional_sources_healthy": true,
    "require_structured_primary_extractors": true,
    "require_zero_unresolved_discoveries": true,
    "require_zero_unresolved_source_failures": true,
    "require_primary_registry_reviewed": true,
    "claim": "COBERTURA_TOTAL_VERIFICADA"
  },
  "timezone": "Europe/Madrid",
  "sources": [
    {
      "id": "cis_rss",
      "name": "CIS (RSS legacy)",
      "url": "https://www.cis.es/cis/opencm/ES/1_encuestas/estudios/rss.xml",
      "format": "rss",
      "method": "GET",
      "disabled": true,
      "reason": "legacy endpoint returns HTTP 410; use CIS catalog/news discovery",
      "coverage_role": "discovery"
    },
    {
      "id": "electomania_ajax",
      "name": "Electomanía — catálogo público",
      "url": "https://electomania.es/encuestas/",
      "format": "page",
      "coverage_role": "discovery",
      "reason": "El endpoint AJAX legacy devuelve HTTP 400; se monitoriza el catálogo público como capa de descubrimiento."
    },
    {
      "id": "cis_catalog",
      "name": "CIS catálogo",
      "url": "https://www.cis.es/es/estudios/catalogo",
      "format": "page",
      "method": "GET",
      "coverage_role": "discovery"
    },
    {
      "id": "cis_news",
      "name": "CIS noticias",
      "url": "https://www.cis.es/es/sala-prensa/noticias",
      "format": "page",
      "method": "GET",
      "coverage_role": "discovery"
    },
    {
      "id": "elpais_40db",
      "name": "EL PAÍS / 40dB",
      "url": "https://elpais.com/noticias/encuestas-electorales/",
      "format": "national_html",
      "method": "GET",
      "pollster": "40dB",
      "coverage_role": "primary",
      "reason": "Ruta pública actual + rutas alternativas; no usar el endpoint AMP obsoleto como ruta primaria.",
      "alternate_urls": [
        "https://elpais.com/noticias/barometro-el-pais/",
        "https://elpais.com/noticias/encuestas/"
      ]
    },
    {
      "id": "datoelectoral",
      "name": "Dato Electoral",
      "url": "https://www.datoelectoral.es/encuestas",
      "format": "datoelectoral_html",
      "method": "GET",
      "coverage_role": "discovery"
    },
    {
      "id": "europe_elects_spain",
      "name": "Europe Elects",
      "url": "https://europeelects.eu/spain/",
      "format": "page",
      "method": "GET",
      "coverage_role": "discovery"
    },
    {
      "id": "myfdata",
      "name": "MyF Data",
      "url": "https://www.myfdata.com/elecciones-generales/",
      "format": "national_html",
      "method": "GET",
      "coverage_role": "discovery",
      "disabled": true,
      "reason": "Endpoint rechazado por conexión (111) y no se ha localizado publicación electoral activa verificable en 2026; conservar como fuente histórica, no como bloqueo operativo."
    },
    {
      "id": "sigma_dos",
      "name": "Sigma Dos",
      "url": "https://www.sigmados.com/",
      "format": "national_html",
      "method": "GET",
      "coverage_role": "primary",
      "reason": "Sustituido el endpoint EL MUNDO obsoleto por el sitio oficial de Sigma Dos."
    },
    {
      "id": "gad3",
      "name": "GAD3",
      "url": "https://www.gad3.com/informes/",
      "format": "national_html",
      "method": "GET",
      "pollster": "GAD3",
      "coverage_role": "primary"
    },
    {
      "id": "nc_report",
      "name": "NC Report",
      "url": "https://ncreport.es/",
      "format": "national_html",
      "method": "GET",
      "pollster": "NC Report",
      "coverage_role": "primary"
    },
    {
      "id": "demoscopia",
      "name": "Demoscopia",
      "url": "https://www.demoscopia.es/encuestas/",
      "format": "national_html",
      "method": "GET",
      "coverage_role": "primary"
    },
    {
      "id": "celeste_tel",
      "name": "Celeste-Tel",
      "url": "https://www.celeste-tel.es/",
      "format": "national_html",
      "method": "GET",
      "pollster": "Celeste-Tel",
      "coverage_role": "primary"
    },
    {
      "id": "invymark",
      "name": "Invymark",
      "url": "https://invymark.es/",
      "format": "national_html",
      "method": "GET",
      "coverage_role": "primary",
      "reason": "El dominio oficial presenta un fallo TLS observable; no se desactiva la verificación SSL. La cobertura secundaria se controla por medios que publican sus barómetros."
    },
    {
      "id": "political_stats_spain",
      "name": "Political Stats",
      "url": "https://politicalstats.eu/spain",
      "format": "page",
      "method": "GET",
      "coverage_role": "discovery"
    },
    {
      "id": "europe_elects_twitter",
      "name": "Europe Elects X",
      "url": "https://api.twitter.com/2/users/{user_id}/tweets",
      "format": "twitter",
      "method": "GET",
      "user_id": "",
      "optional": true,
      "coverage_role": "discovery"
    },
    {
      "id": "lasexta_invymark_discovery",
      "name": "laSexta — barómetros InvyMark",
      "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html",
      "format": "page",
      "method": "GET",
      "coverage_role": "discovery",
      "reason": "Capa secundaria para detectar nuevas publicaciones de InvyMark mientras su dominio oficial no es accesible por TLS."
    }
  ],
  "policy": {
    "no_search_engine_inference": true,
    "no_unverified_poll_values": true,
    "no_national_to_territorial_conversion": true,
    "fail_closed": true,
    "alert_on_new_or_changed_validated_poll": true,
    "alert_on_persistent_source_failure": true,
    "alert_discovery_source_failure": false
  }
}
