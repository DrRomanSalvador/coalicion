{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coalicion canonical Congress 2023 matrix",
  "type": "object",
  "required": [
    "source",
    "election",
    "data"
  ],
  "properties": {
    "source": {
      "const": "INTERIOR_PRIMARY"
    },
    "election": {
      "const": "2023"
    },
    "data": {
      "type": "object",
      "required": [
        "constituencies"
      ],
      "properties": {
        "constituencies": {
          "type": "object",
          "minProperties": 52,
          "maxProperties": 52,
          "additionalProperties": {
            "type": "object",
            "required": [
              "seats",
              "parties",
              "blank_votes",
              "valid_votes"
            ],
            "properties": {
              "seats": {
                "type": "integer",
                "minimum": 1
              },
              "blank_votes": {
                "type": "integer",
                "minimum": 0
              },
              "valid_votes": {
                "type": "integer",
                "minimum": 0
              },
              "parties": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "source_tier": {
      "enum": [
        "OFFICIAL_PRIMARY",
        "SECONDARY_REPLICA_VERIFIED"
      ]
    }
  }
}
