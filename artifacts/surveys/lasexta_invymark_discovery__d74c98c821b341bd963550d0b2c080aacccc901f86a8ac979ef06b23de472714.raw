<meta name="msvalidate.01" content="DDBC2D36D801A1BEEF59505F4B1610AF"><meta name="site-name" content="LaSexta"/><meta name="cms-path" content="lasexta"/><meta name="tipo-pagina" content="contenido"/><meta name="error" content="false" /><meta name="articleId" content="6ac362bdcf334000070b26f5"/><script type="application/ld+json"> { "@context": "https://schema.org", "@type": "LiveBlogPosting", "@id":"#liveBlogPosting", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "headline": "Así van las encuestas y sondeos de las elecciones generales de 2026", "description": "Las encuestas y sondeos sobre intención de voto se publican incluso antes de cualquier convocatoria. Sigue en laSexta.com los datos que ofrecen las encuestas publicadas hasta ahora y de cara al día de las elecciones. ", "datePublished": "2026-10-08T09:26:36+02:00", "dateModified": "2026-10-08T09:26:36+02:00", "coverageStartTime": "2026-10-05T06:00:00+02:00", "coverageEndTime": "2026-11-25T06:00:00+01:00", "author": [ { "@type": "Person", "name": "laSexta.com", "url": "https://www.lasexta.com/autores/lasextacom/", "sameAs":[ "https://twitter.com/laSextaTV", "https://www.facebook.com/laSexta/", "https://www.instagram.com/lasexta/", "https://www.youtube.com/user/misextatv"] } ], "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": [ { "@type": "ImageObject", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "width": 1280, "height": 720 } ], "liveBlogUpdate": [ { "@type": "BlogPosting", "@id": "#3f336d4e-4c0a-400e-aaf9-c38c4b344032", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#3f336d4e-4c0a-400e-aaf9-c38c4b344032", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T10:38:31+02:00", "dateModified": "2026-10-05T10:38:31+02:00", "headline": "Barómetro laSexta | Alberto Núñez Feijóo ganaría las próximas elecciones con un 33,7% de los votos", "articleBody": "Los resultados del último barómetro de intención de voto de laSexta, publicado a mediados de septiembre, sitúan al PP como primera fuerza política en base a los datos recabados por el Instituto Invymark.Según los mismos, la formación liderada por Alberto Núñez Feijóo ganaría las próximas elecciones con un 33,7% de los votos, es decir, unas décimas por encima de lo obtenido en los comicios de 2023.Por detrás quedaría el PSOE con un 26,8%, que registraría una pérdida de cinco puntos desde las últimas elecciones. Toda esa diferencia y un punto más todavía subiría Vox, que recoge un 18,6% en la intención de voto. Sumar quedaría como cuarta fuerza, aunque solo rascaría un 6,1%. Podemos, con un 3,3%, y Se Acabó la Fiesta, con un 1,9%, cerrarían la intención de voto.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#129a0b20-2ad6-45c4-99da-ca3af16d5757", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#129a0b20-2ad6-45c4-99da-ca3af16d5757", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T11:10:52+02:00", "dateModified": "2026-10-05T11:10:52+02:00", "headline": "El bloque de la derecha ganaría las elecciones gracias al impulso de Vox (encuesta 40db.)", "articleBody": "El bloque de la derecha ganaría las elecciones generales, según el sondeo 40db. para el grupo Prisa publicado hoy, 5 de octubre, mismo día en que Pedro Sánchez ha anunciado la decisión del Gobierno de disolver las Cortes Generales y convocar elecciones adelantadas para el 29 de noviembre. Los resultados de esta encuesta apuntan a una victoria de las derechas, gracias al impulso de Vox, que subiría seis puntos con respecto a los resultados obtenidos en 2023, a pesar de que el PP podría no llegar a los números conseguidos hace tres años y medio, cuando sumó un 33,05% (se quedaría en el 31,6%). Por su parte, en la izquierda el PSOE perdería cuatro puntos, mientras que la encuesta ofrece datos de intención de voto de Sumar y Podemos por separado, cuando en 2023 concurrieron de manera conjunta bajo la coalición Sumar.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#463dc089-8e34-4489-8bbb-fd5930cfe97f", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#463dc089-8e34-4489-8bbb-fd5930cfe97f", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T11:52:41+02:00", "dateModified": "2026-10-05T11:52:41+02:00", "headline": "El bloque PP-Vox supera con mucha ventaja la mayoría absoluta (encuesta Sigma Dos)", "articleBody": "En línea con lo que muestran otras encuestas, el sondeo de Sigma Dos para el diario \"El Mundo\" publicado ayer, en víspera del anuncio de Pedro Sánchez de convocatoria de las elecciones, apunta a una victoria clara de las derechas el 29 de noviembre, cuando se han fijado las elecciones adelantadas. La convocatoria de comicios llega en un momento en el que el bloque de PP y Vox supera los 200 escaños, mientras la izquierda pierde fuelle, marcado por la caída del PSOE —que perdería 18 escaños— y la incertidumbre en los partidos a la izquierda del PSOE. La coalición Sumar, que Podemos integró en las elecciones de 2023, bajaría de 31 a nueve escaños, mientras que Podemos, de concurrir en solitario, sólo sumaría dos asientos en el Congreso. En los próximos días, el Frente Amplio, nomenclatura bajo la que se presentará Sumar a estas elecciones, anunciará a su candidato o candidata, con Mónica García, actual ministra de Sanidad, presentándose como posible cabeza de lista.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#f58752f4-5e9c-4ef9-8ad4-65d8e5e390fa", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#f58752f4-5e9c-4ef9-8ad4-65d8e5e390fa", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T12:26:00+02:00", "dateModified": "2026-10-05T12:26:00+02:00", "headline": "PP-Vox sumarían 204 escaños, muy por delante de la mayoría absoluta, frente a un PSOE-Sumar que cae a 112 esca", "alternativeHeadline": "PP-Vox sumarían 204 escaños, muy por delante de la mayoría absoluta, frente a un PSOE-Sumar que cae a 112 escaños", "articleBody": "Es tiempo de encuestas. De cara a las elecciones generales, que se celebran el 29 de noviembre después de que Pedro Sánchez decidiera adelantar los comicios, todo apunta, por ahora y si no hay cambios, a que es posible que gobierne la derecha, aunque obligaría a Alberto Núñez Feijóo a negociar con Vox, que tendría que entrar en el Ejecutivo. Porque PP y PSOE, por separado, no serían capaces de formar Gobierno de ninguna de las maneras. Con los datos de la encuesta de Wilson elaborada para \"Artículo 14\" y publicada el mismo día de la convocatoria, el bloque PP-Vox no sólo llegaría a la mayoría absoluta, sino que la superaría con un amplísimo margen, alcanzando los 204 escaños. En el otro lado, el bloque PSOE-Sumar, que consiguió llegar a un acuerdo en 2023 para gobernar en coalición —pese a que fue el PP el ganador de la jornada electoral—, se quedaría en 112 escaños, muy lejos de los 176 que marcan la mayoría absoluta en el Congreso de los Diputados.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#62cbd835-976c-4c5e-84f3-4db50fc34707", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#62cbd835-976c-4c5e-84f3-4db50fc34707", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T12:53:00+02:00", "dateModified": "2026-10-05T12:53:00+02:00", "headline": "Simancas quita peso a las encuestas: \"Resultado 2026: más Pedro Sánchez presidente\"", "articleBody": "El secretario de Estado de Relaciones con las Cortes, Rafael Simancas, ha quitado hierro a los resultados que ofrecen las encuestas de cara a las elecciones generales, que apuntan a una victoria holgada para la derecha, supeditando un Gobierno de derechas, no obstante, al acuerdo entre el PP y Vox. Sí, los sondeos dan como vencedor al PSOE, pero para Simancas esto no es significativo, sino que lo es el hecho de que en 2023 las encuestas apuntaban en la misma dirección y Pedro Sánchez acabó siendo presidente. En alusión al sondeo de 40db. para el grupo Prisa, que da un 31,6% al PP y un 27,4% al PSOE, Simancas asegura: \"Resultado elecciones 2026: más Pedro Sánchez presidente\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#6daa8e1b-eaa9-4897-8fc4-e3bfe0737193", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#6daa8e1b-eaa9-4897-8fc4-e3bfe0737193", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T13:38:00+02:00", "dateModified": "2026-10-05T13:38:00+02:00", "headline": "Vox duplicaría su presencia en el Congreso: podría conseguir casi un 19% de los escaños", "articleBody": "De cara a las elecciones generales del 29 de noviembre, el PP ganaría dos escaños y el PSOE perdería 11. Son datos significativos, pero en cada bloque ideológico tiene unas consecuencias: en el bloque de la izquierda, sería imposible formar gobierno, porque la caída del PSOE se suma a la de Sumar, que sólo mantendría cinco de los 31 escaños que ostenta hasta ahora. Estos, con los cuatro de Podemos, se quedarían en 120 escaños, insuficientes incluso en el caso de que llegaran a un acuerdo de coalición. Sin embargo, en el bloque de la derecha los dos escaños del PP son irrelevantes, porque la importancia está en el brutal ascenso de Vox, que podría llegar a los 64 escaños, casi el doble de los que consiguió en 2023, según la encuesta de Data10 para \"OKDiario\" publicada hoy. Esto dejaría a los de Santiago Abascal con casi un 19% de los escaños del Congreso de los Diputados, lo que le daría fuerza suficiente para negociar un gobierno de coalición de derechas con la ultraderecha con mucho poder.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#23c54497-ac20-4163-87ed-bf6fc81aa764", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#23c54497-ac20-4163-87ed-bf6fc81aa764", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T13:52:00+02:00", "dateModified": "2026-10-05T13:52:00+02:00", "headline": "⚠️ Recuerda: todas las encuestas publicadas hoy se hicieron antes de la convocatoria del adelanto electoral", "articleBody": "Evaluar unos posibles resultados de unas elecciones con los datos que arrojan encuestas electorales es importante, pero también lo es tener en cuenta otros factores, como el momento en el que se han realizado estos sondeos y también la muestra utilizada para los mismos. La mayor parte de las encuestas se realizan con entrevistas a entre mil y 2.000 personas, aproximadamente, pero siempre hay que contextualizar los sondeos: todos los que se han publicado hoy y en los últimos días fueron realizados antes de la convocatoria electoral, por lo que los resultados pueden ser diferentes a los que muestren los sondeos después de la convocatoria.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#34127372-8439-433b-a80f-a84191469f35", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#34127372-8439-433b-a80f-a84191469f35", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T14:26:00+02:00", "dateModified": "2026-10-05T14:26:00+02:00", "headline": "El último CIS aumentaba la ventaja del PSOE sobre el PP, incluso tras la crisis de Ceuta", "articleBody": "La crisis de Ceuta ha ido pasando factura al PSOE en sus expectativas electorales, aunque no por mucho ya que el barómetro de José Félix Tezanos sigue manteniendo a los socialistas como el partido más votado. Según el último barómetro del Centro de Investigaciones Sociológicas (CIS), publicado a mediados de septiembre, el partido del Gobierno pierde dos puntos en intención de voto, hasta un 31%.Por su parte, el PP reduce a 5,5 puntos su distancia con los socialistas, con un 25,5% de intención de voto, 0,4 puntos más que en julio. En tercer lugar, Vox crece 1,3 puntos y sigue como tercera fuerza con un 16,6% de intención de voto. Sumar sigue perdiendo y se queda con un 5,7%, 0,4 puntos menos que en julio. Por tanto, la crisis de Ceuta catapulta el voto a Vox y penaliza al PSOE, PP y Sumar.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#8ad6dfa7-eda0-44d7-907c-65e9f0fbcc3a", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#8ad6dfa7-eda0-44d7-907c-65e9f0fbcc3a", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T15:01:00+02:00", "dateModified": "2026-10-05T15:01:00+02:00", "headline": "Baldoví confía en darle la vuelta a las encuestas y asegura que Compromís construirá una candidatura valencian", "alternativeHeadline": "Baldoví confía en darle la vuelta a las encuestas y asegura que Compromís construirá una candidatura valenciana abierta", "articleBody": "Joan Baldoví, síndic de Compromís en Les Corts, reflexiona sobre si el presidente acierta o no al adelantar las elecciones generales, sobre si es un buen momento o no para la izquierda y si es posible, por ende, revalidar el actual Gobierno progresista.\"Creo que no tenía otra. Ante la constatación de que realmente no se podían aprobar unos decretos de mínimos en el tema de la vivienda y, además, de que por primera vez el de la de vivienda se metía en el debate, creo que tenía pocas opciones y pocas oportunidades\", asegura Baldoví.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#5d75c304-0fa8-415f-9fdf-7fa5968cef9c", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#5d75c304-0fa8-415f-9fdf-7fa5968cef9c", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T15:46:00+02:00", "dateModified": "2026-10-05T15:46:00+02:00", "headline": "Maíllo (Frente Amplio) confía en darle la vuelta a las encuestas: \"Abrazamos a los que quieran sumarse\"", "articleBody": "El coordinador federal de Izquierda Unida, Antonio Maíllo, ha asegurado que Frente Amplio afronta el gran debate que se establece con el adelanto de elecciones generales, asegurando que esta coalición, que nace para el 29N, está \"preparado\" para seguir abrazando a más organizaciones. Hasta ahora, Frente Amplio está conformada por Sumar, IU, Más Madrid y Catalunya en Comú. Maíllo ha asegurado que FA tiene que estar \"a la altura\" en un \"momento histórico\" y ha resaltado cómo uno de los elementos diferenciales del último Gobierno de Pedro Sánchez ha sido, precisamente, la presencia de la coalición Sumar. \"Lo demostramos con la reforma laboral y con las medidas de vivienda que hasta hace poco decían que eran imposibles\", ha señalado, insistiendo en que Frente Amplio está \"preparado\" para lo que viene. \"Abrazamos a los que quieran sumarse. Vamos a dar la vuelta a las encuestas\". Los últimos sondeos publicados dan a Sumar una caída considerable, con entre cinco y seis escaños.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#bd4c7210-d024-41b7-a17f-eb601c021952", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#bd4c7210-d024-41b7-a17f-eb601c021952", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T16:38:00+02:00", "dateModified": "2026-10-05T16:38:00+02:00", "headline": "Vox amplía el espacio que ocuparía en el Congreso: el sondeo de Sociométrica le da un 18,1% de los votos", "articleBody": "Más de seis puntos subiría Vox estas elecciones generales, programadas para el 29 de noviembre (después de que Pedro Sánchez haya anunciado el adelanto), según los datos de la encuesta de Sociométrica publicada hoy mismo. Es el dato más reseñable de un sondeo que va en la misma dirección que los hasta ahora publicados, todos extraídos de entrevistas realizadas antes de la convocatoria, muy cerca del inicio de las protestas por la vivienda que han acabado en grandes manifestaciones y acampadas en diferentes puntos de país.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#6dbfc1ff-7fea-4b13-ac01-3e4c916f1c25", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#6dbfc1ff-7fea-4b13-ac01-3e4c916f1c25", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T17:26:00+02:00", "dateModified": "2026-10-05T17:26:00+02:00", "headline": "Las encuestas internas del PSOE apuntan a un resultado similar al de 2026", "articleBody": "Con la caída de los decretos de vivienda y la movilización ciudadana tras el desahucio de Maricarmen Abascal, en la Ejecutiva socialista tienen claro que el PSOE tiene una oportunidad que no había tenido hasta ahora. Un miembro de la dirección nacional cree que la crisis de la vivienda y el voto en contra del PP pasará factura a la formación de Alberto Núñez Feijóo y, aunque reconoce que los socialistas no capitalizarán toda la frustración de la protesta, opina que sí podrán recabar cierto apoyo de los manifestantes.Plantea también este miembro de la Ejecutiva federal que las encuestas que manejan internamente, previas al adelanto, daban al PSOE un resultado similar a los 121 diputados que logró en 2023. \"Con las urnas puestas y una campaña electoral, crecemos seguro\", predice.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#e8aafbd0-a8cf-4f18-9d9f-fda0b76697f8", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#e8aafbd0-a8cf-4f18-9d9f-fda0b76697f8", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T18:15:00+02:00", "dateModified": "2026-10-05T18:15:00+02:00", "headline": "Rueda acusa a Sánchez de encargar encuestas para elegir el mejor momento para convocar elecciones: \"Siempre p", "alternativeHeadline": "Rueda acusa a Sánchez de encargar encuestas para elegir el mejor momento para convocar elecciones: \"Siempre piensa en sus intereses\"", "articleBody": "¿Por qué a Pedro Sánchez le convienen ahora unas elecciones generales? El presidente de la Xunta de Galicia, Alfonso Rueda, está \"convencido\" de que el presidente del Gobierno \"se ha movido siempre pensando en sus intereses políticos y personales\". \"Y ahora lo hace encargando encuestas para ver el momento que más le beneficiaba o menos le perjudicaba\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#a832b456-4374-46a1-a4e8-de99a378893e", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#a832b456-4374-46a1-a4e8-de99a378893e", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T19:22:00+02:00", "dateModified": "2026-10-05T19:22:00+02:00", "headline": "Abascal, el gran vencedor para los sondeos: \"Nunca confío en las encuestas y pido a los ciudadanos que tampoc", "alternativeHeadline": "Abascal, el gran vencedor para los sondeos: \"Nunca confío en las encuestas y pido a los ciudadanos que tampoco lo hagan\"", "articleBody": "El líder de Vox, Santiago Abascal, ha celebrado este lunes la convocatoria de las elecciones para el 29 de noviembre, pero ha pedido a los ciudadanos que no confíen en las encuestas ni en el presidente del Gobierno, Pedro Sánchez, y que vayan a votar y, si es posible, lo hagan presencialmente. \"Me alegro profundamente, porque hace mucho tiempo que las reclamamos y sobre todo la reclaman los españoles\", ha destacado Abascal en una entrevista en Antena 3 recogida por EFE, en la que ha advertido de que, a pesar de los que indican los sondeos a favor del bloque de derechas, van a ser unas elecciones \"muy inciertas\".Tras advertir de que España irá a las urnas Ceuta \"invadida\" y un candidato, Sánchez, \"al servicio de los intereses de Marruecos\", ha insistido en que no confía nunca en las encuestas y ha pedido a los ciudadanos que tampoco crean en ellas. Y ha vuelto a pedir que \"no vender la piel del oso antes de cazarlo\" como, según ha señalado, ocurrió en 2023 cuando Sánchez logró formar una mayoría de izquierdas y gobernar en coalición con Sumar.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#066ade16-1047-4862-8fb3-288066c658df", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#066ade16-1047-4862-8fb3-288066c658df", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T20:11:00+02:00", "dateModified": "2026-10-05T20:11:00+02:00", "headline": "Estos son los escaños que obtendrían PP, PSOE, Vox y Sumar según los sondeos publicados el lunes", "articleBody": "De los 33 escaños que consiguió en 2026 hasta los 69 que le da el sondeo de Winston: Vox es el mejor parado de las últimas encuestas, todas ellas publicadas antes de la convocatoria de elecciones. Ninguno de los sondeos da al PSOE más de 110 escaños, por lo que los socialistas al menos perderían 11 escaños, mientras que el PP, que en 2023 sumó 137, podría llegar hasta los 143 escaños, según el estudio de Sociométrica.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#628b4d3f-8b20-4bd7-8878-0f799e599bc9", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#628b4d3f-8b20-4bd7-8878-0f799e599bc9", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T20:47:00+02:00", "dateModified": "2026-10-05T20:47:00+02:00", "headline": "El pronóstico de Ramoncín sobre el adelanto electoral: \"Le va a favorecer al PSOE\"", "articleBody": "Ramoncín ha considerado en Más Vale Tarde que la decisión de Pedro Sánchez de adelantar elecciones es buena porque le va a favorecer al PSOE.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#acfaf6e6-b22a-4d3c-a01d-c715af6758fd", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#acfaf6e6-b22a-4d3c-a01d-c715af6758fd", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T21:30:00+02:00", "dateModified": "2026-10-05T21:30:00+02:00", "headline": "Iván Redondo explica cómo puede el PSOE dar la vuelta a las encuestas: \"El reto está en los 700.000 que votar", "alternativeHeadline": "Iván Redondo explica cómo puede el PSOE dar la vuelta a las encuestas: \"El reto está en los 700.000 que votaron a Pedro y ahora están en PP y Vox\"", "articleBody": "Las encuestas sitúan al bloque de izquierdas 14 puntos por debato de PP y Vox. Iván Redondo analiza estos resultados y recuerda dos momentos en los que las encuestas fallaron.El primero, en 1993, cuando las encuestas decían que el PP iba a arrasar y acabó ganando el PSOE por un millón de votos. El segundo lo vivió en 2016 en laSexta, cuando se vaticinaba un sorpaso de Podemos al PSOE y \"el samurái que meditaba en Sanxenxo, Mariano Rajoy Brey, acabó sorpasando a todos esa noche\".Redondo cree que en esta ocasión las casas de encuestas también pueden \"fallar perfectamente\": \"Yo no he visto en todo el año 210 diputados del bloque de la derecha, han estado entre 190 y 186\", comenta.👇 Puedes ver aquí su análisis completo.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#3cc9636c-e9ed-4e4c-aed5-eff153784570", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#3cc9636c-e9ed-4e4c-aed5-eff153784570", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-05T23:30:00+02:00", "dateModified": "2026-10-05T23:30:00+02:00", "headline": "Iván Redondo contesta a si es el mejor momento para convocar elecciones: \"No hay nada electoralista, sino que", "alternativeHeadline": "Iván Redondo contesta a si es el mejor momento para convocar elecciones: \"No hay nada electoralista, sino que tiene todo el sentido\"", "articleBody": "Iván Redondo, exjefe de Gabinete de la Presidencia de Pedro Sánchez, ha analizado el adelanto electoral en Más Vale Tarde. Así, tras las palabras del alcalde de Madrid, José Luis Martínez-Almeida, que ha dicho que el presidente ha elegido el momento \"menos malo\", ha contestado a si es el mejor momento para convocar elecciones.\"Normalmente tienes que tener cuidado cuando convocas porque tienes que tener un por qué claro, y eso la calle lo tiene que entender. En este caso, para mí no hay nada de electoralista ni nada de mejor o peor, sino que tiene todo el sentido. No tienes una mayoría, queda constatada, y la tienes que convocar\", ha señalado.👇 Puedes ver aquí su intervención completa.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#b64266b7-a702-4c63-95b4-cde55d8e19ae", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#b64266b7-a702-4c63-95b4-cde55d8e19ae", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T07:27:14+02:00", "dateModified": "2026-10-06T07:27:14+02:00", "headline": "Iván Redondo explica dos momentos en la historia en que fallaron las encuestas electorales", "articleBody": "El exjefe de Gabinete de la Presidencia de Pedro Sánchez Iván Redondo ha explicado en MVT dos momentos de la historia de España en que fallaron las encuestas. \"Todas decía, en 1993, que iba a arrasar el PP, pero ganó por un millón de votos el PSOE\", explica. No es el único: años después, en 2016, tuvo lugar una noche electoral en la que \"parecía que iba a haber un sorpasso de Podemos\": \"Pero ganó Mariano Rajoy. Fallaron todas las casas de encuestas\", explica. ¿Pueden volver a fallar?", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#4ce8c919-c2d4-422a-93f2-33ff80952387", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#4ce8c919-c2d4-422a-93f2-33ff80952387", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T07:34:44+02:00", "dateModified": "2026-10-06T07:34:44+02:00", "headline": "Esta era la intención de voto de los españoles para unas elecciones hace 3 semanas (CIS)", "articleBody": "El Centro de Investigaciones Sociológicas (CIS) presenta, cada cierto tiempo, un barómetro para tomar el pulso a la sociedad española, con preguntas de todo tipo. El último, publicado el 14 de septiembre, situaba al PSOE muy por delante del PP, al contrario que la mayor parte de los sondeos publicados antes y después de este, con una ventaja de más cinco puntos:", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#49fb99c0-59d5-4366-924a-3445ac1e99a1", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#49fb99c0-59d5-4366-924a-3445ac1e99a1", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T08:00:00+02:00", "dateModified": "2026-10-06T08:00:00+02:00", "headline": "Desglosamos todas las preguntas incluidas en el último barómetro del CIS relacionadas con encuestas", "articleBody": "El último barómetro del CIS, publicado el 14 de septiembre, recoge algunos sentimientos políticos de la sociedad española. Entre las preguntas incluidas en el cuestionario se encuentran algunas relacionadas con la intención de voto y de participación en unas entonces hipotéticas elecciones generales inminentes. Ahora, con la convocatoria adelantada de los comicios, recuperamos los resultados de aquellas preguntas, una a una, siempre teniendo en cuenta que este barómetro se realizó antes incluso de las protestas contra la vivienda, pero después de la crisis de Ceuta.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#62729f91-0378-458b-8631-2614aaa6aaed", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#62729f91-0378-458b-8631-2614aaa6aaed", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T08:15:00+02:00", "dateModified": "2026-10-06T08:15:00+02:00", "headline": "Un 75,2% de los encuestados asegura que iría a votar a las elecciones con toda seguridad (CIS)", "articleBody": "El 75,2% de los encuestados para el último barómetro del CIS aseguraba que si se celebrasen elecciones generales al Parlamento español al día siguiente, iría a votar \"con toda seguridad\". Este dato es interesante analizarlo en el contexto electoral para comprender qué ocurre con las encuestas: si lo contraponemos al dato de participación de las últimas generales, las del 23 de julio de 2023, fue del 70,4%, cuatro puntos por encima a la de noviembre de 2019 pero más de un punto menos que las de abril de 2019. Porque en 2019 tuvimos que celebrar dos elecciones. Estas son las respuestas de los electores: 75,2% → Iría a votar con toda seguridad7,7% → Con toda seguridad se abstendría de ir a votarEntre medias, muchos grises, aunque el electorado, según los datos de esta encuesta, es más proclive a considerar su participación en unas elecciones generales que a considerar la abstención como opción más probable.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#95bdab03-c341-4442-a107-d01c2dd11f69", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#95bdab03-c341-4442-a107-d01c2dd11f69", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T08:41:00+02:00", "dateModified": "2026-10-06T08:41:00+02:00", "headline": "El 61,2% de los encuestados dice saber a quién votar mucho antes de la campaña electoral (CIS)", "articleBody": "El 61,2% de los encuestados en el último barómetro del CIS, publicado el pasado mes de septiembre, considera que tiene decidido el partido o coalición al que votará en las elecciones generales \"mucho antes del inicio de la campaña electoral\". Frente a ellos se encuentra un 5,3% que lo decide el mismo día de la cita electoral, mientras que un 4,7% lo hace durante la jornada de reflexión, en víspera de las elecciones.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#bc6f1e67-5d39-4682-a924-cb474e6c47cf", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#bc6f1e67-5d39-4682-a924-cb474e6c47cf", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T09:11:25+02:00", "dateModified": "2026-10-06T09:11:25+02:00", "headline": "CIS | ¿A quién prefieren los españoles como presidente del Gobierno?", "articleBody": "De entre los principales líderes políticos en España, Pedro Sánchez es el preferido para ostentar el cargo de presidente del Gobierno, según los datos del CIS. Esta es la respuesta de los encuestados, entrevistados a principios de septiembre, con la crisis de Ceuta en marcha pero antes de las protestas y movilizaciones por la vivienda en todo el país: Pedro Sánchez → 25%Alberto Núñez Feijóo → 13,2%Santiago Abascal → 9,8%Gabriel Rufián → 4,6%Entre los líderes políticos, hay un 1,7% de encuestados que elegiría, aunque no es candidata a presidir el Gobierno, la presidenta de la Comunidad de Madrid, Isabel Díaz Ayuso. También existe un 1,4% que preferiría a Alvise Pérez, el diputado en el Parlamento Europeo del partido de extrema derecha Se acabó la fiesta (SALF), que en las europeas de 2024 obtuvo tres diputados.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#a4cd788d-489d-4f60-80e6-d7cbcf6f491a", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#a4cd788d-489d-4f60-80e6-d7cbcf6f491a", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T10:11:36+02:00", "dateModified": "2026-10-06T10:11:36+02:00", "headline": "El bloque de la derecha, imparable | Encuesta de Ateneo del Dato", "articleBody": "Para las elecciones generales del 29 de noviembre, adelantadas por Pedro Sánchez, la derecha llega imparable. El bloque PP-Vox conseguiría la mayoría absoluta según prácticamente todos los sondeos publicados en los últimos días, lo que obligaría a Alberto Núñez Feijóo a pactar con Vox. Según el último sondeo de Ateneo del Dato, publicado por elDiario.es el 3 de octubre, en víspera de la convocatoria electoral, el PP sería el partido ganador, con un 33,2% de los votos, una ligera mejoría con respecto a lo conseguido en 2023 pero insuficiente para gobernar en solitario. Con estos datos, el Partido Popular podría sumar entre 129 y 141 escaños, en el entorno, escaños arriba y abajo, de los 137 conseguidos hace algo más de tres años. No obstante, para gobernar en solitario necesita alcanzar la mayoría del Parlamento, fijada en los 176 escaños. Vox, por su parte, podría llegar a obtener entre 62 y 71 escaños, una cifra muy superior a los 33 que tiene ya en el Congreso, casi el doble, lo que sí permitiría al PP gobernar en una coalición que conseguiría superar con creces esa mayoría absoluta, incluso superar los 200 escaños.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#93df4c50-d78d-41b4-8934-e0d2f58396ce", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#93df4c50-d78d-41b4-8934-e0d2f58396ce", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T10:31:00+02:00", "dateModified": "2026-10-06T10:31:00+02:00", "headline": "¿Pueden las encuestas electorales modificar el voto de los españoles?", "articleBody": "Muchas veces las encuestas se equivocan. ¿Pero pueden también modificar el voto? Aunque siempre depende de la lealtad del votante, hay que tener en cuenta que un porcentaje del electorado decide a quién votará en la jornada de reflexión o incluso el mismo día de los comicios. Es por eso que los partidos, en campaña, hacen un llamamiento continuo para tratar de convencer a los votantes indecisos y hacer que elijan finalmente las papeletas de sus candidaturas.Aunque hay estudios en todas las direcciones, los más modernos apuntan a que sí puede haber cierta influencia de las encuestas en las decisiones electorales en campaña, especialmente en la dirección del conocido como \"voto útil\" cuando existen contextos políticos de fragmentación partidista. Hasta 2015, el bipartidismo estuvo bastante asentado en España pero con la irrupción de Podemos esta tendencia desapareció, haciendo que en los Parlamentos autonómicos aparecieran muchos colores, más allá del rojo del PSOE y del azul del PP.Según Morwitz y Pluzinski, las encuestas sí pueden tener un efecto psicológico sobre el comportamiento de los electores y son varios los estudios que han confirmado la existencia de dos efectos principales de las encuestas en la dirección del voto: el efecto arrastre (bandwagon) y el efecto underdog, que va en la dirección contraria.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#66fd6a76-a86a-40e4-a145-e745df0f8935", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#66fd6a76-a86a-40e4-a145-e745df0f8935", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T10:42:00+02:00", "dateModified": "2026-10-06T10:42:00+02:00", "headline": "El efecto \"bandwagon\" de las encuestas: sumarse al partido favorito", "articleBody": "Tal y como explican desde Psicología y Mente, el efecto bandwagon o efecto arrastre de las encuestas tiene lugar cuando las personas tienden a apoyar una causa que considera ganadora; este efecto se basa en la necesidad de ser consistente con el conjunto de la sociedad que, en un proceso electoral, le llevaría a votar al partido que las encuestas apuntan como ganador. De esta manera, el votante refuerza su autoestima y su sentimiento de pertenencia a un colectivo reforzante. En el caso concreto de las elecciones generales del 29N, este efecto llevaría al votante a elegir al Partido Popular (PP), que es el partido al que los sondeos apuntan como ganador.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#e36cc27b-b89a-42ed-a8b5-132168960b5e", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#e36cc27b-b89a-42ed-a8b5-132168960b5e", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T10:59:00+02:00", "dateModified": "2026-10-06T10:59:00+02:00", "headline": "El efecto \"underdog\" de las encuestas: la defensa de las pequeñas causas", "articleBody": "En contraposición está el efecto underdog, que hace lo contrario, despertando el interés por las opciones menos valoradas. Cuando tiene lugar este efecto, las personas tienden a elegir entre las \"pequeñas opciones\", al considerar que tienen que defender una causa que está siendo minusvalorada. ¿Por qué se da este efecto? La psicología no tiene una respuesta clara, pero sí apunta a que podría ser un intento de diferenciarse del resto, pero también la de compadecerse de lo que considera una \"causa perdida\" o incluso de admirar la voluntad de esta causa al oponerse a la mayoría.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#337474e7-af95-4641-9ae8-4d7c84734b38", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#337474e7-af95-4641-9ae8-4d7c84734b38", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T11:13:40+02:00", "dateModified": "2026-10-06T11:13:40+02:00", "headline": "Encuesta Ateneo del Dato | Reparto de escaños", "articleBody": "El reparto de escaños del Parlamento en función de los resultados de la encuesta de Ateneo del Dato, publicada el 3 de octubre por elDiario.es, dibuja un hemiciclo considerablemente diferente al actual: PSOE → Entre 102 y 109 escaños 🔻 Perdería hasta 19 escañosPP → Entre 129 y 141 escaños 👉 Podría entre perder 8 escaños y ganar cuatroVox → Entre 62 y 71 escaños ⬆️ Podría ganar entre 29 y 38 escañosSumar → Entre 10 y 14 escaños 🔻Perdería 17 y 21 escañosPodemos → 2 escaños → En las últimas elecciones estaba integrado en la coalición Sumar", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#74dbd1fa-c6e6-4118-8798-38c5d054759e", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#74dbd1fa-c6e6-4118-8798-38c5d054759e", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T11:43:55+02:00", "dateModified": "2026-10-06T11:43:55+02:00", "headline": "Ester Muñoz (PP): \"Las encuestas esperan cambio de Gobierno, pero nadie se puede confiar\"", "articleBody": "La portavoz del PP en el Congreso de los Diputados, Ester Muñoz, ha asegurado que las encuestas \"esperan cambio de Gobierno\" y si bien consideran que para el Partido Popular \"es bueno\" y sirve como una \"ventana de oportunidad\", \"nadie se puede confiar\". \"Las encuestas nos dan ganadores, con mucha diferencia\", ha explicado en una entrevista en la cadena COPE. \"Pero nadie puede confiar en lo que tenga preparado Pedro Sánchez\", ha advertido, por lo que han pedido \"confianza\" para hacer \"todo lo necesario\". \"A ver qué cartas tenemos el 29 de noviembre\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#8ced892e-9f08-45d9-8a44-7020d33b4f9f", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#8ced892e-9f08-45d9-8a44-7020d33b4f9f", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T12:33:02+02:00", "dateModified": "2026-10-06T12:33:02+02:00", "headline": "Borja Sémper (PP) aspira a un PP con mayoría para gobernar en solitario, en contra de lo que dicen las encuest", "alternativeHeadline": "Borja Sémper (PP) aspira a un PP con mayoría para gobernar en solitario, en contra de lo que dicen las encuestas", "articleBody": "El vicesecretario de Cultura y Deporte y Portavoz Nacional del Partido Popular, Borja Sémper, ha asegurado hoy que su partido aspira a tener una mayoría suficiente para \"gobernar en solitario\", frente a lo que apuntan las diferentes encuestas, que si bien dan al PP como partido ganador también apuntan a que necesitará pactar con Vox, con un importante crecimiento, para poder gobernar. Aun así, Borja Sémper no descarta pactar con otros partidos con el fin de dar \"estabilidad\" al país. Así lo ha asegurado durante una entrevista en Onda Cero, en la que ha señalado que el PP \"no va a renunciar\" a ese objetivo. El PP \"aspira a tener la mayoría suficientemente fuerte como para gobernar en solitario\", ha recalcado antes de precisar que aunque el \"modelo aspiracional\" y la oferta política que hace el PP a los españoles \"es gobernar en solitario\" no niega que, si tienen que llegar a pactos con otros partidos, lo harán \"porque España necesita estabilidad\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#c258da07-4d5f-4d40-8321-de7e158fb08f", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#c258da07-4d5f-4d40-8321-de7e158fb08f", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T13:05:28+02:00", "dateModified": "2026-10-06T13:05:28+02:00", "headline": "Encuesta Celeste Tel | El PP, a menos de 20 escaños de la mayoría; Vox duplica resultados", "articleBody": "Sin sorpresa en las encuestas. Si nos vamos a las encuestas electorales que se han ido publicando hasta ahora, antes incluso de la convocatoria de elecciones para el 29 de noviembre, todas apuntan más o menos en la misma dirección: las derechas ganan. Con más o menos escaños. El Partido Popular (PP) podría llegar a los 147 escaños, a menos de 20 de la mayoría absoluta, según el sondeo de Celeste Tel publicado el 24 de septiembre, mientras Vox duplicaría sus resultados, pasando de los 33 que ha tenido en la última legislatura a 62, lo que daría más fuerza para obligar al PP a negociar y pactar un Gobierno en coalición.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#cc555d6b-6268-4a41-998c-714414435c60", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#cc555d6b-6268-4a41-998c-714414435c60", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T13:58:29+02:00", "dateModified": "2026-10-06T13:58:29+02:00", "headline": "Pedro Sánchez, sobre las encuestas: \"Me las tomo en serio si son transparentes\"", "articleBody": "El presidente del Gobierno, Pedro Sánchez, ha asegurado que se toma \"en serio\" las encuestas siempre y cuando sean \"transparentes\". No obstante, ha señalado que lo relevante es que esta campaña electoral debe girar \"en torno a los problemas de la gente\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#0913237d-59a7-422c-9c50-a0e608bc51ac", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#0913237d-59a7-422c-9c50-a0e608bc51ac", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T14:39:30+02:00", "dateModified": "2026-10-06T14:39:30+02:00", "headline": "Evolución de intención de voto de las diferentes encuestas publicadas los últimos días", "articleBody": "Desde el pasado fin de semana, cuando sobre el Gobierno empezó a barajar la posibilidad de adelantar las elecciones generales, se han ido publicando encuestas y sondeos para estudiar la intención de voto de la sociedad española de cara a los comicios. En los últimos días han visto la luz media decena de sondeos nuevos que muestran algunos datos comunes, como son el fuerte auge de Vox, que daría la mayoría absoluta al bloque de derechas, frente a una incapacidad por parte de la izquierda no sólo de convencer, sino de retener a su electorado. Así han ido variando los datos de intención de voto de cada encuesta: Los sondeos incluidos en el gráfico son los elaborados por Ateneo del Dato (3 de octubre), Sigma Dos (4 de octubre), Sociométrica, Data10 y 40db. (5 de octubre), publicados por elDiario.es, \"El Mundo\", \"El Español\", \"OKDiario\" y \"El País\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#d6d069d1-7ffd-46bc-ba6b-8ef7a01ffa78", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#d6d069d1-7ffd-46bc-ba6b-8ef7a01ffa78", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T15:35:00+02:00", "dateModified": "2026-10-06T15:35:00+02:00", "headline": "Ninguna encuesta reciente da al PSOE más de un 27,5% del voto, cuatro puntos menos que en 2023", "articleBody": "De las encuestas que se han ido publicando hasta ahora, ninguna da al PSOE un resultado superior al 27,5% del voto. Esto supondría, en el mejor de los casos, una caída de cuatro puntos con respecto a lo que obtuvo en 2023 cuando, aun sin ser el partido más votado, consiguió formar Gobierno en coalición con Sumar.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#b9a13665-cff4-4429-b828-e15afa385720", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#b9a13665-cff4-4429-b828-e15afa385720", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T16:41:00+02:00", "dateModified": "2026-10-06T16:41:00+02:00", "headline": "Vox, el partido que más crece de cara al 29N: hasta casi siete puntos más que hace tres años", "articleBody": "En algo que coinciden todos los sondeos publicados hasta ahora de cara a las elecciones generales del 29 de noviembre es en el auge de Vox. El partido de Santiago Abascal llega a estas generales con la \"tranquilidad\" de los sondeos, aunque Santiago Abascal asegura que nunca confía en ellos. Del 12,4% que sumó en 2023, los de verde podrían llegar a un 19,2% según las estimaciones más altas (Ateneo del Dato) o a un 18,1% según las más conservadoras (Sociométrica).", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#512140dd-5c93-414b-a39a-f7e3394e09c4", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#512140dd-5c93-414b-a39a-f7e3394e09c4", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T17:40:00+02:00", "dateModified": "2026-10-06T17:40:00+02:00", "headline": "¿Qué pasará con Sumar (Frente Amplio) en estas elecciones?", "articleBody": "¿Qué pasará con Sumar en estas elecciones generales? La coalición se presenta bajo la nomenclatura de Frente Amplio, que todavía tiene que anunciar a su candidato, pero la principal duda está en si se integrará en ella Podemos o no. En cualquier caso, en función de los últimos sondeos publicados, la coalición no tiene los números de su parte: todas las encuestas dan una caída importante para el grupo, que pasaría del 12,3% cosechado en 2023 a unos datos que van del 5,2% a 7%, insuficientes para poder formar otro Gobierno en coalición con el PSOE.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#651fa755-6c73-4d77-8900-96987f7371e4", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#651fa755-6c73-4d77-8900-96987f7371e4", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-06T19:00:00+02:00", "dateModified": "2026-10-06T19:00:00+02:00", "headline": "¿A quién votarán los españoles en las elecciones generales? Esto dicen las últimas encuestas", "articleBody": "Los sondeos incluidos en el gráfico son los elaborados por Ateneo del Dato (3 de octubre), Sigma Dos (4 de octubre), Sociométrica, Data10 y 40db. (5 de octubre), publicados por elDiario.es, \"El Mundo\", \"El Español\", \"OKDiario\" y \"El País\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#25fe4acf-9793-4ae3-b48d-729d8bb7126a", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#25fe4acf-9793-4ae3-b48d-729d8bb7126a", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T07:25:05+02:00", "dateModified": "2026-10-07T07:25:05+02:00", "headline": "¿Cómo puede afectar al voto de las elecciones la participación de los residentes en el extranjero?", "articleBody": "El Censo Electoral de Residentes Ausentes (CERA) para las elecciones generales del 29 de noviembre se ha incrementado en casi 420.000 personas con respecto al que había en las últimas, las elecciones de julio de 2023. Esta es una de las razones por las que la derecha ha puesto sobre la mesa el fantasma del \"pucherazo\": PP y Vox lo relacionan con el acceso a la nacionalidad de los descendientes de españoles que se han beneficiado de la denominada \"ley de nietos\", aunque la derecha ya hablaba de \"pucherazo\" en las municipales anteriores, cuando no estaba en vigor. Los datos de la Oficina del Censo Electoral muestran que el pasado 1 de agosto el censo contaba con 2.747.688 inscritos, frente a los 2.327.388 electores registrados en las anteriores elecciones. ¿Puede afectar al voto CERA? Por supuesto. Hace algo más de tres años, en los últimos comicios, se generó mucha expectación en torno a este voto, ya que podía alterar el resultado en hasta nueve provincias.En 2023, la participación de los residentes en el extranjero fue del 10,04%, dato que hizo que se alterara un escaño en la Comunidad de Madrid. La dirección del voto fue, no obstante, contraria a las quejas de la derecha: el PSOE perdió un escaño frente al PP. Los consulados donde más votaron fueron los de Londres, Bruselas, Ginebra y París, en todos ellos por encima del 15%.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#9d2588b2-a65f-4d74-a94e-ec14f96b3089", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#9d2588b2-a65f-4d74-a94e-ec14f96b3089", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T07:32:41+02:00", "dateModified": "2026-10-07T07:32:41+02:00", "headline": "El director de Metroscopia: \"Las encuestas nos dicen que PP y PSOE no van a llegar al 60% de los votos\"", "articleBody": "El director de la encuestadora Metroscopia, Ignacio Urquizo, asegura que los resultados de las elecciones generales del 29 de noviembre nos llevarán a un nivel de bipartidismo similar al registrado en las de 2015 y 2016 —hubo unas primeras en diciembre de 2015 que se tuvieron que repetir en junio del año siguiente al no alcanzar ningún partido acuerdo suficiente para gobernar—, en el que los dos grandes partidos no ocupan la mayor parte del espacio electoral. \"Todas las encuestas dicen que PP y PSOE van a sumar en torno al cincuenta y pico... no llegarán al 60%\", ha explicado Urquizo en TVE. Con ese nivel de bipartidismo hay que regresar a las elecciones de hace una década: \"Allí, el 20% lo tuvo Podemos. Ahora lo tendrá Vox. Pasaremos de un partido de extrema izquierda a un partido de extrema derecha\", explica. ¿Es previsible que esto siga así? Urquizo responde: \"En estos momentos, los bloques siguen intactos\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#51e6c3fd-ce85-4c75-bc67-91e267db2391", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#51e6c3fd-ce85-4c75-bc67-91e267db2391", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T07:56:04+02:00", "dateModified": "2026-10-07T07:56:04+02:00", "headline": "Urquizu (Metroscopia), sobre los fallos de las encuestas: \"Se movieron 2 ó 3 puntos, que es lo que mueve la c", "alternativeHeadline": "Urquizu (Metroscopia), sobre los fallos de las encuestas: \"Se movieron 2 ó 3 puntos, que es lo que mueve la campaña electoral\"", "articleBody": "Con respecto a lo que se desviaron las encuestas en las elecciones generales de 2016, el director de Metroscopia, Ignacio Urquizu, ha explicado que una campaña electoral mueve entre dos y tres puntos. \"Todo el mundo está con las encuestas de 2023, que se equivocaron... pero entonces se movieron dos o tres puntos, que es lo que puede mover la campaña\", ha explicado en entrevista en TVE. \"Como la última semana no se pueden publicar encuestas nos perdimos mucha información. Pero no se equivocaron, se movieron por el efecto de la campaña\", ha añadido. \"Acabó con un resultado que, por muy pocas circunscripciones, cuatro o cinco, varió radicalmente [el resultado] que se esperaba unas semanas antes\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#0f855f6b-e55c-458f-83f6-d8aa7eeee458", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#0f855f6b-e55c-458f-83f6-d8aa7eeee458", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T08:17:53+02:00", "dateModified": "2026-10-07T08:17:53+02:00", "headline": "El reparto de escaños de las elecciones generales, en función de las encuestas", "articleBody": "Grandes ganadores y grandes perdedores: es lo que muestran los datos de las encuestas publicadas de cara a las elecciones generales. El bloque de derechas llega con todos los sondeos a su favor, adelantando lo que podría ser una aplastante mayoría... en coalición. Aunque algunas encuestas dan al Partido Popular algún escaño más el 29 de noviembre, no son suficientes para que Alberto Núñez Feijóo gobierne en solitario, por lo que se vería obligado a pactar con un Vox que sí es el gran vencedor para los sondeos:", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#d83400bc-e696-46c3-ac5a-cf2c689d4f87", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#d83400bc-e696-46c3-ac5a-cf2c689d4f87", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T09:30:57+02:00", "dateModified": "2026-10-07T09:30:57+02:00", "headline": "Los resultados del 23J frente a las encuestas: del \"acierto\" del CIS a la \"desviación\" de GAD3", "articleBody": "El sondeo que publicaba Sigma Dos para la televisión pública apenas minutos antes de comenzar el escrutinio de las elecciones generales del 23 de julio de 2023 dibujaba un escenario parlamentario que dista bastante de lo que finalmente dictaron las urnas.La encuesta de Sigma Dos otorgaba una mayoría mucho más amplia para Alberto Núñez Feijóo, con entre 145 y 150 escaños frente a los 136 que finalmente consiguió. También apostaba por la pérdida de escaños de Pedro Sánchez, entre dos y siete menos que en 2019. Sin embargo, acabó ganando dos más.Acertaba bastante más con el resultado de Yolanda Díaz. A Sumar le otorgaba entre 28 y los 31 escaños que finalmente ha obtenido. También vaticinaba una caída aún más grande de Vox, para quienes estimaba entre 24 y 27 escaños. La formación de Santiago Abascal se quedó con 33 al final del escrutinio y consiguió mantenerse como tercera fuerza política.La encuesta de GAD3 dibujaba un escenario muy similar, si bien acertaba con la posición de Vox en el parlamento. A Núñez Feijóo le otorgaba entre 11 y 17 escaños más de los obtenidos. A Sánchez, entre 7 y 13 menos, y una caída respecto a 2019. Con Vox acertaba, otorgándole entre 29 y los 33 escaños que obtuvo, y auguraba que la irrupción de Sumar en el parlamento no iba a llegar a los 30 escaños.Tras la noche electoral, GAD3 asumía su \"desviación\" en las estimaciones y su presidente, Narciso Michavila, reconocía que fallaron las previsiones. \"Asumo el error de GAD3 y aprovecho para felicitar a Socialmetrica\", ha explicado en laSexta.→ Los resultados del 23J frente a las encuestas: del \"acierto\" del CIS a la \"desviación\" de Gad3", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#c55d45cc-f7ff-4f50-ad00-fb06d5b75f82", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#c55d45cc-f7ff-4f50-ad00-fb06d5b75f82", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T10:06:06+02:00", "dateModified": "2026-10-07T10:06:06+02:00", "headline": "Encuesta IPSOS para Cataluña | Aliança Catalana empata con el PSC", "articleBody": "De cara a las elecciones generales, en precampaña, empiezan a publicarse también sondeos para otros procesos electorales. Una de las últimas encuestas publicadas es la de IPSOS para \"La Vanguardia\", realizada en base a 2.000 entrevistas telefónicas y online entre el 23 de septiembre y el 1 de octubre, antes de la convocatoria de adelanto electoral, y que sitúa a la formación de ultraderecha Aliança Catalana como segunda fuerza política en votos, pero cerca del empate en escaños con PSC.Según este sondeo, el PSC obtendría un 21,7% de los votos —más de seis puntos menos que en las últimas elecciones catalanas, celebradas en 2024—, lo que le daría 30 escaños, 12 menos que los que consiguió hace dos años. Entretanto, Aliança sumaría 28 a los dos que tenía para alcanzar el mismo número (30), pese a que su voto sería del 17,9%, por delante de ERC (15%). Vox también subiría, de un 8% a un 13,1%, lo que le añadiría siete escaños (hasta 18) en el Parlament. PSC | 21,7% | 30 escaños 🔻Perdería 12 escañosAliança | 17,9% | 30 escaños ⬆️ Ganaría 28 escañosERC | 15% | 23 escaños 🔻Perdería 3 escañosVox | 13,1% | 18 escaños ⬆️ Ganaría 7 escañosJunts | 10,8% | 16 escaños 🔻Perdería 19 escañosPP | 8,6% | 11 escaños 🔻Perdería 4 escañosComuns | 4,4% | 4 escaños 🔻Perdería 1 escañoCUP | 3,2% | 3 escaños 🔻 Perdería 1 escaño", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#bf1fbd2a-7750-4882-a8ab-b5594192de9e", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#bf1fbd2a-7750-4882-a8ab-b5594192de9e", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T11:39:24+02:00", "dateModified": "2026-10-07T11:39:24+02:00", "headline": "Encuesta previa al adelanto electoral | El 63% de los encuestados cree que la \"ley de nietos\" busca alterar ", "alternativeHeadline": "Encuesta previa al adelanto electoral | El 63% de los encuestados cree que la \"ley de nietos\" busca alterar el resultado electoral", "articleBody": "Según una encuesta elaborada por Sociométrica y publicada por \"El Español\" en julio, meses antes de la convocatoria electoral adelantada, el 62,8% de los españoles creía que con la \"ley de nietos\" el Gobierno pretende \"alterar los resultados de forma injusta\", al incorporar al censo a 2,5 millones de personas que tendrían derecho a voto aunque no viven en España. La encuesta muestra, además, que el 63,5% cree que el Ejecutivo quiere crear en el extranjero un \"nicho de nuevos votantes agradecidos\" con el PSOE.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#554676c7-a3ab-4771-a960-19b74bdddb39", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#554676c7-a3ab-4771-a960-19b74bdddb39", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T12:37:57+02:00", "dateModified": "2026-10-07T12:37:57+02:00", "headline": "Esta fue la encuesta interna que valoró el PSOE antes de adelantar las elecciones", "articleBody": "Antes de tomar la decisión de adelantar las elecciones generales, tanto PP como PSOE acudieron a encuestas internas para valorar la situación de España. Al presidente del Gobierno, Pedro Sánchez, le llegó una encuesta exprés, según \"El Mundo\", basada en 7.000 entrevistas, que colocaba a los socialistas al borde de los 130 escaños, tres escaños por delante del PP. Aun así, según este sondeo: El bloque PP-Vox suma mayoría absoluta, con Vox disparado y 15 escaños en disputa", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#32887e6c-6d76-4a19-aa1b-d757dc318d2b", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#32887e6c-6d76-4a19-aa1b-d757dc318d2b", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T14:12:30+02:00", "dateModified": "2026-10-07T14:12:30+02:00", "headline": "Martín Bianchi propone que Pedro Sánchez salga en el \"Playgirl\" para darle la vuelta a las encuestas", "articleBody": "El periodista argentino Martín Bianchi Tasso, en conversación con Aimar Bretos en \"Hoy por hoy\" (SER), ha bromeado con una propuesta para que Pedro Sánchez le dé la vuelta a las encuestas y gane las elecciones generales. El periodista Jesús Ruiz Mantilla le ha recomendado que se deje ver en medios como la revista \"¡Hola!\" para estar más cerca de sus votantes, a lo que Bianchi Tasso ha respondido diciendo que no lo ve del todo claro, pero proponiendo otra opción: \"Yo creo que Pedro Sánchez no debería salir en el \"¡Hola!\", sino en \"Playgirl\" (...). Con un posado Pedro ya gana las elecciones\".", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#2ecfb5ca-fad5-4d24-bd12-40962be80e62", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#2ecfb5ca-fad5-4d24-bd12-40962be80e62", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-07T15:30:00+02:00", "dateModified": "2026-10-07T15:30:00+02:00", "headline": "Así han evolucionado las encuestas electorales publicadas hasta ahora", "articleBody": "", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#ddd55407-4c87-4267-992b-e68f07189471", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#ddd55407-4c87-4267-992b-e68f07189471", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-08T07:15:52+02:00", "dateModified": "2026-10-08T07:15:52+02:00", "headline": "🔴Hoy hay barómetro: el CIS publica su estudio sobre vivienda en plena precampaña electoral y tras la muerte d", "alternativeHeadline": "🔴Hoy hay barómetro: el CIS publica su estudio sobre vivienda en plena precampaña electoral y tras la muerte de Maricarmen", "articleBody": "El Centro de Investigaciones Sociológicas (CIS) publicará hoy a las 12:30h los resultados de su barómetro de vivienda de 2026, un estudio que llega en plena precampaña electoral y que ve la luz horas después de la muerte de Maricarmen, la anciana de 87 años cuyo desahucio encendió las protestas por la vivienda que obligaron al Gobierno a sacar, \"in extremis\", los decretos de vivienda que aprobó a través de la Diputación Permanente cuando las Cortes Generales ya estaban disueltas.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#390d8378-0a88-4e55-8da6-c677a16fc5d2", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#390d8378-0a88-4e55-8da6-c677a16fc5d2", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-08T08:30:41+02:00", "dateModified": "2026-10-08T08:30:41+02:00", "headline": "❌ El CIS suspende la publicación del estudio de vivienda por \"problemas técnicos\"", "articleBody": "El Centro de Investigaciones Sociológicas (CIS) ha anunciado la cancelación de la publicación de su barómetro sobre vivienda, previsto inicialmente para hoy a las 12:30h, debido a \"problemas técnicos\". Por ahora, no se ha informado de la fecha en la que se publicará el estudio.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } }, { "@type": "BlogPosting", "@id": "#f9df6c41-4b64-4eee-99c2-6e7f3e0677d9", "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html#f9df6c41-4b64-4eee-99c2-6e7f3e0677d9", "mainEntityOfPage": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "datePublished": "2026-10-08T09:26:36+02:00", "dateModified": "2026-10-08T09:26:36+02:00", "headline": "Nueva encuesta electoral para el 29N: el bloque de derechas PP-PSOE se refuerza", "articleBody": "En línea con lo que muestran la mayor parte de las encuestas y sondeos publicados durante la primera semana de octubre, los resultados del sondeo de NC Report publicados hoy auguran un refuerzo de la derecha, con un PP subiendo tres puntos y con un marcado crecimiento para Vox. El Partido Popular llegaría al 34,1% de los votos, lo que le confirmaría como primera fuerza política en España, seguida, a nueve puntos, de un PSOE que pierde casi siete puntos por el camino. Entretanto, Vox mantiene este crecimiento que otros sondeos también han visto, llegando a sumar hasta seis puntos de voto. Entre Sumar y Podemos sumarían un 9,2% del voto, casi un tercio de lo que sumó en 2023 la coalición Sumar, en la que estaba integrada Podemos en las últimas elecciones.", "author": { "@id":"#author", "@type": "Organization", "name": "LaSexta" }, "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "image": { "@type": "ImageObject", "@id": "#openingImage", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_69.jpg?crop=1200,675,x0,y3&width=1280&height=720&optimize=low&format=webply", "height": 720, "width": 1280 } } ] } </script><script type="application/ld+json"> { "@context": "https://schema.org", "@type": "NewsArticle", "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html"}, "url": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html", "headline": "Así van las encuestas y sondeos de las elecciones generales de 2026", "description": "Las encuestas y sondeos sobre intención de voto se publican incluso antes de cualquier convocatoria. Sigue en laSexta.com los datos que ofrecen las encuestas publicadas hasta ahora y de cara al día de las elecciones. ", "datePublished": "2026-10-08T09:26:36+02:00", "dateModified": "2026-10-08T09:26:36+02:00", "articleSection":[ "Elecciones", "Elecciones generales"], "keywords":[ "Directo", "Barómetro del CIS", "Elecciones", "Barómetro laSexta", "encuestas"], "publisher": { "@id":"https://www.lasexta.com/#publisher" }, "author": { "@type": "Organization", "name": "LaSexta" }, "image": [ { "@type": "ImageObject", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_96.jpg?crop=1200,675,x0,y3&width=1200&height=675&optimize=low&format=webply", "width": 1200, "height": 675 }, { "@type": "ImageObject", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_103.jpg?crop=907,680,x147,y0&width=1200&height=900&optimize=low&format=webply", "width": 1200, "height": 900 }, { "@type": "ImageObject", "url": "https://fotografias.lasexta.com/clipping/cmsimages02/2026/10/07/97432486-C685-4263-B584-34B2160E7A11/asi-van-encuestas-sondeos-elecciones-generales-2026_104.jpg?crop=680,680,x260,y0&width=1200&height=1200&optimize=low&format=webply", "width": 1200, "height": 1200 } ], "speakable":{ "@type":"SpeakableSpecification", "xpath":[ "/html/head/title", "/html/head/meta[@name='description']/@content" ] } } </script><script type="application/ld+json"> { "@context": "http://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "laSexta", "item": "https://www.lasexta.com/" }, { "@type": "ListItem", "position": 2, "name": "Elecciones", "item": "https://www.lasexta.com/elecciones/" }, { "@type": "ListItem", "position": 3, "name": "Elecciones generales", "item": "https://www.lasexta.com/elecciones/generales/" }, { "@type": "ListItem", "position": 4, "name": "Así van las encuestas y sondeos de las elecciones generales de 2026", "item": "https://www.lasexta.com/elecciones/generales/encuestas-elecciones-generales_202610056ac365161c30184d44b52907.html" }] } </script><script type="application/ld+json"> { "@context":"https://schema.org", "@type":"NewsMediaOrganization", "url":"https://www.lasexta.com/", "@id":"https://www.lasexta.com/#publisher", "name":"laSexta", "alternateName":"La Sexta", "sameAs":[ "https://twitter.com/anatomia_tv"], "logo": { "@type": "ImageObject", "url": "https://static.lasexta.com/img/la-sexta-amp.png", "width": 270, "height": 60 } , "foundingLocation": "Madrid, España", "foundingDate": "2005-11-25", "address": { "@type":"PostalAddress", "streetAddress":"Isla Graciosa 13", "addressLocality":"San Sebastián de los Reyes", "addressRegion":"Comunidad de Madrid", "postalCode":"28703", "addressCountry":"ES" } ,"parentOrganization":{ "@context":"https://schema.org", "@type":"NewsMediaOrganizat