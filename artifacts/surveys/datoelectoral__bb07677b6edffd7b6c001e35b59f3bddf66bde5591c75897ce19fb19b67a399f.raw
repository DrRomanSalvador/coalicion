className\":\"mt-1 text-xs leading-relaxed text-zinc-400\",\"children\":\"El cuestionario incluye las opciones «No sabe» y «No contesta», pero el documento no publica el porcentaje que las eligió en cada pregunta: en las tablas de resultados no aparecen esas filas.\"}],false,[\"$\",\"a\",null,{\"href\":\"https://www.celeste-tel.es/wp-content/uploads/2026/09/Bar%C3%B3metro-Electoral-MensualSEP2026.pdf\",\"className\":\"mt-1 inline-block text-xs font-semibold text-brand-soft underline\",\"rel\":\"noopener noreferrer nofollow\",\"title\":\"Fuente de la casilla «Celeste-Tel · No-respuesta por pregunta»\",\"children\":\"Fuente\"}]]}],[\"$\",\"td\",\"tamanoMuestra\",{\"className\":\"border-t border-white/5 px-3 py-3 align-top\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-bold text-brand-soft\",\"children\":\"Sí\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-xs leading-relaxed text-zinc-400\",\"children\":\"1.100 entrevistas.\"}],false,[\"$\",\"a\",null,{\"href\":\"https://www.celeste-tel.es/wp-content/uploads/2026/09/Bar%C3%B3metro-Electoral-MensualSEP2026.pdf\",\"className\":\"mt-1 inline-block text-xs font-semibold text-brand-soft underline\",\"rel\":\"noopener noreferrer nofollow\",\"title\":\"Fuente de la casilla «Celeste-Tel · Tamaño de muestra»\",\"children\":\"Fuente\"}]]}],[\"$\",\"td\",\"margenError\",{\"className\":\"border-t border-white/5 px-3 py-3 align-top\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-bold text-brand-soft\",\"children\":\"Sí\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-xs leading-relaxed text-zinc-400\",\"children\":\"±3,02 % para el conjunto de la muestra, para un nivel de confianza del 95,45 % (dos sigmas) y P = Q.\"}],false,[\"$\",\"a\",null,{\"href\":\"https://www.celeste-tel.es/wp-content/uploads/2026/09/Bar%C3%B3metro-Electoral-MensualSEP2026.pdf\",\"className\":\"mt-1 inline-block text-xs font-semibold text-brand-soft underline\",\"rel\":\"noopener noreferrer nofollow\",\"title\":\"Fuente de la casilla «Celes