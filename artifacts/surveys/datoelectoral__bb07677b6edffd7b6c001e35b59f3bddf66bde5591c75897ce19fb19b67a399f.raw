"$L17\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L19\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n11:[\"$\",\"$2\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-8\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Miga de pan\",\"className\":\"mb-4 text-sm text-zinc-500\",\"children\":[[\"$\",\"$L4\",null,{\"href\":\"/\",\"className\":\"hover:text-brand-soft\",\"children\":\"Inicio\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\" / \"}],[\"$\",\"span\",null,{\"className\":\"text-zinc-400\",\"children\":\"Encuestas\"}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-black leading-tight text-white sm:text-4xl\",\"children\":\"Encuestas electorales\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-lg text-zinc-300\",\"children\":\"Publicamos sondeos con su ficha técnica entera, y dejamos de publicarlos los días en que la ley prohíbe difundirlos. Ni hacemos encuestas propias ni pronosticamos resultados: reproducimos lo que han publicado otros, diciendo quién lo ha hecho y cómo.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-zinc-400\",\"children\":[[\"Se pueden difundir encuestas hasta el\",\" \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-zinc-200\",\"children\":\"23 de noviembre de 2026\"}],\": del \",\"24 de noviembre de 2026\",\" al \",\"28 de noviembre de 2026\",\" la ley lo prohíbe (LOREG, artículo 69.7).\",\" \"],[\"$\",\"$L4\",null,{\"href\":\"/calendario\",\"className\":\"font-semibold text-brand-soft underline\",\"children\":\"Calendario legal completo\"}],\".\"]}],[\"$\",\"section\",null,{\"className\":\"mt-8\",\"id\":\"tabla-encuestas\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-black text-white\",\"children\":\"Tabla de encuestas del 29-N\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-zinc-300\",\"children\":[\"Elecciones generales del 29 de noviembre de 2026\",\". Aparecen \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"todos los sondeos del ciclo\"}],\", en dos bloques según lo que publica cada uno, y se ve qué enseña cada fila y qué se calla.\",\" \",[\"$\",\"a\",null,{\"href\":\"#por-que-plegado\",\"className\":\"font-semibold text-brand-soft underline\",\"children\":\"Qué exige la ley, apartado por apartado\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-zinc-400\",\"children\":[\"Última actualización de esta tabla:\",\" \",[\"$\",\"strong\",null,{\"className\":\"font-semibold text-zinc-200\",\"children\":\"6 de octubre de 2026\"}],\". \",\"Se revisa sondeo a sondeo cada vez que una encuestadora publica uno del ciclo: se abre su documento propio, se rellenan los ocho campos de «publica» y, si aparece el que faltaba (cuestionario íntegro o no-respuesta por pregunta), la fila pasa sola a la tabla de cifras. La fecha «actualizado» es la de la última revisión. Durante la ventana del artículo 69.7 (del 24 al 29 de noviembre de 2026) no hay que tocar nada: las dos tablas se quedan sin filas y el contenido sale del HTML.\",\" \",\"Cómo se mantiene, en\",\" \",[\"$\",\"$L4\",null,{\"href\":\"/metodologia\",\"className\":\"font-semibold text-brand-soft underline\",\"children\":\"metodología\"}],\".\"]}],[[\"$\",\"h3\",null,{\"className\":\"mt-6 text-sm font-black uppercase tracking-wider text-brand-soft\",\"children\":\"A) Sondeos con la ficha técnica completa: se publican sus cifras\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 rounded-xl border border-white/5 bg-zinc-900/40 p-5 text-zinc-300\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"font-semibold text-white\",\"children\":\"Todavía no hay ningún sondeo del 29-N con la ficha técnica completa.\"}],\" \",\"No es un olvido: desde la convocatoria, publicar un sondeo obliga a reproducir su cuestionario íntegro y su no-respuesta por pregunta, y eso solo lo publica hoy el CIS. Su primer barómetro posterior a la convocatoria entrará aquí en cuanto se publique; los sondeos privados entran si algún día publican esos dos extremos.\"]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-zinc-400\",\"children\":[\"Hasta entonces, esta tabla está vacía y los sondeos del ciclo se listan en el bloque B con lo que les falta, uno por uno. Lo que cada encuestadora enseña de sí misma, campo por campo y con la fuente de cada casilla, está en el\",\" \",\"$L2b\",\".\"]}]]}],false,\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\"]]}],\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\"]}],[\"$L35\"],\"$L36\"]}]\n13:[\"$\",\"$2\",\"h\",{\"children\":[null,[\"$\",\"$L37\",null,{\"children\":\"$L38\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L39\",null,{\"children\":[\"$\",\"$3a\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L3b\"}]}]}],null]}]\n15:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/30tj6tqrhsq_i.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n3c:I[58677,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/0ei2suz2thshb.js\"],\"CookieSettingsLink\"]\n3d:I[98451,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/0ei2suz2thshb.js\"],\"SubscribeForm\"]\n47:I[26622,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/0ei2suz2thshb.js\",\"/_next/static/chunks/28tysn-rampgk.js\"],\"AdSlot\"]\n5b:I[97367,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/0ei2suz2thshb.js\"],\"OutletBoundary\"]\n12:C\n16:[\"$\",\"button\",null,{\"type\":\"submit\",\"className\":\"rounded-md bg-brand px-4 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-brand-soft\",\"children\":\"Buscar\"}]\n1a:[\"$\",\"$L4\",null,{\"href\":\"/calendario\",\"className\":\"text-zinc-400 transiti