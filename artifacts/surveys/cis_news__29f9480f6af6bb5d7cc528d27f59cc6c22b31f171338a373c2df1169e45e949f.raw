/* ============================================================
   Aspecto de la cabecera en escritorio (>=992px):
   una sola fila, todo alineado, y siempre en su versión compacta
   (logo reducido y menú principal a 16px), con scroll y sin él.
   Mobile/tablet conservan su comportamiento original.
   ============================================================ */
@media (min-width: 992px) {
  .cis .jdt-header .header-desktop .header-container .m-first-wrapper {
    align-items: flex-end;
    gap: 20px;
    padding: 0;
  }
  .cis .jdt-header .header-desktop {
    /* Una sola fila; el buscador es el elemento elástico y los textos
       no se envuelven. */
  }
  .cis .jdt-header .header-desktop .header-actions {
    flex-wrap: nowrap;
  }
  .cis .jdt-header .header-desktop .header-actions .header-actions-top {
    flex-shrink: 0;
    white-space: nowrap;
    gap: var(--spacing-3, 8px);
  }
  .cis .jdt-header .header-desktop .header-actions .header-actions-top .jdt-dropdown {
    margin-left: 0;
  }
  .cis .jdt-header .header-desktop .header-actions .search-form {
    flex: 1 1 0;
    min-width: 0;
  }
  .cis .jdt-header .header-desktop .header-actions .login-link {
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: var(--spacing-3, 8px);
  }
  .cis .jdt-header .header-desktop .nav-desktop-secondary {
    margin-top: var(--spacing-2, 4px);
    /* Menú principal compacto: letra de 16px y 46px de alto. */
  }
  .cis .jdt-header .header-desktop .nav-desktop-secondary .navbar {
    padding-top: var(--spacing-4, 12px);
    /* El panel desplegable cuelga del alto del menú compacto. */
  }
  .cis .jdt-header .header-desktop .nav-desktop-secondary .navbar .navbar-nav .nav-item.dropdown .dropdown-holder {
    top: 37px;
  }
  .cis .jdt-header .header-desktop .nav-desktop-secondary .m-main-nav-desk-level-1 .nav-link {
    padding-bottom: 10px;
    font-size: var(--font-size-body-medium, 16px);
    line-height: var(--line-height-body-medium, 24px);
  }
  .cis .jdt-header .header-desktop .nav-desktop-secondary .m-main-nav-desk i {
    line-height: 20px;
  }
  .cis .jdt-header .header-desktop .brand-logo {
