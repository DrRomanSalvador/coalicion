.cis .jdt-banner.hero .container .banner-content h1, .cis .jdt-banner.hero .container-fluid .banner-content h1 {
  font-size: var(--font-size-title1, 38px);
  line-height: 49px;
  margin: 0 0 var(--spacing-3, 8px) 0;
  padding-bottom: 0;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cis .jdt-banner.hero .container .banner-content p, .cis .jdt-banner.hero .container-fluid .banner-content p {
  font-size: var(--font-size-body-medium, 16px);
  line-height: var(--line-height-body-medium, 24px);
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin: 0;
}

@media (max-width: 767px) {
  .cis .jdt-banner.hero .container .banner-content .jdt-breadcrumb,
  .cis .jdt-banner.hero .container .banner-content .breadcrumb-bar, .cis .jdt-banner.hero .container-fluid .banner-content .jdt-breadcrumb,
  .cis .jdt-banner.hero .container-fluid .banner-content .breadcrumb-bar {
    margin-bottom: var(--spacing-mobile-2, 4px);
  }
  .cis .jdt-banner.hero .container .banner-content h1, .cis .jdt-banner.hero .container-fluid .banner-content h1 {
    font-size: var(--font-size-mobile-title2, 24px);
    line-height: var(--line-height-mobile-title2, 1.2em);
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
  .cis .jdt-banner.hero .container .banner-content p, .cis .jdt-banner.hero .container-fluid .banner-content p {
    display: block;
    -webkit-line-clamp: none;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
}
.cis .banner-video-modal-body {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%;
  height: 0;
}

.cis .banner-video-modal-body iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  border-radius: var(--border-radius-1, 8px);
  overflow: hidden;
}

.cis .jdt-banner.hero.video .modal {
  z-index: 10070;
}

body.modal-open:has(.jdt-banner.hero.video .modal.show) .modal-backdrop {
  z-index: 10040;
}

body.modal-open .cis .jdt-banner.hero.video {
  z-index: auto !important;
  overflow: visible !important;
}

body.modal-open .cis .jdt-banner.hero.video::before,
body.modal-open .cis .jdt-banner.hero.video::after {
  pointer-events: none !important;
}

@media (max-width: 767px) {
  .cis .jdt-banner.hero.video .container .banner-content p,
  .cis .jdt-banner.hero.alt1 .container .banner-content p,
  .cis .jdt-banner.hero.video .container-fluid .banner-content p,
  .cis .jdt-banner.hero.alt1 .container-fluid .banner-content p {
    display: -webkit-box !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    margin-bottom: var(--spacing-3, 8px);
  }
}
@media (min-width: 992px) and (max-width: 1399px) {
  .cis .jdt-banner.hero.video > .container {
    max-width: 100%;
    width: 100%;
  }
}
@media (min-width: 1280px) {
  .cis .jdt-banner.hero.video > .container {
    padding-inline: calc(var(--bs-gutter-x, 30px) / 2);
  }
}
@media (max-width: 767px) {
  .cis .jdt-banner.hero.normal {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
}
@media (min-width: 768px) {
  .cis .journal-content-article .jdt-banner.hero.alt1 .container .banner-content h1,
  .cis .journal-content-article .jdt-banner.hero.alt1 .container-fluid .banner-content h1 {
    max-width: 90%;
    display: -webkit-box !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    white-space: normal !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }
}
@media (min-width: 768px) {
  .cis .journal-content-article .jdt-banner.hero.alt1 .container .banner-content p,
  .cis .journal-content-article .jdt-banner.hero.alt1 .container-fluid .banner-content p {
    max-width: 95%;
  }
}
.cis .banner-video__trigger:hover .banner-video__overlay,
.cis .banner-video__trigger:focus-visible .banner-video__overlay {
  background: rgba(0, 0, 0, 0.35);
}

/* El resto de variantes de banner no declaran line-height propio del h1 y
   heredaban el 1.2em global (45,6px): se igualan a los 49px de `alt1` y `hero`.
   Solo desde 768px, porque en movil el h1 usa el tamano mobile-title2. */
@media (min-width: 768px) {
  .cis .jdt-banner .container .banner-content h1,
  .cis .jdt-banner .container-fluid .banner-content h1 {
    line-height: 49px;
  }
}
/* Subtítulo: como máximo 1 línea en desktop, 2 en tablet y 3 en móvil; lo que no
   quepa se corta con ellipsis. Va al final y con la clase de color del <p> para
   ganar a las reglas nowrap/visible de cada variante (alt1, hero, large…). */
.cis .jdt-banner .container .banner-content p.primary-light,
.cis .jdt-banner .container .banner-content p.primary-dark-blue,
.cis .jdt-banner .container-fluid .banner-content p.primary-light,
.cis .jdt-banner .container-fluid .banner-content p.primary-dark-blue {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

@media (max-width: 991px) {
  .cis .jdt-banner .container .banner-content p.primary-light,
  .cis .jdt-banner .container .banner-content p.primary-dark-blue,
  .cis .jdt-banner .container-fluid .banner-content p.primary-light,
  .cis .jdt-banner .container-fluid .banner-content p.primary-dark-blue {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    white-space: normal;
    overflow: hidden;
  }
}
/* En móvil, secondary, littleDark y lighter ocultan el subtítulo: no se lo devolvemos. */
@media (max-width: 767px) {
  .cis .jdt-banner .container .banner-content p.primary-light,
  .cis .jdt-banner .container .banner-content p.primary-dark-blue,
  .cis .jdt-banner .container-fluid .banner-content p.primary-light,
  .cis .jdt-banner .container-fluid .banner-content p.primary-dark-blue {
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .cis .jdt-banner:is(.secondary, .littleDark, .lighter) .container .banner-content p.primary-light,
  .cis .jdt-banner:is(.secondary, .littleDark, .lighter) .container .banner-content p.primary-dark-blue {
    display: none;
  }
}
/* Detalle de noticia y evento (`alt1-light`): la misma composición que el banner
   del listado (color liso a la izquierda y la imagen entrando por la derecha con
   un degradado), en la versión clara: azul claro y texto oscuro, sin la imagen
   en primer plano. En móvil, color liso como el listado. Anula el velo y el
   degradado oscuro de alt1. */
.cis .jdt-banner.alt1.alt1-light {
  background-color: var(--blue-300, #bddde6);
}

.cis .jdt-banner.alt1.alt1-light::before {
  background: none !important;
}

.cis .jdt-banner.alt1.alt1-light::after {
  backdrop-filter: none;
  background: linear-gradient(90deg, #bddde6 0%, #bddde6 66%, rgba(189, 221, 230, 0.8) 72%, rgba(189, 221, 230, 0.3) 80%, rgba(189, 221, 230, 0) 92%) !important;
}

/* El texto se queda en la zona lisa para no pisar la imagen. */
@media (min-width: 768px) {
  .cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content {
    width: 66%;
    max-width: 66%;
  }
}
@media (max-width: 767px) {
  .cis .jdt-banner.alt1.alt1-light {
    background-image: none !important;
  }
  .cis .jdt-banner.alt1.alt1-light::after {
    background: none !important;
  }
}
.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content {
  background: transparent !important;
}

.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content h1,
.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content p,
.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content .breadcrumb-item,
.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content .breadcrumb-item a,
.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content .breadcrumb-item span,
.cis .jdt-banner.alt1.alt1-light :is(.container, .container-fluid) .banner-content .breadcrumb-item i {
  color: var(--primary-dark, #333) !important;
}

/* La casita de las migas no se subraya en el banner alt1: el subrayado es solo
   para los enlaces de texto. */
.cis .jdt-banner.alt1 :is(.container, .container-fluid) :is(.banner-content, .banner-breadcrumb) :is(.jdt-breadcrumb, .breadcrumb-bar) .breadcrumb-item:first-of-type a {
  text-decoration: none;
}

/* La intranet usa el mismo banner, pero sin camino de migas. */
body[data-theme=cis-intranet] .jdt-banner .banner-content [id*=SiteNavigationBreadcrumbPortlet] {
  display: none !important;
