            <div class="form-group">
                <label for="_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt__from">Desde</label>
                <input name="fromDate"
                       autocomplete="off"
                       type="date"
                       id="_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt__from"
                       value=""
