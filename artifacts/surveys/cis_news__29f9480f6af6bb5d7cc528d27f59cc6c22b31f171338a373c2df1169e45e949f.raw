<div class="row">
    <div class="col-12 jdt-form jdt-search" id="_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt_dgjn">
        <div class="search-item text-search">
            <div class="form-group">
                <label for="_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt__text">
Texto a buscar                    <i class="icon-info-circle icon-size-2" aria-hidden="true" data-toggle="tooltip" data-placement="right" title="Para realizar búsquedas exactas se debe entrecomillar la cadena de búsqueda. Ejemplo: &quot;barometro de la vivienda&quot;"></i>
                </label>
                <div class="input-wrapper">
