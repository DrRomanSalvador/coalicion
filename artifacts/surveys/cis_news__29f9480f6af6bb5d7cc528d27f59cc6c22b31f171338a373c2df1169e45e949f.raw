        function tryUntilIsAvailable(name, callback) {
            var interval = 100; // ms
            window.setTimeout(function () {
                if (window[name]) {
                    callback(window[name]);
                } else {
                    tryUntilIsAvailable(name, callback);
                }
            }, interval);
