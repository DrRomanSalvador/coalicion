/* Cabecera hero: mismo alto en todas las páginas (fragmento y plantillas FTL),
   haya o no subtítulo. 139px = padding 10 + migas 32 + h1 49 + 8 + subtítulo 24
   + padding 16; si el contenido es mayor (título en dos líneas), el banner crece. */
.cis .jdt-banner.hero,
.cis .jdt-banner.hero.alt1 {
  min-height: 139px;
  padding-block: 10px 16px;
}

/* El contenedor alt1 impone 138px propios: que mande el min-height del banner. */
.cis .jdt-banner.hero.alt1 .container,
.cis .jdt-banner.hero.alt1 .container-fluid {
  min-height: 0;
}

/* Sin subtítulo, el h1 es el último hijo: su margen inferior (con !important en
   `.alt1.alt1 … h1`) no debe sumar alto. */
.cis .jdt-banner.hero .container .banner-content > :last-child,
.cis .jdt-banner.hero .container-fluid .banner-content > :last-child,
.cis .jdt-banner.hero.alt1 .container .banner-content > h1:last-child,
.cis .jdt-banner.hero.alt1 .container-fluid .banner-content > h1:last-child,
.cis .jdt-banner.hero.alt1 .container .banner-content > h1:has(+ p:empty),
.cis .jdt-banner.hero.alt1 .container-fluid .banner-content > h1:has(+ p:empty) {
  margin-bottom: 0 !important;
}

.cis .jdt-banner.hero .banner-content > p:empty {
  display: none !important;
}

/* Móvil compacto: sin la imagen apilada bajo el texto y con el mismo padding que
   en desktop. En móvil el fondo del hero normal lo pinta .banner-content (el
   banner es negro), así que padding y alto mínimo van en él, no en el banner.
   min-height = padding 10 + migas 24 + h1 29 + 8 + subtítulo 24 + padding 10. */
@media (max-width: 767px) {
  /* body + .hero.hero: gana a `.hero.normal { padding: 0 !important }`, que va
     después y tiene las mismas clases. */
  body .cis .jdt-banner.hero.hero {
    min-height: 0;
    padding: 0 !important;
  }
  .cis .jdt-banner.hero .container .banner-content,
  .cis .jdt-banner.hero .container-fluid .banner-content {
    min-height: 105px;
    padding: 10px var(--spacing-mobile-6, 16px) !important;
  }
  .cis .jdt-banner.hero .container .image-container,
  .cis .jdt-banner.hero .container-fluid .image-container {
    display: none !important;
  }
}
.cis .jdt-banner.hero .container .banner-content, .cis .jdt-banner.hero .container-fluid .banner-content {
  gap: 0;
  width: auto;
  flex: 1 1 auto;
  min-width: 0;
  justify-content: flex-start;
}

