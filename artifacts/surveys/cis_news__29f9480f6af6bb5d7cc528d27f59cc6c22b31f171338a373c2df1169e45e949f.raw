            </article>





        <article class="jdt-card virtual-href news horizontal">

                    <div class="card-image">
    <div class="jdt-image blur">
        <picture>
            <img src="/documents/d/guest/avance_4674213" alt="Próxima entrega del avance de resultados del estudio 3577 'Barómetro de septiembre 2026'" class="main-image">
        </picture>
    </div>
