  outline-offset: 2px; /* Separación entre el borde y el contenido */
  box-shadow: 0 0 5px rgba(0, 86, 179, 0.5); /* Sombra para mayor visibilidad */
}
.cis .jdt-header .header-desktop {
  border-bottom: 1px solid var(--blue-300, #bddde6);
}
