<script>
    //document.getElementById("_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt__text").focus();

    document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt_dgjn').closest('form').addEventListener("submit", function (event) {
        event.preventDefault();
        const btn = event.submitter || this.querySelector('.jdt-button');
        send(btn);
    });

    function send(buttonEl) {
        const form = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt_dgjn').closest('form');
        //encodeURIComponent()
        form.querySelector('input[name="start"]').value = "1";
        form.querySelector('input[name="from"]').value = "[" + convertirFechaFormatoCompleto(form.querySelector('input[name="fromDate"]').value) + " now]";
        form.querySelector('input[name="to"]').value = "[now-100y " + convertirFechaFormatoCompleto(form.querySelector('input[name="toDate"]').value, true) + "]";

        document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt__sort').value = "publishDate-"

        const inputFormDate = form.querySelector('input[name$="formDate"]');
        if (inputFormDate) {
            inputFormDate.disabled = true;
        }

        if (validateDates()) {
            if (window.sendWithSpinner) { window.sendWithSpinner(buttonEl); }
            form.submit();
        }
    }

    function convertirFechaFormatoCompleto(fecha, plusDay = false) {

        if (fecha === '')
            return '';

        const fechaObj = new Date(fecha);

        if (plusDay) {
            fechaObj.setDate(fechaObj.getDate() + 1);
        }

        const year = String(fechaObj.getFullYear()).padStart(4, '0');
        const month = String(fechaObj.getMonth() + 1).padStart(2, '0');
        const day = String(fechaObj.getDate()).padStart(2, '0');

        const hora = '00';
        const minutos = '00';
        const segundos = '00';

        return `${year}${month}${day}${hora}${minutos}${segundos}`;
    }

    function clearForm() {
        const form = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_dgbt_dgjn').closest('form');

        form.querySelectorAll('input, select, textarea').forEach(element => {
            switch (element.type) {
                case 'text':
                case 'password':
                case 'textarea':
                case 'number':
                case 'email':
                case 'url':
                case 'tel':
                case 'search':
                    element.value = '';
                    break;
                case 'checkbox':
                case 'radio':
                    element.checked = false;
                    break;
                case 'select-one':
                case 'select-multiple':
                    element.selectedIndex = -1;
                    break;
                default:
                    element.value = '';
            }
        });
    }

    function setDates() {
        const fromDateInput = document.querySelector('input[name="fromDate"]');
        const toDateInput = document.querySelector('input[name="toDate"]');
        const today = new Date().toISOString().split('T')[0];

        if (fromDateInput.value) {
            toDateInput.min = fromDateInput.value;
        }

        fromDateInput.addEventListener("change", function () {
            if (fromDateInput.value) {
                toDateInput.min = fromDateInput.value;
            } else {
                toDateInput.min = "1963-09-01";
            }
        });
        fromDateInput.setAttribute('max', today);

        toDateInput.addEventListener("blur", function () {
                if (toDateInput.value && (toDateInput.value < fromDateInput.value)) {
                    toDateInput.setCustomValidity("Esta fecha no puede ser menor que la del campo Desde");
                } else {
                    toDateInput.setCustomValidity("");
                }
                toDateInput.reportValidity();
            });
        toDateInput.setAttribute('max', today);
    }

    function validateDates() {
        const fromDateInput = document.querySelector('input[name="fromDate"]');
        const toDateInput = document.querySelector('input[name="toDate"]');

        if (toDateInput.value && fromDateInput.value && toDateInput.value < fromDateInput.value) {
            toDateInput.setCustomValidity("Esta fecha no puede ser menor que la del campo Desde");
            toDateInput.reportValidity();
            return false;
        } else {
            toDateInput.setCustomValidity("");
            return true;
        }
    }

    Liferay.on('endNavigate', function() {
        setDates()
    });

    setDates()
</script>



		</form>

		
	


	
	

					
				
			
		
	
	



