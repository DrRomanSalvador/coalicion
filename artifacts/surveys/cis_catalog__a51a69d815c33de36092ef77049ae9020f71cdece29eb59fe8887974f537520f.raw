                                <li style="font-weight: 600;">Estudio 3506 </li>
                                <li>13/03/2025</li>
                        </ul>
                    </div>

                            <p class="card-content__excerpt">Encuesta que consta de un módulo fijo, la Encuesta Social General Española, incluida en el Plan Estadístico Nacional (2021-2024), que se ocupa del nivel, calidad y condiciones de vida y laborales de la ciudadanía, y de un módulo variable realizado dentro programa ISSP (Internacional Social Survey Program), que en esta edición se centra en el tema de la familia y los cambios en los roles de género.</p>



                </div>
            </article>


        

    <script>
        function printVisited() {
            const visitedItems = new Set(JSON.parse(localStorage.getItem("visitedItems_estudio")) || []);

            visitedItems.forEach(id => {
                const element = document.getElementById(id);
                if (element) {
                    const cardInfo = element.querySelector(".card-info ul");

                    if (!cardInfo.classList.contains("visited")) {
                        cardInfo.classList.add("visited");

                        const visitedBadge = document.createElement("span");
                        visitedBadge.classList.add("visited");
                        visitedBadge.innerHTML = '<i class="icon-eye icon-size-4" aria-hidden="true"></i><span>Visitado</span>';

                        cardInfo.insertAdjacentElement("afterend", visitedBadge);
                    }
                }
            });
        }

        function registerVisit(itemId) {
            const visitedItems = new Set(JSON.parse(localStorage.getItem("visitedItems_estudio")) || []);

            if (!visitedItems.has(itemId)) {
                visitedItems.add(itemId);
                localStorage.setItem("visitedItems_estudio", JSON.stringify([...visitedItems]));
                printVisited();
            }
        }

        Liferay.on('endNavigate', callFunctions);
        Liferay.detach('endNavigate', callFunctions);

        function callFunctions(event) {
            printVisited()
            jdtReadMore()
        }

        printVisited()

        const ESTUDIOS_SCROLL_KEY = 'estudios_scroll_y';

        history.scrollRestoration = 'manual';

        function saveScrollPosition() {
            sessionStorage.setItem(ESTUDIOS_SCROLL_KEY, window.scrollY);
        }

        function restoreScrollPosition() {
            const saved = sessionStorage.getItem(ESTUDIOS_SCROLL_KEY);
            if (saved !== null) {
                sessionStorage.removeItem(ESTUDIOS_SCROLL_KEY);
                document.documentElement.style.opacity = '0';
                requestAnimationFrame(function() {
                    window.scrollTo({ top: parseInt(saved, 10), behavior: 'instant' });
                    document.documentElement.style.transition = 'opacity 0.3s ease';
                    document.documentElement.style.opacity = '1';
                });
            }
        }

        function updateCardLinkTargets() {
            const isMobile = window.innerWidth < 768;
            document.querySelectorAll('.jdt-card.news.horizontal .card-content__title.main-href').forEach(function(link) {
                link.target = isMobile ? '_self' : '_blank';
                if (isMobile) {
                    if (!link.dataset.scrollListenerAdded) {
                        link.addEventListener('click', saveScrollPosition);
                        link.dataset.scrollListenerAdded = 'true';
                    }
                } else {
                    link.removeEventListener('click', saveScrollPosition);
                    delete link.dataset.scrollListenerAdded;
                }
            });
        }

        updateCardLinkTargets();
        window.addEventListener('resize', updateCardLinkTargets);
        window.addEventListener('load', restoreScrollPosition);
        window.addEventListener('pageshow', function(event) {
            updateCardLinkTargets();
            if (event.persisted) {
                restoreScrollPosition();
            }
        });
    </script>


