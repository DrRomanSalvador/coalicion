<script>
    lastScrollTop = 0;
    Liferay.on('beforeNavigate', lastPosition);
    //Liferay.detach('beforeNavigate', lastPosition);
    Liferay.on('endNavigate', scrollToPosition);
    //Liferay.detach('endNavigate', scrollToPosition);

    function lastPosition(event) {
        lastScrollTop = window.scrollY;
    }
    function scrollToPosition(event) {
