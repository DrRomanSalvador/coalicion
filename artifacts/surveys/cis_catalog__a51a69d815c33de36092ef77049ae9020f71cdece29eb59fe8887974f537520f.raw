<script>
    const textValue = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk__text').value;
    document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk__text').value = unescapeLuceneQuery(textValue);

    window.addEventListener('DOMContentLoaded', () => {
        if (sessionStorage.getItem('estudios_scroll_y') !== null) {
            return;
        }

        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.has('sort')) {
            const targetElement = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk__text');

            if (targetElement) {
                const offset = -220;

                const elementPosition = targetElement.getBoundingClientRect().top + window.pageYOffset;
                const offsetPosition = elementPosition + offset;

                window.scrollTo({
                    top: offsetPosition,
                    behavior: 'smooth'
                });
            }
        }
    });

    document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk_xkjg').closest('form').addEventListener("submit", function (event) {
       const btn = event.submitter || this.querySelector('.jdt-button');
       send(btn);
    });

    function escapeLuceneQuery(value) {
        return value.replace(/([\\/])/g, '\\$1');
    }

    function unescapeLuceneQuery(value) {
        return value.replace(/\\([\\/])/g, '$1');
    }

    function send(buttonEl) {

        if (!validateDates()) {
            return false;
        }

        const form = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk_xkjg').closest('form');

        form.querySelector('input[name="start"]').value = "1";
        form.querySelector('input[name="from"]').value = "[" + convertirFechaFormatoCompleto(form.querySelector('input[name="fromDate"]').value) + " now]";
        form.querySelector('input[name="to"]').value = "[now-100y " + convertirFechaFormatoCompleto(form.querySelector('input[name="toDate"]').value, true) + "]";


        const inputFormDate = form.querySelector('input[name$="formDate"]');
        if (inputFormDate) {
            inputFormDate.disabled = true;
        }

        const textValue = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk__text').value;

        if (textValue.trim().startsWith('*')) {
            document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk__text').value = escapeLuceneQuery(textValue);
        } else if (textValue.trim() === '') {
            document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk__sort').value = "createDateBDE-"
        }

        // Activar spinner justo antes de enviar en el botón pulsado
        if (window.sendWithSpinner) {
            window.sendWithSpinner(buttonEl);
        }
        
        form.submit();
    }

    window.send = send;

    function convertirFechaFormatoCompleto(fecha, plusDay = false) {

        if (fecha === '')
            return '';

        const fechaObj = new Date(fecha);

        if (plusDay) {
            fechaObj.setDate(fechaObj.getDate() + 1);
        }

        const year = String(fechaObj.getFullYear()).padStart(4, '0');
        const month = String(fechaObj.getMonth() + 1).padStart(2, '0');
        const day = String(fechaObj.getDate()).padStart(2, '0');

        const hora = '00';
        const minutos = '00';
        const segundos = '00';

        return `${year}${month}${day}${hora}${minutos}${segundos}`;
    }

    function clearForm() {
        const form = document.getElementById('_com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet_INSTANCE_xuxk_xkjg').closest('form');

        form.querySelectorAll('input, select, textarea').forEach(element => {
            switch (element.type) {
                case 'text':
                case 'password':
                case 'textarea':
                case 'number':
                case 'email':
                case 'url':
                case 'tel':
                case 'search':
                    element.value = '';
                    break;
                case 'checkbox':
                case 'radio':
                    element.checked = false;
                    break;
                case 'select-one':
                case 'select-multiple':
                    element.selectedIndex = -1;
                    break;
                default:
                    element.value = '';
            }
        });
    }

    function setDates() {
        const fromDateInput = document.querySelector('input[name="fromDate"]');
        const toDateInput = document.querySelector('input[name="toDate"]');
        const today = new Date().toISOString().split('T')[0];

        if (fromDateInput.value) {
            toDateInput.min = fromDateInput.value;
        }

        fromDateInput.addEventListener("blur", function () {
            if (fromDateInput.value) {
                toDateInput.min = fromDateInput.value;
            } else {
                toDateInput.min = "1963-09-01";
            }
        });
        fromDateInput.setAttribute('max', today);

        toDateInput.addEventListener("blur", function () {
                if (toDateInput.value && (toDateInput.value < fromDateInput.value)) {
                    toDateInput.setCustomValidity("Esta fecha no puede ser menor que la del campo Desde");
                } else {
                    toDateInput.setCustomValidity("");
                }
                toDateInput.reportValidity();
            });
        toDateInput.setAttribute('max', today);
    }

    function validateDates() {
        const fromDateInput = document.querySelector('input[name="fromDate"]');
        const toDateInput = document.querySelector('input[name="toDate"]');

        if (fromDateInput && !fromDateInput.checkValidity()) {
            fromDateInput.reportValidity();
            return false;
        }

        if (toDateInput && !toDateInput.checkValidity()) {
            toDateInput.reportValidity();
            return false;
        }

        if (fromDateInput && fromDateInput.value) {
            const parsedDate = new Date(fromDateInput.value)
            if (isNaN(parsedDate.getTime())) {
                fromDateInput.setCustomValidity("No hay datos anteriores al 01/09/1963");
                fromDateInput.reportValidity();
                return false;
            }
        }

        if (fromDateInput && fromDateInput.min) {
            const minDate = new Date(fromDateInput.min);
            const parsedDate = new Date(fromDateInput.value)
            if (parsedDate < minDate) {
                fromDateInput.setCustomValidity("No hay datos anteriores al 01/09/1963");
                fromDateInput.reportValidity();
                return false;
            }
        }

        if (toDateInput && toDateInput.value) {
            const parsedDate = new Date(toDateInput.value)
            if (isNaN(parsedDate.getTime())) {
                toDateInput.setCustomValidity("Esta fecha no puede ser menor que la del campo Desde");
                toDateInput.reportValidity();
                return false;
            }
        }

        if (fromDateInput && toDateInput && fromDateInput.value && toDateInput.value && toDateInput.value < fromDateInput.value) {
            toDateInput.setCustomValidity("Esta fecha no puede ser menor que la del campo Desde");
            toDateInput.reportValidity();
            return false;
        }

        fromDateInput.setCustomValidity("");
        toDateInput.setCustomValidity("");
        return true;
    }

    var onCategory = function(event) {setDates()};

    Liferay.on('endNavigate', function() {
        onCategory
    });
    Liferay.detach('endNavigate', function() {
        onCategory
    });
    var clearPortletHandlers = function(event) {
        if (event.portletId === 'com_liferay_portal_search_web_search_bar_portlet_SearchBarPortlet') {
            Liferay.detach('onCategoryHandler', onCategory);
            Liferay.detach('destroyPortlet', clearPortletHandlers);
        }
    };

    setDates()
</script>



