                {code: "3538", title: "Preelectoral elecciones autonómicas 2025. Comunidad autónoma de Extremadura", url: "https://www.cis.es/es/estudios/preelectoral-elecciones-autonomicas-2025.-comunidad-autonoma-de-extremadura"},
                {code: "3534", title: "Estudio sobre miedos e incertidumbres", url: "https://www.cis.es/es/estudios/estudio-sobre-miedos-e-incertidumbres"},
                {code: "3529", title: "Índice de Confianza del Consumidor. Mes de octubre 2025", url: "https://www.cis.es/es/estudios/indice-de-confianza-del-consumidor.-mes-de-octubre-2025"},
                {code: "3530", title: "Barómetro de noviembre 2025", url: "https://www.cis.es/es/estudios/barometro-de-noviembre-2025"},
                {code: "3506", title: "Encuesta Social General Española 2024 (II) (ESGE) / Familia y género (IV) (ISSP)", url: "https://www.cis.es/es/estudios/encuesta-social-general-espanola-2024-ii-esge-/-familia-y-genero-iv-issp-"},
            ]
        };

        const timestamp = Date.now();
        const name = "results_" + timestamp;
        localStorage.setItem(name, JSON.stringify(results));

        const enlaces = document.querySelectorAll(".jdt-contentlist__list .jdt-card a");
        enlaces.forEach(enlace => {
            enlace.addEventListener("click", function (event) {
                event.preventDefault();

                const url = new URL(this.href);
                url.searchParams.set("results", name);
                enlace.href = url.toString();
            });
        });
    }

    Liferay.on('endNavigate', () => {
        setResults();
    });

    setResults();

    function toggleDiv(divToHide, divToShow) {

        divToHide.classList.add('d-none');
        divToHide.classList.remove('show');

        divToShow.classList.remove('d-none');
        divToShow.classList.add("show");

        return false;
    }

    const tagWrapper = document.querySelector(".tag-wrapper");
    const mask = document.querySelector(".tag-scroll-mask");
    const chevronLeft = document.querySelector(".chevron-left");
    const chevronRight = document.querySelector(".chevron-right");

    const updateChevronVisibility = () => {

        if (!tagWrapper || !mask || !chevronLeft || !chevronRight || !mask) {
            return;
        }

        const tolerance = 2; // Margen de tolerancia en píxeles
        const isScrolledLeft = tagWrapper.scrollLeft > tolerance;
        const isScrolledRight =
            tagWrapper.scrollLeft < tagWrapper.scrollWidth - tagWrapper.clientWidth - tolerance;

        chevronLeft.style.visibility = isScrolledLeft ? "visible" : "hidden";
        chevronRight.style.visibility = isScrolledRight ? "visible" : "hidden";

        mask.classList.toggle("hide-left-gradient", !isScrolledLeft);
        mask.classList.toggle("hide-right-gradient", !isScrolledRight);
    };

    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    const smoothScroll = (element, distance, duration = 100) => {
        const start = element.scrollLeft;
        const startTime = performance.now();

        const animate = (time) => {
            const elapsed = time - startTime;
            const progress = Math.min(elapsed / duration, 1);
            element.scrollLeft = start + distance * easeOutCubic(progress);

            if (progress < 1) {
                requestAnimationFrame(animate);
            } else {
                updateChevronVisibility();
            }
        };

        requestAnimationFrame(animate);
    };

    if (chevronLeft) {
        chevronLeft.addEventListener("click", () => {
            smoothScroll(tagWrapper, -200); // Desplaza 200px a la izquierda
        });
    }

    if (chevronRight) {
        chevronRight.addEventListener("click", () => {
            smoothScroll(tagWrapper, 200); // Desplaza 200px a la derecha
        });
    }

    if (tagWrapper) {
        tagWrapper.addEventListener("scroll", updateChevronVisibility);
        
        // Observar cambios de tamaño en el contenedor con debounce
        let resizeTimeout;
        const resizeObserver = new ResizeObserver(() => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                updateChevronVisibility();
            }, 100); // Esperar 100ms después de que termine el resize
        });
        resizeObserver.observe(tagWrapper);
    }

    window.updateChevronVisibility = updateChevronVisibility;

    window.updateChevronVisibility()

    function clearResultsFromLocalStorageIfTooBig(maxMB = 4) {
        const maxBytes = maxMB * 1024 * 1024;
        let totalBytes = 0;

        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            const value = localStorage.getItem(key);
            totalBytes += key.length + value.length;
        }

        if (totalBytes >= maxBytes) {
            const keysToRemove = [];

            for (let i = 0; i < localStorage.length; i++) {
                const key = localStorage.key(i);
                if (key.startsWith("results")) {
                    keysToRemove.push(key);
                }
            }

            keysToRemove.forEach(key => {
                localStorage.removeItem(key);
            });
        }
    }
</script>



		
	


	
	

					
				
			
		
	
	



