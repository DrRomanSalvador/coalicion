/* SOLO dentro del popup 4218 */
#elementor-popup-modal-4218 input[type="submit"],
#elementor-popup-modal-4218 button[type="submit"],input.button.button-primary.button-large{
  width: 100%  !important;
  cursor: pointer  !important;
background-image: none  !important;
  border: 0  !important;
  border-radius: 0.5rem  !important;     /* 8px */
  padding:0px !important;   text-align: center !important;
  font-weight: 700  !important;

  background-color:#374151 !important;
  color: white  !important;

  box-shadow: 0 4px 6px -1px rgba(0,0,0,.1),
              0 2px 4px -2px rgba(0,0,0,.1)  !important;

  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1)  !important;
}


