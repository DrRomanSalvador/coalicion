    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 2px !important;
    color: #1F2938 !important;



}




#login-error-global-modal {
	position: fixed;
	inset: 0;
	z-index: 9999999;
	background: rgba(0, 0, 0, .65);
	display: flex;
	align-items: center;
	justify-content: center;
}

.login-error-global-box {
	position: relative;
	width: min(420px, calc(100% - 32px));
	background: #fff;
	color: #1f2937;
	border-radius: 18px;
	padding: 30px;
	text-align: center;
	box-shadow: 0 20px 60px rgba(0,0,0,.25);
}

.login-error-global-box strong {
	display: block;
	font-size: 22px;
	margin-bottom: 12px;
}

.login-error-global-box p {
	margin: 0 0 20px;
	font-size: 15px;
}

.login-error-global-close {
	position: absolute;
	top: 10px;
	right: 14px;
	border: 0;
	background: transparent;
	font-size: 28px;
	cursor: pointer;
}

.login-error-global-button {
	border: 0;
	background: #1f2937;
	color: #fff;
	border-radius: 8px;
	padding: 12px 20px;
	font-weight: 700;
	cursor: pointer;
}


/* ============================================================
   TAMAÑO DE H2, H3, H4 EN CONTENIDO DE ARTÍCULOS
   ============================================================ */

/* ============================================================
   TAMAÑOS DE TEXTO EN CONTENIDO DE ARTÍCULOS

   Ojo: <html> lleva zoom: 0.8, así que lo que se declara aquí se ve
   al 80%. Los valores van subidos para compensar y que el tamaño real
   quede donde debe:

       cuerpo   22px declarados → 17,6 reales
       H2       34px            → 27,2
       H3       27px            → 21,6
       H4       22px            → 17,6

   Si algún día se quita el zoom: 0.8, hay que bajar estos valores un
   20% o el texto se verá desproporcionado.
   ============================================================ */

/* Cuerpo del artículo */
.entry-content p,
.elementor-widget-theme-post-content p,
div[data-elementor-type="single-post"] p {
  font-size: 22px !important;
  line-height: 1.65 !important;
}

/* H2 — cubre Gutenberg (.wp-block-heading), Elementor y JNews */
.entry-content h2,
.elementor-widget-theme-post-content h2,
div[data-elementor-type="single-post"] h2,
h2.wp-block-heading {
  font-size: 34px !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
  margin-top: 1.8em !important;
  margin-bottom: 0.6em !important;
}

/* El <strong> dentro de H2 no debe cambiar el tamaño */
.entry-content h2 strong,
.elementor-widget-theme-post-content h2 strong,
div[data-elementor-type="single-post"] h2 strong,
h2.wp-block-heading strong {
  font-size: inherit !important;
  font-weight: inherit !important;
}

/* H3 — mismo principio */
.entry-content h3,
.elementor-widget-theme-post-content h3,
div[data-elementor-type="single-post"] h3,
h3.wp-block-heading {
  font-size: 27px !important;
  font-weight: 600 !important;
  line-height: 1.35 !important;
  margin-top: 1.5em !important;
  margin-bottom: 0.5em !important;
}

.entry-content h3 strong,
.elementor-widget-theme-post-content h3 strong,
div[data-elementor-type="single-post"] h3 strong,
h3.wp-block-heading strong {
  font-size: inherit !important;
  font-weight: inherit !important;
}

/* H4 */
.entry-content h4,
.elementor-widget-theme-post-content h4,
div[data-elementor-type="single-post"] h4,
h4.wp-block-heading {
  font-size: 22px !important;
  font-weight: 600 !important;
  line-height: 1.4 !important;
  margin-top: 1.3em !important;
  margin-bottom: 0.4em !important;
}

.entry-content h4 strong,
.elementor-widget-theme-post-content h4 strong,
div[data-elementor-type="single-post"] h4 strong,
h4.wp-block-heading strong {
  font-size: inherit !important;
  font-weight: inherit !important;
}

/* Móvil: algo más contenido, la pantalla es más estrecha */
@media (max-width: 768px) {
  .entry-content p,
  .elementor-widget-theme-post-content p,
  div[data-elementor-type="single-post"] p {
    font-size: 21px !important;
  }
  .entry-content h2,
  .elementor-widget-theme-post-content h2,
  div[data-elementor-type="single-post"] h2,
  h2.wp-block-heading {
    font-size: 29px !important;
  }
  .entry-content h3,
  .elementor-widget-theme-post-content h3,
  div[data-elementor-type="single-post"] h3,
  h3.wp-block-heading {
    font-size: 24px !important;
  }
}

/* H2/H3/H4 con enlace dentro: heredar el tamaño del heading */
.entry-content h2 a,
.entry-content h2 strong a,
.entry-content h2 a strong,
.elementor-widget-theme-post-content h2 a,
.elementor-widget-theme-post-content h2 strong a,
.elementor-widget-theme-post-content h2 a strong,
div[data-elementor-type="single-post"] h2 a,
div[data-elementor-type="single-post"] h2 strong a,
div[data-elementor-type="single-post"] h2 a strong,
h2.wp-block-heading a,
h2.wp-block-heading strong a,
h2.wp-block-heading a strong {
  font-size: inherit !important;
  font-weight: inherit !important;
  line-height: inherit !important;
}

.entry-content h3 a,
.entry-content h3 strong a,
.entry-content h3 a strong,
.elementor-widget-theme-post-content h3 a,
.elementor-widget-theme-post-content h3 strong a,
.elementor-widget-theme-post-content h3 a strong,
div[data-elementor-type="single-post"] h3 a,
div[data-elementor-type="single-post"] h3 strong a,
div[data-elementor-type="single-post"] h3 a strong,
h3.wp-block-heading a,
h3.wp-block-heading strong a,
h3.wp-block-heading a strong {
  font-size: inherit !important;
  font-weight: inherit !important;
  line-height: inherit !important;
}

.entry-content h4 a,
.entry-content h4 strong a,
.entry-content h4 a strong,
.elementor-widget-theme-post-content h4 a,
.elementor-widget-theme-post-content h4 strong a,
.elementor-widget-theme-post-content h4 a strong,
div[data-elementor-type="single-post"] h4 a,
div[data-elementor-type="single-post"] h4 strong a,
div[data-elementor-type="single-post"] h4 a strong,
h4.wp-block-heading a,
h4.wp-block-heading strong a,
h4.wp-block-heading a strong {
  font-size: inherit !important;
  font-weight: inherit !important;
  line-height: inherit !important;
}
/* ═══ Montserrat en toda la web ═══ */
body,
body *:not(i):not([class*="fa-"]):not([class*="icon"]):not([class*="jeg-icon"]):not([class*="premium-drawable"]) {
    font-family: 'Montserrat', Helvetica, Arial, sans-serif !important;
}

/* ═══ Enlaces en el cuerpo del artículo ═══ */
.entry-content p > a:not([class]),
.entry-content li > a:not([class]),
.content-inner p > a:not([class]),
.content-inner li > a:not([class]),
.elementor-widget-theme-post-content p > a:not([class]),
.elementor-widget-theme-post-content li > a:not([class]),
div[data-elementor-type="single-post"] p > a:not([class]),
div[data-elementor-type="single-post"] li > a:not([class]) {
    color: #000000 !important;
    text-decoration: underline !important;
}
/* Títulos con peso intermedio */
.jeg_post_title,
.jeg_post_title a,
h3.jeg_post_title,
h3.jeg_post_title a,
.entry-header .jeg_post_title,
.elementor-widget-theme-post-title,
.elementor-widget-theme-post-title h1,
.elementor-heading-title {
    font-weight: 600 !important;
}
.premium-post-ticker__post-wrapper.ecto-item .ecto-name {
    font-weight: 600 !important;
}
@media (max-width: 768px) {
    .premium-post-ticker__post-wrapper.ecto-item .ecto-name {
        font-size: 13px !important;
    }
}

/* ── Panel de notificaciones de wpDiscuz ── */
.wun-notifications .wun-item,
.wun-notifications .wun-nright,
.wun-notifications .wun-nright a,
.wun-notifications .wun-nright strong {
    font-size: 15px !important;
    line-height: 1.45 !important;
}

.wun-notifications .wun-date {
    font-size: 13px !important;
}

/* ── Campo de escribir comentarios ── */
.ql-container .ql-editor,
.ql-container .ql-editor p,
.ql-editor[data-placeholder]::before {
    font-size: 16px !important;
    line-height: 1.5 !important;
}

@media (max-width: 768px) {
    /* Todos los items: mismo espaciado, compacto */
    .elementor-nav-menu--dropdown li > a,
    .elementor-nav-menu--dropdown li.menu-item-has-children > a {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 12px 16px !important;
        min-height: 0 !important;
        line-height: 1.3 !important;
    }

    /* Flecha: ancha para pulsar, sin alterar la altura */
    .elementor-nav-menu--dropdown li.menu-item-has-children > a span.sub-arrow {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;
        min-width: 56px !important;
        flex: 0 0 56px !important;
        align-self: stretch !important;
        height: auto !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        z-index: 5;
    }

    .elementor-nav-menu--dropdown li.menu-item-has-children > a span.sub-arrow svg {
        width: 14px !important;
        height: 14px !important;
    }

    /* Submenús: ligeramente indentados y algo más compactos */
    .elementor-nav-menu--dropdown ul.sub-menu li > a {
        padding: 10px 16px 10px 32px !important;
        font-size: 0.95em !important;
    }
}
/* ── Gráficos de sondeo en el bloque #n-iniciales ──
   Las reglas de #n-iniciales de más arriba fijan object-fit: cover con
   !important, y al llevar identificador ganan a las del tema hijo, así que
   los gráficos salían recortados en portada. Estas repiten el mismo selector
   añadiendo .em-grafico: la clase extra las hace más específicas y permite
   contener el gráfico entero.
   La clase la pone el mu-plugin em-marca-graficos.php por el nombre del
   fichero (encuesta|sondeo|electopanel). */

#n-iniciales .jeg_posts_wrap article.jeg_post.format-standard .thumbnail-container img.em-grafico {
    object-fit: contain !important;
    background: #fff !important;
    padding: 6px !important;
    box-sizing: border-box !important;
}

@media (max-width: 767px) {
    #n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard .thumbnail-container img.em-grafico {
        object-fit: contain !important;
        background: #fff !important;
        padding: 6px !important;
        box-sizing: border-box !important;
    }
}
</style>
