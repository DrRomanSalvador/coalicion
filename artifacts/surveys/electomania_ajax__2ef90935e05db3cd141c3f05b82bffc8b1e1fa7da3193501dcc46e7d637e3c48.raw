<style id="ecto-ticker-inline-style-inline-css">
.ecto-ticker-wrap{
  width:100%;
  overflow:hidden;
}

.ecto-ticker{
  width:100%;
}

.ecto-ticker .premium-post-ticker__outer-wrapper{
  width:100%;
  overflow:hidden;
}

.ecto-ticker .premium-post-ticker__inner-wrapper{
  display:flex;
  align-items:center;
  width:100%;
  min-width:0;
}

.ecto-ticker .premium-post-ticker__title-wrapper{
  flex:0 0 auto;
}

.ecto-ticker .premium-post-ticker__title{
  white-space:nowrap;
}

.ecto-ticker .premium-post-ticker__posts-wrapper{
  position:relative;
  min-width:0;
  width:100%;
  overflow:hidden;
}

.ecto-ticker .ecto-ticker-track{
  display:flex;
  align-items:center;
  width:max-content;
  will-change:transform;
  transform:translate3d(0,0,0);
}

.ecto-ticker .premium-post-ticker__post-wrapper{
  flex:0 0 auto;
  display:inline-flex;
  align-items:center;
  white-space:nowrap;
}

.ecto-ticker .premium-post-ticker__post-title{
  margin:0;
}

.ecto-ticker .premium-post-ticker__post-title a{
  display:inline-flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  white-space:nowrap;
}

.ecto-ticker .premium-post-ticker__separator{
  flex:0 0 auto;
  width:5px;
  height:5px;
  border-radius:50%;
  background:currentColor;
  opacity:.35;
  margin:0 18px;
}

.ecto-ticker .ecto-name,
.ecto-ticker .ecto-actual,
.ecto-ticker .ecto-delta{
  white-space:nowrap;
}

.ecto-ticker .ecto-delta{
  margin-right:14px;
}

.ecto-ticker .ecto-name{
  margin-left:4px;
}

.ecto-ticker .ecto-up{
  color:#118a2c;
}

.ecto-ticker .ecto-down{
  color:#c62828;
}

.ecto-ticker .ecto-flat{
  color:inherit;
}

.ecto-ticker.is-empty{
  display:none;
}

.premium-post-ticker__title {
    font-weight: bolder;
    font-size: 15px;
}

/* Título responsive: escritorio visible por defecto, móvil oculto */
.ecto-title--mobile  { display: none; }
.ecto-title--desktop { display: block; }

@media (max-width: 768px) {
  .ecto-title--desktop { display: none; }
  .ecto-title--mobile  { display: block; }
}.ecto-ticker .premium-post-ticker__title-wrapper{background:#fa0000 !important;}.ecto-ticker .premium-post-ticker__title{color:#ffffff !important;}
/*# sourceURL=ecto-ticker-inline-style-inline-css */
</style>
