}
nav li a img{
    width: 45px  !important;
}
ul#menu-1-752216d nav li {padding: 0px  !important;}


a#midat,a#midat2{
  position: relative !important;
  overflow: hidden !important;
	display: inline-flex !important;
}

a#midat .elementor-button-content-wrapper,
a#midat2 .elementor-button-content-wrapper{
  position: relative !important;
  z-index: 2 !important;
}

a#midat::before,a#midat2::before{
  content: "" !important;
  position: absolute !important;
  top: -20% !important;
  left: -60% !important;
  width: 55% !important;
  height: 140% !important;
  pointer-events: none !important;
  z-index: 1 !important;

  background: linear-gradient(
    90deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,.28) 50%,
    rgba(255,255,255,0) 100%
  ) !important;

  opacity: 0 ;
  animation: midatShine 4s linear infinite;
	
}

@keyframes midatShine{
  0%   { transform: skewX(-20deg) translateX(-140%) ; opacity: 0 ; }
  5%   { opacity: 1 ; }
  95%  { opacity: 1 ; }
  100% { transform: skewX(-20deg) translateX(260%) ;  opacity: 0 ; }
}


