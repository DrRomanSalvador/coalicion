.elementor-nav-menu--dropdown .sub-menu.elementor-nav-menu--dropdown:not(header *) {
  position: static !important;
  display: block !important;
  width: 100% !important;
  margin: 0 !important;
  left: auto !important;
  top: auto !important;
  box-shadow: none !important;
  padding-left: 12px;
}


/* Icono cerrado */
.elementor-nav-menu .menu-item-has-children > a .sub-arrow svg {
    transition: transform .25s ease;
}

/* Icono abierto */
.elementor-nav-menu .menu-item-has-children > a[aria-expanded="true"] .sub-arrow svg {
    transform: rotate(180deg);
}



