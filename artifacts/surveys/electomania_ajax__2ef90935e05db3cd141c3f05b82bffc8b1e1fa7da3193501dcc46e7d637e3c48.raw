	<script data-cfasync="false">
(function () {
	var SEL = '.emapp-root[data-app-pending]';
	var stored, readTimer, onRead = null;

	// El getter nos avisa de que el componente ya ha leido SU configuracion.
	// Se deja un margen de 100 ms porque el componente lee la global dos veces
	// seguidas (en el useEffect y en el callback de fetch).
	try {
		Object.defineProperty(window, '__EM_ENCUESTA__', {
			configurable: true,
			get: function () {
				if (onRead) {
					clearTimeout(readTimer);
					readTimer = setTimeout(function () {
						var cb = onRead;
						onRead = null;
						if (cb) { cb(); }
					}, 100);
				}
				return stored;
			},
			set: function (v) { stored = v; }
		});
	} catch (e) {}

	// El MutationObserver del bundle escucha childList en document.body, no
	// atributos: hay que provocar una mutacion real para que reescanee.
	function poke() {
		var d = document.createElement('span');
		d.style.display = 'none';
		document.body.appendChild(d);
		d.parentNode.removeChild(d);
	}

	function promote(el) {
		var app = el.getAttribute('data-app-pending');
		if (!app) { return; }
		el.removeAttribute('data-app-pending');
		el.setAttribute('data-app', app);
		poke();
	}

	// Espera a que la instancia recien destapada haya leido su configuracion.
	// Senal principal: el getter. Respaldo: el #root del shadow DOM con
	// contenido. Techo: 5 s, para no bloquear la cola si algo falla.
	function waitFor(el) {
		return new Promise(function (resolve) {
			var done = false;
			var started = Date.now();

			function finish() {
				if (done) { return; }
				done = true;
				onRead = null;
				resolve();
			}

			onRead = finish;

			(function poll() {
				if (done) { return; }
				var shadow = el.shadowRoot;
				var root = shadow && shadow.getElementById ? shadow.getElementById('root') : null;
				if (root && root.childElementCount > 0) {
					setTimeout(finish, 250);
					return;
				}
				if (Date.now() - started > 5000) {
					finish();
					return;
				}
				setTimeout(poll, 50);
			})();
		});
	}

	function promoteAll() {
		Array.prototype.forEach.call(document.querySelectorAll(SEL), promote);
	}

	function run() {
		var list = Array.prototype.slice.call(document.querySelectorAll(SEL));
		if (!list.length) { return Promise.resolve(); }

		// Caso normal (una sola instancia): sin cola, se destapa y ya.
		if (list.length === 1) {
			promote(list[0]);
			return Promise.resolve();
		}

		return list.reduce(function (chain, el) {
			return chain.then(function () {
				promote(el);
				return waitFor(el);
			});
		}, Promise.resolve());
	}

	function boot() {
		try {
			run()['catch'](function (err) {
				if (window.console) { console.error('[EM serializer]', err); }
				promoteAll();
			});
		} catch (e) {
			promoteAll();
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot);
	} else {
		boot();
	}

	// Red de seguridad: pase lo que pase, a los 10 s se destapa lo que quede.
	// En el peor caso se vuelve al comportamiento actual, nunca a nada en blanco.
	setTimeout(promoteAll, 10000);
})();
</script>
