          <svg aria-hidden="true" class="e-font-icon-svg e-fas-copy" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
            <path d="M320 448v40c0 13.255-10.745 24-24 24H24c-13.255 0-24-10.745-24-24V120c0-13.255 10.745-24 24-24h72v296c0 30.879 25.121 56 56 56h168zm0-344V0H152c-13.255 0-24 10.745-24 24v368c0 13.255 10.745 24 24 24h272c13.255 0 24-10.745 24-24V128H344c-13.2 0-24-10.8-24-24zm120.971-31.029L375.029 7.029A24 24 0 0 0 358.059 0H352v96h96v-6.059a24 24 0 0 0-7.029-16.97z"></path>
          </svg>
        </span>
        <span class="elementor-button-text">COPIAR</span>
      </span>
    </button>
  </div>
</div>

<script>
(() => {
  const linkInput = document.querySelector("#link");
  const copyBtn = document.querySelector("#copyLinkBtn");
  if (!linkInput || !copyBtn) return;

  // URL limpia 
  const getCleanUrl = () => {
    const u = new URL(window.location.href);
    u.hash = "";
    return u.toString();
  };

  const cleanUrl = getCleanUrl();
  linkInput.value = cleanUrl;

  if (window.location.hash === "#compartir") {
    history.replaceState(null, "", cleanUrl);
  }

  copyBtn.addEventListener("click", async (e) => {
    e.preventDefault();

    try {
      await navigator.clipboard.writeText(cleanUrl);
    } catch (err) {
      linkInput.removeAttribute("readonly");
      linkInput.focus();
      linkInput.select();
      linkInput.setSelectionRange(0, cleanUrl.length);
      document.execCommand("copy");
      linkInput.setAttribute("readonly", "readonly");
    }

    const label = copyBtn.querySelector(".elementor-button-text");
    if (label) {
      const old = label.textContent;
      label.textContent = "¡COPIADO!";
      setTimeout(() => (label.textContent = old), 1200);
    }
  });
})();
</script>

<style>

button#copyLinkBtn {
    background: #374151;
}
  .copy-field{
    position: relative;
    display: inline-block;
    width: min(560px, 100%);
  }

  #link{
    width: 100%;
    box-sizing: border-box;
    padding-right: 140px;        
    height: 44px;                
    border-radius: 4px;
  }

  /* Botón dentro del input */
  .copy-inside-btn{
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    height: 34px;
    padding: 0 14px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    z-index: 2;
    border: none;
  }
  #copyLinkBtn:hover{
      cursor: pointer
  }
  }

  #copyLinkBtn{
  
    font-family: "Montserrat", Sans-serif;
    font-weight: 800;

  }

  .copy-row--inside{
    display: block;
  }

  .copy-inside-btn svg{
    width: 16px;
    height: 16px;
  }

  @media (max-width: 480px){
    #link{ padding-right: 118px; }
    .copy-inside-btn{ padding: 0 12px; }
  }
</style>				</div>
				</div>
				</div>
					<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
			
			

