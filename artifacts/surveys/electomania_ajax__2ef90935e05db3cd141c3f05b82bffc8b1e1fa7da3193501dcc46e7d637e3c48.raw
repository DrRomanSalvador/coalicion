<style id="em-header-scroll-overrides">
  :root {
    --sticky-offset-top: 0px;
    --always-height: 0px;
    --reveal-total-height: 0px;
  }

 
  .header-always {
    top: 0 !important;
    z-index: 10000 !important;
    transform: none !important;
    transition:
      box-shadow .28s ease,
      top .28s ease !important;
    will-change: auto;
    backface-visibility: visible;
  }

  html.has-scrolled .header-always {
    position: fixed !important;
    top: var(--sticky-offset-top, 0px) !important;
    left: 0 !important;
    width: 100% !important;
    z-index: 10000 !important;
  }

  html.has-scrolled.scroll-down .header-always {
    box-shadow: 0 10px 14px -8px rgba(226, 226, 226, 0.75) !important;
  }

  html.has-scrolled.scroll-up .header-always,
  html:not(.has-scrolled) .header-always {
    box-shadow: none !important;
  }

  
  .header-always-spacer,
  .header-reveal-placeholder {
    display: block !important;
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    overflow: hidden !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: none !important;
  }

  html.has-scrolled .header-always-spacer {
    height: var(--always-height, 0px) !important;
    min-height: var(--always-height, 0px) !important;
  }

  html.has-scrolled .header-reveal-placeholder,
  html.reveal-pinned .header-reveal-placeholder {
    height: var(--reveal-total-height, 0px) !important;
    min-height: var(--reveal-total-height, 0px) !important;
  }


  .header-reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate3d(0, 0, 0);
    transition:
      transform .34s cubic-bezier(.22, .61, .36, 1) !important;
    will-change: transform;
    backface-visibility: hidden;
  }


  html.has-scrolled .header-reveal,
  html.reveal-pinned .header-reveal {
    position: fixed !important;
    top: var(--reveal-top, var(--always-height, 0px)) !important;
    left: 0 !important;
    width: 100% !important;
    z-index: var(--reveal-z, 9998) !important;
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate3d(0, 0, 0);
    gap: 0 !important;
  }

  /*
   * Ocultar reveal: se recoge hacia arriba.
   */
  html.has-scrolled.scroll-down:not(.reveal-open):not(.reveal-interacting) .header-reveal,
  html.header-stuck.scroll-down:not(.reveal-open):not(.reveal-interacting) .header-reveal,
  html.reveal-pinned.scroll-down:not(.reveal-open):not(.reveal-interacting) .header-reveal {
    transform: translate3d(0, calc(-100% - 1px), 0) !important;
    pointer-events: none !important;
    transition:
      transform .30s cubic-bezier(.55, .06, .68, .19) !important;
  }

  
  html.has-scrolled.scroll-up .header-reveal,
  html.header-stuck.scroll-up .header-reveal,
  html.reveal-pinned.scroll-up .header-reveal,
  html.reveal-open .header-reveal,
  html.reveal-interacting .header-reveal {
    transform: translate3d(0, 0, 0) !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
    transition:
      transform .38s cubic-bezier(.16, 1, .3, 1) !important;
  }

 
  html:not(.has-scrolled) .header-reveal {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    width: 100% !important;
    transform: translate3d(0, 0, 0) !important;
    pointer-events: auto !important;
  }

  
  .header-botones {
    z-index: 99999 !important;
  }

  .elementor-location-header,
  .elementor-location-header > div,
  .elementor-location-header .elementor-section,
  .elementor-location-header .elementor-container,
  .elementor-location-header .elementor-column,
  .elementor-location-header .elementor-widget-wrap,
  .elementor-location-header .elementor-widget-nav-menu,
  .elementor-location-header .elementor-widget-container {
    position: relative;
    z-index: 9999 !important;
  }

  .header-reveal,
  .header-reveal .e-con,
  .header-reveal .e-con-inner,
  .header-reveal .elementor-widget,
  .header-reveal .elementor-widget-container,
  .header-reveal .elementor-nav-menu__container,
  .header-reveal .elementor-nav-menu--main,
  .header-reveal .elementor-nav-menu,
  .header-reveal .sub-menu {
    overflow: visible !important;
  }

  .elementor-location-header .elementor-nav-menu .sub-menu,
  .elementor-location-header .elementor-nav-menu--dropdown {
    z-index: 10000 !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const root = document.documentElement;

  const headerAnnouncement = document.querySelector('.header-announcement');
  const headerAlways = document.querySelector('.header-always');
  const revealItems = Array.from(document.querySelectorAll('.header-reveal'));

  let revealShowRaf = null;

  if (!headerAlways || !revealItems.length) return;

  const firstReveal = revealItems[0];
  const lastReveal = revealItems[revealItems.length - 1];

  let alwaysSpacer = document.querySelector('.header-always-spacer');
  let revealPlaceholder = document.querySelector('.header-reveal-placeholder');

  if (!alwaysSpacer) {
    alwaysSpacer = document.createElement('div');
    alwaysSpacer.className = 'header-always-spacer';
    headerAlways.insertAdjacentElement('afterend', alwaysSpacer);
  }

  if (!revealPlaceholder) {
    revealPlaceholder = document.createElement('div');
    revealPlaceholder.className = 'header-reveal-placeholder';
    firstReveal.insertAdjacentElement('beforebegin', revealPlaceholder);
  }

  let lastScroll = window.scrollY;
  let ticking = false;
  let upAccumulated = 0;
  let downAccumulated = 0;

  const releaseZone = 120;
  const revealDelta = 60;
  const directionThreshold = 4;
  const EPS = 0;

  function getStickyTop() {
    return 0;
  }
/*
  function hasAnnouncementPassed() {
    if (!headerAnnouncement) return true;
    return headerAnnouncement.getBoundingClientRect().bottom <= getStickyTop() + EPS;
  }*/


function hasAnnouncementPassed() {
  if (!headerAnnouncement) return true;

  const isMobileLandscape = window.innerWidth > window.innerHeight && window.innerWidth <= 1200;

  if (isMobileLandscape) {
    return window.scrollY > 5;
  }

  return headerAnnouncement.getBoundingClientRect().bottom <= getStickyTop() + EPS;
}


  function syncHeaderStuckState() {
    const stuck =
      window.scrollY > 0 &&
      hasAnnouncementPassed() &&
      headerAlways.getBoundingClientRect().top <= getStickyTop() + EPS;

    root.classList.toggle('header-stuck', stuck);
  }

  function updateStickyPositions() {
    const stickyOffset = 0;
    const alwaysHeight = headerAlways.offsetHeight || 0;

    root.style.setProperty('--sticky-offset-top', stickyOffset + 'px');
    root.style.setProperty('--always-height', alwaysHeight + 'px');

    let currentTop = stickyOffset + alwaysHeight;
    let revealTotalHeight = 0;

    revealItems.forEach(function (item, index) {
      item.style.setProperty('--reveal-top', currentTop + 'px');
      item.style.setProperty('--reveal-z', String(9998 - index));

      const h = item.offsetHeight || 0;
      currentTop += h;
      revealTotalHeight += h;
    });

    root.style.setProperty('--reveal-total-height', revealTotalHeight + 'px');
  }

  function updateTopProgress(scrollY) {
    if (scrollY >= releaseZone) {
      root.style.setProperty('--top-progress', '1');
      return;
    }

    const progress = Math.max(0, Math.min(1, scrollY / releaseZone));
    root.style.setProperty('--top-progress', progress.toFixed(4));
  }

  function isRevealNaturallyGone() {
    const stickyLine = getStickyTop() + headerAlways.offsetHeight;
    return lastReveal.getBoundingClientRect().bottom <= stickyLine + EPS;
  }

  function isRevealBackAtNaturalPosition() {
    const stickyLine = getStickyTop() + headerAlways.offsetHeight;
    return revealPlaceholder.getBoundingClientRect().top >= stickyLine - EPS;
  }

  function hasOpenUIInsideReveal() {
    return revealItems.some(function (item) {
      return !!item.querySelector(
        '.elementor-menu-toggle[aria-expanded="true"], ' +
        '.elementor-nav-menu--dropdown[aria-hidden="false"], ' +
        '[aria-expanded="true"], ' +
        'details[open]'
      );
    });
  }

  function pinReveal() {
    if (revealShowRaf) {
      cancelAnimationFrame(revealShowRaf);
      revealShowRaf = null;
    }

    root.classList.add('reveal-pinned');
    root.classList.remove('scroll-down');
    root.classList.add('scroll-up');
  }

  function releaseReveal() {
    if (revealShowRaf) {
      cancelAnimationFrame(revealShowRaf);
      revealShowRaf = null;
    }

    root.classList.remove('reveal-pinned', 'reveal-open', 'reveal-interacting');
  }

  function setScrollDirection(currentScroll) {
    const diff = currentScroll - lastScroll;

    if (diff > directionThreshold) {
      downAccumulated += diff;
      upAccumulated = 0;

      root.classList.remove('scroll-up');
      root.classList.add('scroll-down');
    } else if (diff < -directionThreshold) {
      upAccumulated += Math.abs(diff);
      downAccumulated = 0;

      root.classList.remove('scroll-down');
      root.classList.add('scroll-up');
    }
  }

  function syncInteractionState() {
    const hovered = revealItems.some(function (item) {
      return item.matches(':hover');
    });

    const focused = revealItems.some(function (item) {
      return item.contains(document.activeElement);
    });

    const openUI = hasOpenUIInsideReveal();

    root.classList.toggle('reveal-interacting', hovered || focused);
    root.classList.toggle('reveal-open', openUI);

    if ((hovered || focused || openUI) && root.classList.contains('reveal-pinned')) {
      root.classList.remove('scroll-down');
      root.classList.add('scroll-up');
    }
  }

  revealItems.forEach(function (item) {
    item.addEventListener('pointerenter', syncInteractionState);

    item.addEventListener('pointerleave', function () {
      requestAnimationFrame(syncInteractionState);
    });

    item.addEventListener('focusin', syncInteractionState);

    item.addEventListener('focusout', function () {
      requestAnimationFrame(syncInteractionState);
    });
  });

  function runScrollLogic() {
    const currentScroll = window.scrollY;

    updateStickyPositions();
    updateTopProgress(currentScroll);
    syncInteractionState();

    if (currentScroll <= 0) {
      root.classList.remove(
        'has-scrolled',
        'scroll-up',
        'scroll-down',
        'header-stuck',
        'header-pre-stuck'
      );

      releaseReveal();

      root.style.setProperty('--top-progress', '0');

      upAccumulated = 0;
      downAccumulated = 0;
      lastScroll = currentScroll;
      ticking = false;
      return;
    }

    if (!hasAnnouncementPassed()) {
      root.classList.remove(
        'has-scrolled',
        'scroll-up',
        'scroll-down',
        'header-stuck',
        'header-pre-stuck'
      );

      releaseReveal();

      upAccumulated = 0;
      downAccumulated = 0;
      lastScroll = currentScroll;
      ticking = false;
      return;
    }

    root.classList.add('has-scrolled');

    setScrollDirection(currentScroll);
    syncHeaderStuckState();

    if (root.classList.contains('reveal-pinned') && isRevealBackAtNaturalPosition()) {
      releaseReveal();

      lastScroll = currentScroll;
      ticking = false;
      return;
    }

    if (
      root.classList.contains('reveal-open') ||
      root.classList.contains('reveal-interacting')
    ) {
      if (isRevealNaturallyGone() || root.classList.contains('reveal-pinned')) {
        pinReveal();
      }

      lastScroll = currentScroll;
      ticking = false;
      return;
    }

    if (
      !root.classList.contains('reveal-pinned') &&
      root.classList.contains('scroll-up') &&
      upAccumulated >= revealDelta &&
      isRevealNaturallyGone()
    ) {
      pinReveal();
    }

    lastScroll = currentScroll;
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(runScrollLogic);
      ticking = true;
    }
  }

  updateStickyPositions();
  updateTopProgress(window.scrollY);
  runScrollLogic();

  window.addEventListener('scroll', onScroll, { passive: true });

  window.addEventListener('resize', function () {
    updateStickyPositions();
    updateTopProgress(window.scrollY);
    runScrollLogic();
  });

  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver(function () {
      updateStickyPositions();
      runScrollLogic();
    });

    ro.observe(headerAlways);

    if (headerAnnouncement) {
      ro.observe(headerAnnouncement);
    }

    revealItems.forEach(function (item) {
      ro.observe(item);
    });
  }
});
</script>

        <script type="text/plain" data-service="linkedin" data-category="marketing">
    (function () {
        var prefix = 'Acabo de ver esto en Electomanía:\n';
        var skipNext = false;

        /* ── 1. window.open: para redes que abren popup ── */
        var _open = window.open.bind(window);
        window.open = function (url, name, specs) {
            if (skipNext) { skipNext = false; return _open(url, name, specs); }
            url = modifyShareUrl(url);
            return _open(url, name, specs);
        };

        /* ── 2. Click listener (fase captura): para WhatsApp y enlaces directos ── */
        document.addEventListener('click', function (e) {
            var el = e.target.closest('a[href]');
            if (!el) return;
            var href = el.getAttribute('href') || '';
            if (href.includes('whatsapp') || href.includes('wa.me')) {
                e.preventDefault();
                e.stopPropagation();
                var modified = modifyShareUrl(href);
                skipNext = true;
                window.open(modified, '_blank');
            }
        }, true);

        /* ── 3. Función central de modificación ── */
        function modifyShareUrl(url) {
            if (!url || typeof url !== 'string') return url;
            try {
                // mailto: tratamiento especial
                if (url.startsWith('mailto:')) {
                    if (url.includes('body=')) {
                        url = url.replace('body=', 'body=' + encodeURIComponent(prefix) + '%0A');
                    } else {
                        url += (url.includes('?') ? '&' : '?') + 'body=' + encodeURIComponent(prefix);
                    }
                    return url;
                }

                var u = new URL(url);
                var h = u.hostname;

                // WhatsApp
                if (h.includes('whatsapp.com') || h.includes('wa.me')) {
                    var t = u.searchParams.get('text') || '';
                    u.searchParams.set('text', prefix + t);
                    return u.toString();
                }
                // Telegram
                if (h.includes('t.me') || h.includes('telegram.me')) {
                    var tg = u.searchParams.get('text') || '';
                    u.searchParams.set('text', prefix + tg);
                    return u.toString();
                }
                // Bluesky
                if (h.includes('bsky.app')) {
                    var bk = u.searchParams.get('text') || '';
                    u.searchParams.set('text', prefix + bk);
                    return u.toString();
                }
                // Threads
                if (h.includes('threads.net')) {
                    var th = u.searchParams.get('text') || '';
                    u.searchParams.set('text', prefix + th);
                    return u.toString();
                }
                // Mastodon
                if (u.searchParams.has('text')) {
                    var ms = u.searchParams.get('text') || '';
                    u.searchParams.set('text', prefix + ms);
                    return u.toString();
                }
                // Reddit
                if (h.includes('reddit.com')) {
                    var rt = u.searchParams.get('title') || '';
                    u.searchParams.set('title', 'Acabo de ver esto en Electomanía: ' + rt);
                    return u.toString();
                }
                // LinkedIn
                if (h.includes('linkedin.com')) {
                    var li = u.searchParams.get('title') || '';
                    u.searchParams.set('title', 'Acabo de ver esto en Electomanía: ' + li);
                    return u.toString();
                }
                // Meneame
                if (h.includes('meneame.net')) {
                    var mn = u.searchParams.get('title') || '';
                    u.searchParams.set('title', 'Acabo de ver esto en Electomanía: ' + mn);
                    return u.toString();
                }
            } catch (e) { /* URL malformada */ }
            return url;
        }
    })();
    </script>
