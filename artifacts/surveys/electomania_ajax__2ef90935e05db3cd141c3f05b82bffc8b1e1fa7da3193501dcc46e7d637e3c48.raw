#wpdcom .wpd-thread-head{align-items: baseline !important;}

#wpdcom .wpd-comment .wpd-avatar img, #wpdcom .wpd-comment .wpd-avatar img.avatar {
    border-radius: 100% !important;
}
#wpdcom .wpd-comment .wpd-comment-label{
	display: none !important}

#wpdcom .wpd-thread-head .wpdiscuz-user-settings{border-bottom:0px !important}

