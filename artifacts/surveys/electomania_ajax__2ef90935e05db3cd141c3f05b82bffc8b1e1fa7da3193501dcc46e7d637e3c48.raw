document.addEventListener('DOMContentLoaded', function () {
  const menu = document.querySelector('.js-menu-desplegable');
  const botonInicial = document.querySelector('.js-menu-hamburguesa');
  const icono = botonInicial ? botonInicial.querySelector('.elementor-icon') : null;

  const svgHamburguesa = `
    <svg aria-hidden="true" class="e-font-icon-svg e-fas-bars" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z"></path>
    </svg>
  `;

  const svgCerrar = `
    <svg aria-hidden="true" class="e-font-icon-svg e-fas-times" viewBox="0 0 352 512" xmlns="http://www.w3.org/2000/svg">
      <path d="M242.72 256l100.07-100.07c12.28-12.28 12.28-32.19 0-44.48l-22.24-22.24c-12.28-12.28-32.19-12.28-44.48 0L176 189.28 75.93 89.21c-12.28-12.28-32.19-12.28-44.48 0L9.21 111.45c-12.28 12.28-12.28 32.19 0 44.48L109.28 256 9.21 356.07c-12.28 12.28-12.28 32.19 0 44.48l22.24 22.24c12.28 12.28 32.2 12.28 44.48 0L176 322.72l100.07 100.07c12.28 12.28 32.2 12.28 44.48 0l22.24-22.24c12.28-12.28 12.28-32.19 0-44.48L242.72 256z"></path>
    </svg>
  `;

  if (menu) {
    menu.style.display = 'none';
  }

  if (icono) {
    icono.innerHTML = svgHamburguesa;
  }

  document.addEventListener('click', function(e) {
    const boton = e.target.closest('.js-menu-hamburguesa');
    const menu = document.querySelector('.js-menu-desplegable');
    const icono = boton ? boton.querySelector('.elementor-icon') : null;

    if (!boton || !menu) return;

    e.preventDefault();

    const estaAbierto = menu.classList.toggle('is-open');
    boton.classList.toggle('is-active', estaAbierto);

    if (estaAbierto) {
      menu.style.display = 'flex';

      if (icono) {
        icono.innerHTML = svgCerrar;
      }
    } else {
      menu.style.display = 'none';

      if (icono) {
        icono.innerHTML = svgHamburguesa;
      }
    }
  });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
	const error = document.querySelector('.ihc-login-error');

	if (!error) {
		return;
	}

	const notice = document.createElement('div');
	notice.className = 'em-login-error-bar';
	notice.innerHTML = `
		<span>${error.textContent}</span>
		<button type="button" aria-label="Cerrar aviso">×</button>
	`;

	const header = document.querySelector('header, .elementor-location-header');

	if (header) {
		header.insertAdjacentElement('afterend', notice);
	} else {
		document.body.prepend(notice);
	}

	notice.querySelector('button').addEventListener('click', function () {
		notice.remove();
	});
});
</script>

<style>
.em-login-error-bar {
	position: relative;
	z-index: 999999;
	background: #e3335b;
	color: #fff;
	padding: 12px 48px 12px 20px;
	text-align: center;
	font-size: 15px;
	font-weight: 600;
	box-shadow: 0 4px 18px rgba(0,0,0,.15);
}

.em-login-error-bar button {
	position: absolute;
	right: 16px;
	top: 50%;
	transform: translateY(-50%);
	border: 0;
	background: transparent;
	color: #fff;
	font-size: 24px;
	line-height: 1;
	cursor: pointer;
}
</style>
