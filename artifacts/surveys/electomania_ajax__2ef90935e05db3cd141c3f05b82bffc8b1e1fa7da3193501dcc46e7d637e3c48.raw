    .premium-post-ticker__post-wrapper.ecto-item .ecto-down { color:#dc2626 !important; }
 

    .premium-post-ticker__post-wrapper.ecto-item .ecto-name { font-weight:800 !important; letter-spacing:.2px !important; }
 
    

    body.ecto-ready .premium-post-ticker__hidden{
      visibility: visible  !important;
      opacity: 1  !important;
    }

    /* Kiosco total: evita interacción (refuerzo) */
    body.ecto-ready .u-noticias,
    body.ecto-ready .u-noticias-ecto{
      pointer-events: none  !important;
    }



