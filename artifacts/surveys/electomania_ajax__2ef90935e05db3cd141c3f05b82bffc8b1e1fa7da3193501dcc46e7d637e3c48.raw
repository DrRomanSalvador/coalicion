<script>
document.addEventListener('DOMContentLoaded', function () {
  const root = document.documentElement; 
  function toggle() {
    if (window.scrollY > 10) root.classList.add('has-scrolled');
    else root.classList.remove('has-scrolled');
  }
  toggle();
  window.addEventListener('scroll', toggle, { passive: true });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.custom-sear').forEach(function (header) {

    // Si ya fue inicializado por JS (no por HTML), salir
    if (header.dataset.emSearchReady === 'js') return;
    header.dataset.emSearchReady = 'js';

    const searchWidget = header.querySelector('.menu-s');
    if (!searchWidget) return;

    // Usar el panel ya existente en el HTML, no crear uno nuevo
    let panel = header.querySelector('.em-mobile-search-panel');
    if (!panel) {
      // Fallback: crearlo si no existe
      panel = document.createElement('div');
      panel.className = 'em-mobile-search-panel';
      panel.innerHTML = `
        <button type="button" class="em-mobile-search-close" aria-label="Cerrar buscador">×</button>
        <form class="em-mobile-search-form" action="https://electomania.es/" method="get">
          <input class="em-mobile-search-input" type="search" name="s" placeholder="Buscar contenido" autocomplete="off">
          <button class="em-mobile-search-submit" type="submit" aria-label="Buscar">
            <svg aria-hidden="true" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
              <path d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"></path>
            </svg>
          </button>
        </form>
      `;
      header.appendChild(panel);
    }

    const input = panel.querySelector('.em-mobile-search-input');
    const closeBtn = panel.querySelector('.em-mobile-search-close');
    const form = panel.querySelector('.em-mobile-search-form');

    function openSearch(event) {
      if (event) event.preventDefault();
      header.classList.add('em-search-active');
      setTimeout(function () { input.focus(); }, 260);
    }

    function closeSearch(event) {
      if (event) event.preventDefault();
      header.classList.remove('em-search-active');
      input.value = '';
      input.blur();
    }

    searchWidget.addEventListener('click', function (event) {
      if (!header.classList.contains('em-search-active')) {
        openSearch(event);
      }
    });

    closeBtn.addEventListener('click', closeSearch);

    form.addEventListener('submit', function (event) {
      if (input.value.trim() === '') {
        event.preventDefault();
        input.focus();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && header.classList.contains('em-search-active')) {
        closeSearch(event);
      }
    });
  });
});
</script>



<script>
	
	document.addEventListener('click', function(e) {
  // Solo actuar si el clic fue dentro del sub-arrow
  const arrow = e.target.closest('.men-re .menu-c a.has-submenu .sub-arrow');
  if (!arrow) return;

  e.preventDefault();
  e.stopPropagation();
  e.stopImmediatePropagation();

  const link = arrow.closest('a.has-submenu');
  const li = link.closest('li.menu-item-has-children');
  if (!li) return false;

  const submenu = li.querySelector(':scope > ul.sub-menu');
  if (!submenu) return false;

  const isOpen = link.getAttribute('aria-expanded') === 'true';
  if (isOpen) {
    link.setAttribute('aria-expanded', 'false');
    submenu.setAttribute('aria-hidden', 'true');
    submenu.setAttribute('aria-expanded', 'false');
    submenu.style.display = 'none';
    li.classList.remove('submenu-open');
  } else {
    link.setAttribute('aria-expanded', 'true');
    submenu.setAttribute('aria-hidden', 'false');
    submenu.setAttribute('aria-expanded', 'true');
    submenu.style.display = 'block';
    li.classList.add('submenu-open');
  }
  return false;
}, true);
	
	
</script>
