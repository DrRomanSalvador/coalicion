    <script nowprocket data-no-optimize="1" id="em-contadores-js">
(function () {
  var enlaces = document.querySelectorAll('.jeg_meta_comment a');
  if (!enlaces.length || !window.fetch) return;
  fetch('/wp-content/uploads/em-contadores.json?v=' + Math.floor(Date.now() / 20000), { credentials: 'omit' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d) return;
      enlaces.forEach(function (a) {
        var ruta;
        try { ruta = new URL(a.href, location.href).pathname; } catch (e) { return; }
        var trozos = ruta.split('/').filter(Boolean);
        if (!trozos.length) return;
        var slug = decodeURIComponent(trozos[trozos.length - 1]);
        if (!(slug in d)) return;
        var w = document.createTreeWalker(a, NodeFilter.SHOW_TEXT), nodo;
        while ((nodo = w.nextNode())) {
          if (/\d/.test(nodo.textContent)) {
            nodo.textContent = nodo.textContent.replace(/\d[\d.,]*/, String(d[slug]));
            break;
          }
        }
      });
    })
    .catch(function () {});
})();
</script>
    <script data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1">
(function(){
  var ORIGINS=['https://electomania.es','https://www.electomania.es'];
  function unwrap(f){
    var p=f.parentElement;
    for(var n=0;p&&n<3;n++,p=p.parentElement){
      var cs=getComputedStyle(p);
      if(parseFloat(cs.paddingBottom)>0&&parseFloat(cs.height)===0){p.style.setProperty('padding-bottom','0','important');}
      if(cs.overflow==='hidden'||cs.maxHeight!=='none'){p.style.setProperty('overflow','visible','important');p.style.setProperty('max-height','none','important');}
      if(cs.height&&p.style.height){p.style.setProperty('height','auto','important');}
    }
  }
  window.addEventListener('message',function(e){
    if(ORIGINS.indexOf(e.origin)===-1||!e.data||typeof e.data.h!=='number'||!e.data.emEmbed)return;
    var frames=document.querySelectorAll('iframe.em-embed');
    for(var i=0;i<frames.length;i++){
      if(frames[i].contentWindow===e.source){
        unwrap(frames[i]);
        frames[i].style.setProperty('height',(e.data.h+4)+'px','important');
      }
    }
  });
})();
</script>
	<style id="em-menu-movil">
/* El botón original de Elementor se oculta y ponemos el nuestro encima. */
body.em-panel-listo .em-menu-original {
	display: none !important;
}

.em-menu-boton {
	cursor: pointer;
	-webkit-tap-highlight-color: transparent;
}

/* ---- Panel ------------------------------------------------------------- */
.em-panel {
	position: fixed !important;
	top: 0 !important;
	bottom: 0 !important;
	left: 0 !important;
	width: min(86vw, 400px) !important;
	max-width: none !important;
	margin: 0 !important;
	padding: 0 0 40px !important;
	z-index: 100000 !important;
	background: #fff !important;
	background-image: none !important;
	box-shadow: 0 0 40px rgba(0,0,0,.18);
	transform: translate3d(-100%, 0, 0);
	visibility: hidden;
	pointer-events: none;
	transition: transform .28s cubic-bezier(.4,0,.2,1), visibility 0s linear .28s;
}

body.em-panel-abierto .em-panel {
	transform: translate3d(0, 0, 0);
	visibility: visible;
	pointer-events: auto;
	transition: transform .28s cubic-bezier(.4,0,.2,1), visibility 0s;
}

body.em-panel-arrastrando .em-panel {
	transition: none !important;
}

/* Los contenedores de dentro heredan la altura del icono al sacar el panel del
   flujo: hay que estirarlos para que la lista se despliegue en vertical. */
.em-panel > *,
.em-panel .elementor-widget-nav-menu,
.em-panel .elementor-nav-menu__container,
.em-panel .elementor-nav-menu--main {
	width: 100% !important;
	max-width: 100% !important;
	height: auto !important;
	min-height: 0 !important;
	max-height: none !important;
	display: block !important;
	flex: none !important;
	position: static !important;
	transform: none !important;
	opacity: 1 !important;
	overflow: visible !important;
}

.em-panel .elementor-nav-menu {
	display: block !important;
	width: 100% !important;
}

.em-panel .elementor-nav-menu > li {
	display: block !important;
	width: 100% !important;
	border-bottom: 1px solid rgba(0,0,0,.06);
}

.em-panel .elementor-nav-menu a {
	display: block !important;
	width: auto !important;
	padding: 15px 22px !important;
}

/* ---- Submenús: cerrados de entrada ------------------------------------- */
.em-panel .elementor-nav-menu ul.sub-menu {
	display: none !important;
	position: static !important;
	width: 100% !important;
	box-shadow: none !important;
	background: transparent !important;
	border-top: 1px solid rgba(0,0,0,.05);
}

.em-panel li.em-abierto > ul.sub-menu {
	display: block !important;
}

.em-panel ul.sub-menu a {
	padding-left: 42px !important;
	font-size: .93em !important;
	opacity: .85;
}

.em-panel ul.sub-menu ul.sub-menu a {
	padding-left: 62px !important;
}

.em-panel .sub-arrow {
	transition: transform .2s ease;
}

.em-panel li.em-abierto > a .sub-arrow,
.em-panel li.em-abierto > .sub-arrow {
	transform: rotate(180deg);
}

/* ---- Cabecera ---------------------------------------------------------- */
.em-panel-cabecera {
	position: sticky;
	top: 0;
	z-index: 3;
	display: flex;
	align-items: center;
	justify-content: flex-end;
	height: 56px;
	padding: 0 12px;
	background: #fff;
	border-bottom: 1px solid rgba(0,0,0,.08);
}

.em-panel-cerrar {
	width: 44px;
	height: 44px;
	border: 0;
	background: transparent;
	font-size: 30px;
	line-height: 1;
	color: #23282d;
	cursor: pointer;
	-webkit-tap-highlight-color: transparent;
}

/* ---- Zona de cierre al tocar fuera ------------------------------------- */
/* Transparente: solo sirve para cerrar, no para oscurecer. */
.em-panel-fondo {
	position: fixed;
	inset: 0;
	z-index: 99998;
	background: transparent;
	visibility: hidden;
	pointer-events: none;
}

body.em-panel-abierto .em-panel-fondo {
	visibility: visible;
	pointer-events: auto;
}

body.em-panel-abierto {
	overflow: hidden !important;
}

@media (prefers-reduced-motion: reduce) {
	.em-panel {
		transition-duration: .01ms !important;
	}
}

/* ======================================================================
   ACABADO
   ====================================================================== */

/* El panel es una franja completa: el fondo llega hasta abajo aunque el
   contenido no ocupe toda la altura. */
.em-panel {
	display: flex !important;
	flex-direction: column !important;
	background: #fff !important;
	box-shadow: 2px 0 24px rgba(15, 20, 30, .12) !important;
	padding-bottom: 0 !important;
}

.em-panel > *:not(.em-panel-cabecera) {
	flex: 1 0 auto;
}

/* ---- Cabecera ---------------------------------------------------------- */
.em-panel-cabecera {
	flex: 0 0 auto !important;
	height: 60px;
	padding: 0 8px 0 20px;
	justify-content: space-between;
	border-bottom: 1px solid rgba(15, 20, 30, .08);
}

.em-panel-cabecera::before {
	content: 'MENÚ';
	font-size: 12px;
	font-weight: 700;
	letter-spacing: .14em;
	color: rgba(15, 20, 30, .38);
}

.em-panel-cerrar {
	font-size: 26px;
	color: rgba(15, 20, 30, .55);
	transition: color .15s ease;
}

.em-panel-cerrar:hover,
.em-panel-cerrar:focus-visible {
	color: #0f141e;
}

/* ---- Nivel principal --------------------------------------------------- */
.em-panel .elementor-nav-menu > li > a {
	display: flex !important;
	align-items: center !important;
	justify-content: space-between !important;
	gap: 12px;
	padding: 16px 20px !important;
	font-size: 15px !important;
	font-weight: 700 !important;
	letter-spacing: .045em !important;
	text-transform: uppercase !important;
	color: #0f141e !important;
	line-height: 1.25 !important;
	transition: background-color .15s ease, color .15s ease;
}

.em-panel .elementor-nav-menu > li {
	border-bottom: 1px solid rgba(15, 20, 30, .06) !important;
	position: relative;
}

.em-panel .elementor-nav-menu > li > a:active {
	background: rgba(15, 20, 30, .04) !important;
}

/* Sección activa: barra a la izquierda, como en los medios grandes. */
.em-panel .elementor-nav-menu > li.current-menu-item > a,
.em-panel .elementor-nav-menu > li.current-menu-ancestor > a {
	box-shadow: inset 3px 0 0 #0f141e;
}

/* ---- Submenús ---------------------------------------------------------- */
.em-panel ul.sub-menu {
	background: rgba(15, 20, 30, .015) !important;
	border-top: 1px solid rgba(15, 20, 30, .05) !important;
	padding: 4px 0 8px !important;
}

.em-panel ul.sub-menu li {
	border: 0 !important;
}

.em-panel ul.sub-menu a {
	display: flex !important;
	align-items: center !important;
	justify-content: space-between !important;
	padding: 11px 20px 11px 34px !important;
	font-size: 13.5px !important;
	font-weight: 600 !important;
	letter-spacing: .05em !important;
	text-transform: uppercase !important;
	color: rgba(15, 20, 30, .72) !important;
	line-height: 1.3 !important;
}

.em-panel ul.sub-menu ul.sub-menu a {
	padding-left: 50px !important;
	font-size: 13px !important;
	font-weight: 500 !important;
	text-transform: none !important;
	letter-spacing: .02em !important;
	color: rgba(15, 20, 30, .62) !important;
}

/* ---- Flechas ----------------------------------------------------------- */
/* Alineadas con el texto, no flotando: el <a> es flex y la flecha va como
   último elemento con su propio ancho. */
.em-panel .sub-arrow {
	position: static !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	flex: 0 0 auto !important;
	width: 26px !important;
	height: 26px !important;
	margin: 0 !important;
	padding: 0 !important;
	transform: none !important;
	opacity: .45;
	transition: transform .22s ease, opacity .15s ease;
}

.em-panel .sub-arrow svg,
.em-panel .sub-arrow i {
	width: 12px !important;
	height: 12px !important;
	font-size: 12px !important;
	margin: 0 !important;
}

.em-panel li.em-abierto > a .sub-arrow,
.em-panel li.em-abierto > .sub-arrow {
	transform: rotate(180deg) !important;
	opacity: .85;
}

/* ---- Botones del final ------------------------------------------------- */
/* "Hazte patrón" y compañía: separados del listado, no como una entrada más. */
.em-panel .elementor-widget-button {
	padding: 18px 20px 26px !important;
	margin-top: auto !important;
}

.em-panel .elementor-button {
	width: 100% !important;
	justify-content: center !important;
	letter-spacing: .04em;
	text-transform: uppercase;
	font-weight: 700;
}


/* ======================================================================
   ACABADO 2
   ====================================================================== */

/* ---- El panel llena la pantalla --------------------------------------- */
/* El listado crece para ocupar el hueco, así el panel se lee como una franja
   lateral completa y no como un bloque colgado de la cabecera. */
/* El panel ocupa la pantalla completa: sin esto termina donde acaba la lista
   y por debajo se ve la página, que da aspecto de recuadro flotante. */
.em-panel {
	
	overflow-y: auto !important;
}

.em-panel .elementor-widget-nav-menu {
	flex: 1 1 auto !important;
	display: flex !important;
	flex-direction: column !important;
}

.em-panel .elementor-nav-menu__container {
	flex: 1 1 auto !important;
}

/* ---- Legibilidad sobre fondo oscuro ------------------------------------ */
/* El tema pinta de oscuro la entrada activa o pulsada pero deja la letra en
   negro. Forzamos blanco en todos esos estados. */
.em-panel .elementor-nav-menu li.current-menu-item > a,
.em-panel .elementor-nav-menu li.current-menu-ancestor > a,
.em-panel .elementor-nav-menu li.current-menu-parent > a,
.em-panel .elementor-nav-menu li.em-abierto > a,
.em-panel .elementor-item.elementor-item-active,
.em-panel .elementor-item:focus,
.em-panel .elementor-item:hover {
	color: #fff !important;
	background-color: #2c3340 !important;
	box-shadow: none !important;
}

.em-panel .elementor-nav-menu li.current-menu-item > a .sub-arrow,
.em-panel .elementor-nav-menu li.em-abierto > a .sub-arrow,
.em-panel .elementor-item.elementor-item-active .sub-arrow {
	color: #fff !important;
	opacity: .9;
}

.em-panel .elementor-nav-menu li.current-menu-item > a .sub-arrow svg,
.em-panel .elementor-nav-menu li.em-abierto > a .sub-arrow svg,
.em-panel .elementor-item.elementor-item-active .sub-arrow svg {
	fill: #fff !important;
}

/* Los submenús de una rama abierta no heredan el fondo oscuro. */
.em-panel li.em-abierto > ul.sub-menu a {
	color: rgba(15, 20, 30, .72) !important;
	background-color: transparent !important;
}

.em-panel li.em-abierto > ul.sub-menu ul.sub-menu a {
	color: rgba(15, 20, 30, .6) !important;
}

/* ---- Cabecera: la X se tiene que ver ----------------------------------- */
.em-panel-cabecera {
	display: flex !important;
	flex-direction: row !important;
	align-items: center !important;
	justify-content: space-between !important;
	height: 64px !important;
	min-height: 64px !important;
	padding: 0 12px 0 20px !important;
	background: #fff !important;
}

.em-panel-cabecera::before {
	font-size: 11px;
	letter-spacing: .18em;
	color: rgba(15, 20, 30, .3);
}

.em-panel-cerrar {
	width: 40px !important;
	height: 40px !important;
	display: flex !important;
	align-items: center !important;
	justify-content: center !important;
	font-size: 0 !important;
	border-radius: 50% !important;
	background: rgba(15, 20, 30, .05) !important;
	color: #0f141e !important;
	transition: background-color .15s ease;
}

/* La X dibujada, en vez del carácter &times; que quedaba fino y descolorido. */
.em-panel-cerrar::before {
	content: '';
	width: 15px;
	height: 15px;
	background-color: currentColor;
	-webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18.3 5.71 12 12.01l-6.3-6.3-1.4 1.42 6.29 6.3-6.3 6.29 1.42 1.41 6.29-6.3 6.3 6.3 1.41-1.42-6.3-6.29 6.3-6.3z'/></svg>") no-repeat center / contain;
	mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M18.3 5.71 12 12.01l-6.3-6.3-1.4 1.42 6.29 6.3-6.3 6.29 1.42 1.41 6.29-6.3 6.3 6.3 1.41-1.42-6.3-6.29 6.3-6.3z'/></svg>") no-repeat center / contain;
}

.em-panel-cerrar:active {
	background: rgba(15, 20, 30, .12) !important;
}

/* ---- Pesos tipográficos más contenidos --------------------------------- */
.em-panel .elementor-nav-menu > li > a {
	font-weight: 600 !important;
	letter-spacing: .06em !important;
	font-size: 14.5px !important;
}

.em-panel ul.sub-menu a {
	font-weight: 500 !important;
}

.em-panel ul.sub-menu ul.sub-menu a {
	font-weight: 400 !important;
}


/* ======================================================================
   REPARTO DE ALTURA
   ====================================================================== */

/* Sin ningún submenú abierto, las entradas se reparten el alto disponible. */
.em-panel:not(.em-hay-abierto) .elementor-nav-menu {
	display: flex !important;
	flex-direction: column !important;
	height: 100% !important;
}

.em-panel:not(.em-hay-abierto) .elementor-nav-menu > li {
	flex: 1 1 0 !important;
	display: flex !important;
	min-height: 46px;
}

.em-panel:not(.em-hay-abierto) .elementor-nav-menu > li > a {
	flex: 1 1 auto !important;
	display: flex !important;
	align-items: center !important;
}

/* El widget del menú ocupa el hueco entre la cabecera y el botón del final. */
.em-panel .elementor-widget-nav-menu {
	flex: 1 1 auto !important;
	min-height: 0 !important;
}

.em-panel .elementor-nav-menu__container {
	height: 100% !important;
}

/* Con un submenú desplegado la lista crece y hay que dejarla a su aire. */
.em-panel.em-hay-abierto .elementor-nav-menu {
	display: block !important;
	height: auto !important;
}


/* ======================================================================
   SUBMENÚS
   ====================================================================== */

/* ---- Nivel 2: cabeceras de grupo --------------------------------------- */
.em-panel ul.sub-menu {
	background: rgba(15, 20, 30, .022) !important;
	padding: 6px 0 10px !important;
}

.em-panel ul.sub-menu > li > a {
	padding: 13px 20px 13px 34px !important;
	font-size: 13px !important;
	font-weight: 700 !important;
	letter-spacing: .1em !important;
	text-transform: uppercase !important;
	color: rgba(15, 20, 30, .82) !important;
}

/* ---- Nivel 3: el listado largo ----------------------------------------- */
.em-panel ul.sub-menu ul.sub-menu {
	background: transparent !important;
	padding: 2px 0 6px !important;
	margin-left: 34px !important;
	border-left: 2px solid rgba(15, 20, 30, .1) !important;
	border-top: 0 !important;
}

.em-panel ul.sub-menu ul.sub-menu > li > a {
	padding: 12px 20px 12px 18px !important;
	font-size: 12.5px !important;
	font-weight: 600 !important;
	letter-spacing: .08em !important;
	text-transform: uppercase !important;
	color: rgba(15, 20, 30, .68) !important;
	line-height: 1.4 !important;
}

.em-panel ul.sub-menu ul.sub-menu > li > a:active {
	color: #0f141e !important;
	background: rgba(15, 20, 30, .05) !important;
}

/* ---- El resalte no se queda pegado ------------------------------------- */
/* :focus persiste tras el toque en móvil y dejaba la entrada en oscuro aunque
   ya estuviera cerrada. :focus-visible solo salta al navegar con teclado. */
.em-panel .elementor-item:focus:not(:focus-visible) {
	background-color: transparent !important;
	color: #0f141e !important;
}

.em-panel ul.sub-menu a:focus:not(:focus-visible) {
	background-color: transparent !important;
}

/* Oscuro solo donde toca: sección activa o rama desplegada. */
.em-panel .elementor-nav-menu > li:not(.em-abierto):not(.current-menu-item):not(.current-menu-ancestor) > a {
	background-color: transparent !important;
	color: #0f141e !important;
}


/* ======================================================================
   DÓNDE ESTAMOS
   ====================================================================== */

/* La entrada de la página actual, en cualquier nivel. */
.em-panel a.em-aqui {
	background-color: #2c3340 !important;
	color: #fff !important;
	font-weight: 700 !important;
}

.em-panel ul.sub-menu a.em-aqui,
.em-panel ul.sub-menu ul.sub-menu a.em-aqui {
	color: #fff !important;
	background-color: #2c3340 !important;
}

.em-panel a.em-aqui .sub-arrow svg {
	fill: #fff !important;
}

/* Las ramas por las que se llega: marcadas sin robar protagonismo. */
.em-panel li.em-rama > a {
	color: #0f141e !important;
	font-weight: 700 !important;
	box-shadow: inset 3px 0 0 #2c3340;
}

.em-panel ul.sub-menu li.em-rama > a {
	box-shadow: inset 2px 0 0 #2c3340;
}


/* Última palabra sobre el color de la entrada actual: sin esto el texto se
   quedaba en gris sobre el fondo oscuro y no se leía. */
.em-panel a.em-aqui,
.em-panel a.em-aqui *,
.em-panel ul.sub-menu a.em-aqui,
.em-panel ul.sub-menu ul.sub-menu > li > a.em-aqui {
	color: #fff !important;
	opacity: 1 !important;
}

.em-panel a.em-aqui svg,
.em-panel a.em-aqui path {
	fill: #fff !important;
}

/* Elementor marca entradas con elementor-item-active por su cuenta y no siempre
   acierta (en la portada resaltaba Datamania). Quien manda es em-aqui, que
   calculamos comparando la URL. */
.em-panel .elementor-item-active:not(.em-aqui) {
	background-color: transparent !important;
	color: #0f141e !important;
	font-weight: 600 !important;
	box-shadow: none !important;
}

.em-panel ul.sub-menu .elementor-item-active:not(.em-aqui),
.em-panel ul.sub-menu .elementor-sub-item.elementor-item-active:not(.em-aqui) {
	background-color: transparent !important;
	color: rgba(15, 20, 30, .68) !important;
}
</style>

<script id="em-menu-movil-js">
(function () {
	'use strict';

	var ANCHO_MAX = 1024;
	var panel, fondo, boton, abierto = false, ultimoFoco = null;

	function focoables() {
		return panel.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])');
	}

	function abrir() {
		if (abierto) return;
		abierto = true;
		ultimoFoco = document.activeElement;
		document.body.classList.add('em-panel-abierto');
		panel.setAttribute('aria-hidden', 'false');
		boton.setAttribute('aria-expanded', 'true');
	}

	function cerrar() {
		if (!abierto) return;
		abierto = false;

		// Recogemos lo que el usuario abriera a mano, pero dejamos desplegada la
		// rama de la página actual: es la referencia de dónde está.
		panel.querySelectorAll('li.em-abierto:not(.em-rama)').forEach(function (li) {
			li.classList.remove('em-abierto');
		});
		panel.classList.toggle('em-hay-abierto', !!panel.querySelector('li.em-abierto'));
		document.body.classList.remove('em-panel-abierto');
		panel.setAttribute('aria-hidden', 'true');
		boton.setAttribute('aria-expanded', 'false');
		if (ultimoFoco && ultimoFoco.focus) ultimoFoco.focus();
	}

	/** El menú con más submenús es el completo; su contenedor es el panel. */
	function localizarPanel() {
		var mejor = null, max = 0;

		document.querySelectorAll('.elementor-nav-menu').forEach(function (m) {
			var n = m.querySelectorAll('ul').length;
			if (n > max) { max = n; mejor = m; }
		});

		if (!mejor || max < 3) return null;

		var widget = mejor.closest('.elementor-widget-nav-menu') || mejor.closest('[data-id]');
		if (!widget) return null;

		// El panel es el contenedor que envuelve al widget.
		return widget.parentElement ? widget.parentElement.closest('[data-id]') : null;
	}

	/** El botón es el icono de hamburguesa sin enlace. */
	function localizarBoton() {
		var encontrado = null;

		document.querySelectorAll('.elementor-icon-wrapper').forEach(function (ic) {
			if (encontrado) return;
			var svg = ic.querySelector('svg');
			if (!svg) return;
			var cls = svg.getAttribute('class') || '';
			if (/bars|menu/i.test(cls)) encontrado = ic;
		});

		return encontrado;
	}

	/** Ruta normalizada de una URL, para poder compararlas. */
	function ruta(u) {
		try {
			return new URL(u, location.origin).pathname.replace(/\/+$/, '').toLowerCase();
		} catch (e) {
			return '';
		}
	}

	/**
	 * Despliega la rama de la página actual y marca la entrada, para que al
	 * reabrir el menú se vea dónde estamos.
	 */
	function situar() {
		var aqui = ruta(location.href);
		var enlaces = panel.querySelectorAll('.elementor-nav-menu a[href]');
		var elegido = null;

		// 1. Coincidencia exacta de URL: lo más fiable.
		for (var i = 0; i < enlaces.length && !elegido; i++) {
			var h = enlaces[i].getAttribute('href') || '';
			if (h === '' || h.charAt(0) === '#') continue;
			if (ruta(enlaces[i].href) === aqui) elegido = enlaces[i];
		}

		// 2. Lo que haya marcado WordPress.
		if (!elegido) {
			var li = panel.querySelector('.elementor-nav-menu li.current-menu-item');
			if (li) elegido = li.querySelector('a');
		}

		// 3. Lo último que se pulsó.
		if (!elegido) {
			try {
				var ultimo = sessionStorage.getItem('em-menu-ultimo');
				if (ultimo) {
					for (var j = 0; j < enlaces.length && !elegido; j++) {
						if (ruta(enlaces[j].href) === ultimo) elegido = enlaces[j];
					}
				}
			} catch (e) {}
		}

		// Elementor marca entradas con elementor-item-active por su cuenta y no
		// siempre acierta (en la portada resaltaba Datamania). Se la quitamos a
		// todas: quien manda es em-aqui, que calculamos por URL. Hacerlo aquí y
		// no con CSS evita pelearse con la especificidad de sus reglas.
		panel.querySelectorAll('.elementor-item-active').forEach(function (el) {
			if (el !== elegido) el.classList.remove('elementor-item-active');
		});

		panel.querySelectorAll('li.current-menu-item, li.current-menu-ancestor').forEach(function (li) {
			if (!li.contains(elegido)) {
				li.classList.remove('current-menu-item', 'current-menu-ancestor');
			}
		});

		if (!elegido) return;

		elegido.classList.add('em-aqui');

		// Desplegamos todos los niveles por encima.
		var li = elegido.closest('li');
		var hubo = false;

		while (li && panel.contains(li)) {
			var padre = li.parentElement ? li.parentElement.closest('li') : null;
			if (padre) {
				padre.classList.add('em-abierto', 'em-rama');
				hubo = true;
			}
			li = padre;
		}

		if (hubo) {
			panel.classList.add('em-hay-abierto');
		}

		// Y lo dejamos a la vista.
		requestAnimationFrame(function () {
			var r = elegido.getBoundingClientRect();
			var rp = panel.getBoundingClientRect();
			if (r.top < rp.top || r.bottom > rp.bottom) {
				panel.scrollTop += (r.top - rp.top) - rp.height / 3;
			}
		});
	}

	function preparar() {
		panel = localizarPanel();
		var icono = localizarBoton();
		if (!panel || !icono) return false;

		// --- Botón: lo reemplazamos por una copia sin la clase que Elementor
		//     busca en su delegación, y le ponemos nuestro manejador. ---
		var limpio = icono.cloneNode(true);
		limpio.classList.remove('elementor-icon-wrapper');
		limpio.classList.add('em-menu-boton');
		limpio.setAttribute('role', 'button');
		limpio.setAttribute('tabindex', '0');
		limpio.setAttribute('aria-label', 'Abrir menú');
		limpio.setAttribute('aria-expanded', 'false');
		icono.parentNode.replaceChild(limpio, icono);
		boton = limpio;

		boton.addEventListener('click', function (e) {
			e.preventDefault();
			e.stopPropagation();
			abierto ? cerrar() : abrir();
		});
		boton.addEventListener('keydown', function (e) {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				abierto ? cerrar() : abrir();
			}
		});

		// --- Panel al body: dentro de su contenedor, el z-index no compite con
		//     el del fondo y este acababa robándole los clics. ---
		panel.classList.add('em-panel');
		document.body.appendChild(panel);

		// En Safari la barra de direcciones aparece y desaparece, y 100dvh no
		// siempre coincide con lo que se ve: fijamos la altura real y la
		// recalculamos si cambia.
		// Nada de alturas calculadas: el panel se ancla arriba y abajo y se
		// estira solo. Es lo único que se comporta igual en Safari, Chrome y el
		// modo responsive, sin pelearse con dvh, svh ni visualViewport.
		// Nada de alturas calculadas: el panel se ancla arriba y abajo y se
		// estira solo. Es lo único que se comporta igual en Safari, Chrome y el
		// modo responsive, sin pelearse con dvh, svh ni visualViewport.
		function altura() {}


		altura();
		window.addEventListener('resize', altura);
		if (window.visualViewport) {
			window.visualViewport.addEventListener('resize', altura);
		}
		panel.style.setProperty('display', 'block', 'important');
		panel.style.setProperty('overflow-y', 'auto', 'important');

		panel.setAttribute('aria-hidden', 'true');
		panel.setAttribute('role', 'dialog');
		panel.setAttribute('aria-modal', 'true');
		panel.setAttribute('aria-label', 'Menú de navegación');

		// --- Zona de cierre ---
		fondo = document.createElement('div');
		fondo.className = 'em-panel-fondo';
		fondo.setAttribute('aria-hidden', 'true');
		document.body.appendChild(fondo);
		fondo.addEventListener('click', cerrar);

		// --- Cabecera con la X ---
		var cab = document.createElement('div');
		cab.className = 'em-panel-cabecera';
		var x = document.createElement('button');
		x.className = 'em-panel-cerrar';
		x.type = 'button';
		x.setAttribute('aria-label', 'Cerrar menú');
		x.innerHTML = '&times;';
		x.addEventListener('click', cerrar);
		cab.appendChild(x);
		panel.insertBefore(cab, panel.firstChild);

		document.body.classList.add('em-panel-listo');

		// --- Dejar abierta la rama de la página actual ---
		situar();

		// --- Desplegables: al mover el panel, el JS de Elementor ya no llega ---
		panel.addEventListener('click', function (e) {
			// La flecha sigue funcionando, pero tocar el nombre de una
			// seccion con submenu tambien lo despliega: 45x11 px es un
			// objetivo demasiado pequeno para un dedo. El segundo toque,
			// con la rama ya abierta, navega a la seccion.
			var flecha = e.target.closest('.sub-arrow');

			if (!flecha) {
				var enlace = e.target.closest('a');
				if (!enlace) return;

				var liEnlace = enlace.closest('li');
				if (!liEnlace || !liEnlace.querySelector('.sub-menu')) return;
				if (liEnlace.classList.contains('em-abierto')) return;

				flecha = liEnlace.querySelector('.sub-arrow') || enlace;
			}

			e.preventDefault();
			e.stopPropagation();

			var li = flecha.closest('li');
			if (!li) return;

			var abriendo = !li.classList.contains('em-abierto');

			// Uno abierto a la vez en cada nivel.
			var hermanos = li.parentNode.children;
			for (var i = 0; i < hermanos.length; i++) {
				if (hermanos[i] !== li) hermanos[i].classList.remove('em-abierto');
			}

			li.classList.toggle('em-abierto', abriendo);

			// Con algo desplegado, las entradas dejan de repartirse la altura:
			// la lista pasa a ser más larga que la pantalla y toca desplazarse.
			panel.classList.toggle(
				'em-hay-abierto',
				!!panel.querySelector('li.em-abierto')
			);
		}, true);

		// --- Enlaces normales: navegan y cierran ---
		panel.addEventListener('click', function (e) {
			var a = e.target.closest('a');
			if (!a || e.target.closest('.sub-arrow')) return;
			if (e.defaultPrevented) return;

			// Primer toque en una seccion con submenu: desplegar, no navegar.
			var liA = a.closest('li');
			if (liA && liA.querySelector('.sub-menu') && !liA.classList.contains('em-abierto')) {
				e.preventDefault();
				var hs = liA.parentNode.children;
				for (var k = 0; k < hs.length; k++) {
					if (hs[k] !== liA) hs[k].classList.remove('em-abierto');
				}
				liA.classList.add('em-abierto');
				panel.classList.toggle('em-hay-abierto', !!panel.querySelector('li.em-abierto'));
				return;
			}
			var href = a.getAttribute('href') || '';
			if (href === '' || href.charAt(0) === '#') return;

			// Para poder volver a esta rama si la página de destino no coincide
			// exactamente con ningún enlace del menú.
			try {
				sessionStorage.setItem('em-menu-ultimo', ruta(a.href));
			} catch (e) {}

			cerrar();
		});

		// --- Escape ---
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && abierto) cerrar();
		});

		// --- El foco no sale del panel ---
		document.addEventListener('keydown', function (e) {
			if (!abierto || e.key !== 'Tab') return;
			var f = focoables();
			if (!f.length) return;
			var pri = f[0], ult = f[f.length - 1];
			if (e.shiftKey && document.activeElement === pri) {
				e.preventDefault(); ult.focus();
			} else if (!e.shiftKey && document.activeElement === ult) {
				e.preventDefault(); pri.focus();
			}
		});

		// --- Arrastrar a la izquierda para cerrar ---
		var x0 = null, y0 = null, dx = 0, arrastrando = false;

		panel.addEventListener('touchstart', function (e) {
			if (!abierto) return;
			x0 = e.touches[0].clientX;
			y0 = e.touches[0].clientY;
			dx = 0;
		}, { passive: true });

		panel.addEventListener('touchmove', function (e) {
			if (!abierto || x0 === null) return;
			dx = e.touches[0].clientX - x0;
			if (Math.abs(dx) < Math.abs(e.touches[0].clientY - y0) || dx > 0) return;
			if (!arrastrando) {
				arrastrando = true;
				document.body.classList.add('em-panel-arrastrando');
			}
			panel.style.transform = 'translate3d(' + dx + 'px,0,0)';
		}, { passive: true });

		panel.addEventListener('touchend', function () {
			if (!abierto || x0 === null) return;
			document.body.classList.remove('em-panel-arrastrando');
			panel.style.transform = '';
			arrastrando = false;
			if (dx < -panel.offsetWidth / 3) cerrar();
			x0 = y0 = null; dx = 0;
		});

		window.addEventListener('resize', function () {
			if (abierto && window.innerWidth > ANCHO_MAX) cerrar();
		});

		return true;
	}

	function iniciar() {
		if (preparar()) return;
		var n = 0;
		var t = setInterval(function () {
			if (preparar() || ++n > 30) clearInterval(t);
		}, 100);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', iniciar);
	} else {
		iniciar();
	}
})();
</script>
	<script id="em-seccion-activa">
(function () {
  // Rutas ordenadas de la sección más concreta a la más general.
  var rutas = ["\/encuestas"];

  function ruta(a) {
    // Los enlaces sin destino real ("#", el desplegable "+") resolverían a la ruta
    // de la página actual y coincidirían siempre. Los descartamos.
    var href = a.getAttribute('href') || '';
    if (href === '' || href.charAt(0) === '#') return '';

    try {
      return new URL(a.href, location.origin).pathname.replace(/\/+$/, '');
    } catch (e) {
      return '';
    }
  }

  function marcar() {
    var menus = document.querySelectorAll('.elementor-nav-menu');
    if (!menus.length) return false;

    menus.forEach(function (menu) {
      var enlaces = menu.querySelectorAll('a.elementor-item, a.elementor-sub-item');
      if (!enlaces.length) return;

      // En cada menú marcamos el enlace de la sección más concreta que aparezca.
      var elegido = null;
      for (var i = 0; i < rutas.length && !elegido; i++) {
        enlaces.forEach(function (a) {
          if (!elegido && ruta(a) === rutas[i]) elegido = a;
        });
      }

      enlaces.forEach(function (a) {
        var suyo = (a === elegido);
        a.classList.toggle('elementor-item-active', suyo);

        var li = a.closest('li');
        if (li) {
          li.classList.toggle('current-menu-item', suyo);
          if (!suyo) {
            li.classList.remove('current_page_item', 'current-menu-ancestor', 'current-menu-parent');
          }
        }
      });
    });

    return true;
  }

  if (!marcar()) {
    // El widget puede montarse después; lo intentamos unas cuantas veces.
    var n = 0;
    var t = setInterval(function () {
      if (marcar() || ++n > 20) clearInterval(t);
    }, 100);
  }
})();
</script>
    <script type="text/javascript">;!function(){"use strict";window.jnews=window.jnews||{},window.jnews.first_load=window.jnews.first_load||{},window.jnews.first_load=function(){var e=this,t=jnews.library,n="object"==typeof jnews&&"object"==typeof jnews.library;e.data=null,e.run_ajax=!0,e.run_loginregister=!0,e.clear=function(){e.run_ajax=!0,e.run_loginregister=!0,e.data=null},e.init=function(){n&&(t.globalBody.querySelectorAll(".jeg_popup_account").length&&jnews.loginregister&&(e.run_loginregister=!1,""===jnewsoption.custom_login&&(jnews.loginregister.init(),jnews.loginregister.hook_form())),jfla.length&&e.run_ajax&&(e.run_ajax=!1,e.do_ajax({action:"jnews_first_load_action",jnews_id:jnewsoption.postid,load_action:jfla})))},e.update_counter=function(){if(n){var o={total_view:t.globalBody.querySelectorAll(".jeg_share_stats .jeg_views_count .counts"),total_share:t.globalBody.querySelectorAll(".jeg_share_stats .jeg_share_count .counts"),total_comment:t.globalBody.querySelectorAll(".jeg_meta_comment a span")};t.forEach(Object.entries(e.data.counter),function([e,n]){o[e].length&&t.forEach(o[e],function(e,o){t.setText(e,n)})})}},e.do_ajax=function(o){if(n){var a=new XMLHttpRequest;a.onreadystatechange=function(){XMLHttpRequest.DONE===a.readyState&&200==a.status&&(e.data=JSON.parse(a.responseText),e.data.counter&&"object"==typeof e.data.counter&&e.update_counter())},a.open("POST",jnews_ajax_url,!0),a.setRequestHeader("Content-Type","application/x-www-form-urlencoded; charset=UTF-8"),a.send(t.httpBuildQuery(o))}}},window.jnews.first_load=new window.jnews.first_load,jnews.first_load.init()}();</script><style id="em-aviso-cookies-login-css">
.em-aviso-cookies {
	display: none;
	margin: 0 0 16px;
	padding: 14px 16px;
	border: 1px solid rgba(15, 20, 30, .12);
	border-left: 3px solid #2c3340;
	border-radius: 6px;
	background: rgba(15, 20, 30, .03);
	font-size: 14px;
	line-height: 1.45;
	color: #0f141e;
}

/* La pone el JS cuando comprueba que aun no hay consentimiento. */
.em-aviso-cookies.em-visible {
	display: block;
}

.em-aviso-cookies p {
	margin: 0 0 10px;
}

.em-aviso-cookies button {
	display: inline-block;
	padding: 9px 16px;
	border: 0;
	border-radius: 4px;
	background: #2c3340;
	color: #fff;
	font-size: 13px;
	font-weight: 600;
	letter-spacing: .03em;
	cursor: pointer;
}

.em-aviso-cookies button:hover,
.em-aviso-cookies button:focus-visible {
	background: #0f141e;
}
</style>

<script id="em-aviso-cookies-login-js">
(function () {
	'use strict';

	/**
	 * Complianz marca el consentimiento de dos formas y no siempre estan las
	 * dos disponibles a la vez, asi que probamos ambas antes de decidir.
	 */
	function hayConsentimiento() {

		// 1. La funcion del propio plugin, que es lo mas fiable.
		if ( 'function' === typeof window.cmplz_has_consent ) {
			try {
				return !! window.cmplz_has_consent( 'marketing' );
			} catch ( e ) {}
		}

		// 2. Las clases que Complianz deja en el body.
		var b = document.body;
		if ( b.classList.contains( 'cmplz-marketing' ) ) {
			return true;
		}

		// 3. La cookie, por si el script aun no ha arrancado.
		if ( /cmplz_marketing=allow/.test( document.cookie ) ) {
			return true;
		}

		return false;
	}

	/** El contenedor de botones sociales, este donde este. */
	function contenedorSocial() {
		return document.querySelector(
			'.theChampSocialLoginContainer, .theChampLoginContainer, ' +
			'.theChampFacebookBackground, .theChampFacebookLogin'
		);
	}

	function montar() {

		if ( document.querySelector( '.em-aviso-cookies' ) ) {
			return;
		}

		var social = contenedorSocial();
		if ( ! social ) {
			return;
		}

		// Subimos hasta el bloque que agrupa los botones, para no colar el
		// aviso entre dos iconos.
		// Los botones son <li> de un <ul class="the_champ_login_ul">: si nos
		// colgamos del boton, el aviso se cuela entre los iconos y los descoloca.
		var ancla = social.closest( '.the_champ_login_ul' ) ||
		            social.closest( '.theChampSocialLoginContainer' ) ||
		            social;

		var aviso = document.createElement( 'div' );
		aviso.className = 'em-aviso-cookies';
		aviso.innerHTML =
			'<p><strong>¿No te funciona el acceso con Facebook o Google?</strong><br>' +
			'Estos servicios necesitan tu permiso para instalar cookies. ' +
			'Acepta la política de cookies y podrás entrar con normalidad.</p>' +
			'<button type="button">Ver las opciones de cookies</button>';

		aviso.querySelector( 'button' ).addEventListener( 'click', function () {
			// Complianz expone esta funcion para reabrir el banner; si no
			// estuviera, mandamos al usuario a la politica de cookies.
			// En esta version de Complianz no existe cmplz_show_banner: el
			// banner se reabre poniendo su estado en "show".
			if ( 'function' === typeof window.cmplz_set_banner_status ) {
				window.cmplz_set_banner_status( 'show' );
				return;
			}
			var enlace = document.querySelector( '.cmplz-manage-consent, a[href*="cookie"]' );
			if ( enlace ) {
				enlace.click();
			}
		} );

		ancla.parentNode.insertBefore( aviso, ancla );

		return aviso;
	}

	function revisar() {

		var aviso = document.querySelector( '.em-aviso-cookies' ) || montar();
		if ( ! aviso ) {
			return;
		}

		aviso.classList.toggle( 'em-visible', ! hayConsentimiento() );
	}

	// Al cargar, y otra vez un poco despues: Complianz decide el estado del
	// consentimiento despues de que el DOM este listo.
	if ( 'loading' === document.readyState ) {
		document.addEventListener( 'DOMContentLoaded', revisar );
	} else {
		revisar();
	}

	setTimeout( revisar, 800 );
	setTimeout( revisar, 2500 );

	// Y en cuanto el visitante acepta, el aviso desaparece solo.
	document.addEventListener( 'cmplz_fire_categories', revisar );
	document.addEventListener( 'cmplz_status_change', revisar );
} )();
</script>
			<script>
	(function () {
		function setCookie(name, value, maxAge) {
			var secure = window.location.protocol === 'https:' ? '; Secure' : '';
			document.cookie = name + '=' + value + '; path=/; max-age=' + maxAge + '; SameSite=Lax' + secure;
		}

		document.addEventListener('click', function (e) {
			var headerBtn = e.target.closest('.login-popup-header');
			var protectedBtn = e.target.closest('.login-popup-protected');

			if (headerBtn) {
				setCookie('patron_login_source', 'header', 1800);
				return;
			}

			if (protectedBtn) {
				setCookie('patron_login_source', 'protected', 1800);
			}
		}, true);
	})();
	</script>
	    <script id="wpdiscuz-hover-fixes">
    (function () {
        if (typeof jQuery === 'undefined') return;
        jQuery(function ($) {
            if (typeof wpdiscuzAjaxObj === 'undefined') return;

            // (A) POPUP "QUIÉN VOTÓ" — reemplazar mouseout por mouseenter/mouseleave
            $('body').off('mouseout', '.wpd-comment-wrap .wpd-comment-footer .wpd-vote');
            $('body').on('mouseenter', '.wpd-vote-result', function () {
                var vr = $(this);
                var voteType = vr.hasClass('wpd-vote-result-like') ? 'like'
                             : vr.hasClass('wpd-vote-result-dislike') ? 'dislike' : 'total';
                var cid = vr.closest('.wpd-comment-right').attr('id');
                if (!cid) return;
                cid = cid.substring(cid.lastIndexOf('-') + 1);
                var footer = vr.closest('.wpd-comment-footer').find('.wpd-vote');
                var existing = footer.find('.wv-body[data-type="' + voteType + '"]');
                if (existing.length) { existing.find('.vote-head').show(); return; }
                $.ajax({
                    type: 'POST', url: wpdiscuzAjaxObj.url,
                    data: { page: 1, hovered: voteType, id: cid, action: 'voters' }
                }).done(function (response) {
                    if (response && response.trim()) {
                        footer.find('.wv-body[data-type="' + voteType + '"]').remove();
                        $(response).appendTo(footer);
                        footer.find('.wv-body[data-type="' + voteType + '"] .vote-head, .vote-head').show();
                    }
                });
            });
            $('body').on('mouseleave', '.wpd-vote', function () {
                $(this).find('.vote-head').hide();
            });

            // (B) POPUP INFO USUARIO — reposicionar con MutationObserver (+650px)
            var WCAI_OFFSET = 650;
            function attachWcaiObserver() {
                var box = document.getElementById('wcaiInfoShort');
                if (!box || box._wcaiObserverAttached) return;
                box._wcaiObserverAttached = true;
                var obs = new MutationObserver(function (muts) {
                    muts.forEach(function (m) {
                        if (m.attributeName !== 'style') return;
                        var cur = parseFloat(box.style.top);
                        if (isNaN(cur)) return;
                        var corrected = cur + WCAI_OFFSET;
                        if (box._wcaiLast !== undefined && Math.abs(cur - box._wcaiLast) < 1) return;
                        box._wcaiLast = corrected;
                        box.style.setProperty('top', corrected + 'px', 'important');
                    });
                });
                obs.observe(box, { attributes: true, attributeFilter: ['style'] });
            }
            $('body').on('mouseover', '.wcai-short-info', function () {
                setTimeout(attachWcaiObserver, 50);
            });
            attachWcaiObserver();
        });
    })();
    </script>
      <script>
  (function(){
    if (window.__ectoIhcPasswordToggleFix) return;
    window.__ectoIhcPasswordToggleFix = true;

    function togglePassword(btn) {
      var formLine = btn.closest('.impu-form-line-fr, .iump-form-line-register, form');
      var input = null;

      if (formLine) {
        input = formLine.querySelector('input[type="password"], input[type="text"][name="pwd"], input[name="pwd"], input[name="pass1"], input[name="pass2"]');
      }

      if (!input && btn.previousElementSibling && btn.previousElementSibling.matches('input')) {
        input = btn.previousElementSibling;
      }

      if (!input) return;

      var show = input.type === 'password';

      input.type = show ? 'text' : 'password';
      btn.dataset.toggle = show ? '1' : '0';
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');

      var icon = btn.querySelector('.dashicons');
      if (icon) {
        icon.classList.toggle('dashicons-visibility', !show);
        icon.classList.toggle('dashicons-hidden', show);
      }
    }

    document.addEventListener('click', function(e){
      var btn = e.target.closest('.ihc-hide-login-pw, .ihc-hide-pw');
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      togglePassword(btn);
    }, true);
  })();
  </script>
