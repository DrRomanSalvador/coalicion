	<style id="em-tablas-sondeo">
/* Red de seguridad: si la tabla no cabe, se desplaza en horizontal
   en vez de cortarse. El <details> no trae overflow en linea. */
details table {
    display: block !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    white-space: normal !important;
}

@media (max-width: 782px) {
    /* La columna de ideologia es la que hace impracticable la tabla en movil.
       Los datos (voto, escanos, gobierno) caben de sobra sin ella. */
    details table th:nth-child(2),
    details table td:nth-child(2) {
        display: none !important;
    }

    /* Las celdas no llevan font-size en linea, asi que si podemos ajustarlo. */
    details table th,
    details table td {
        font-size: 13px !important;
        line-height: 1.35 !important;
        word-break: normal !important;
        hyphens: none !important;
    }

    details table {
        display: table !important;
        width: 100% !important;
        table-layout: auto !important;
    }

    details caption {
        font-size: 12px !important;
        line-height: 1.4 !important;
    }

    details summary {
        font-size: 14px !important;
        line-height: 1.4 !important;
    }
}

@media (max-width: 420px) {
    details table th,
    details table td {
        font-size: 12px !important;
    }
}
</style>
    <style id="em-sin-form-comentarios">
/* Comentarios cerrados: fuera el formulario, también para moderadores, pero el
   hilo se queda visible.
   Ojo con #respond: en esta plantilla no envuelve solo el formulario, sino todo
   el bloque de wpDiscuz. Ocultarlo dejaba los 184 comentarios en el DOM con
   altura cero, o sea invisibles. */
#commentform,
.comment-respond,
#wpdcom .wpd-form,
#wpdcom .wpd-form-wrap,
.wpd-secondary-form-wrapper,
.wpd-form-head,
.wpdiscuz-subscribe-bar,
.wpd-login-to-comment { display: none !important; }

/* Y el contenedor del hilo, visible a la fuerza. */
#respond,
#wpdcom,
#wpd-threads,
.wpd-thread-list { display: block !important; }
</style>
