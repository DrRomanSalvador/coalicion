<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />		<script id="em-gpt-display-seguro">
(function () {
	'use strict';

	window.googletag = window.googletag || { cmd: [] };

	googletag.cmd.push(function () {
		if (typeof googletag.display !== 'function' || googletag.__emEnvuelto) { return; }

		var original = googletag.display;

		googletag.display = function (hueco) {
			try {
				var id = (typeof hueco === 'string') ? hueco : (hueco && hueco.id);

				if (id && googletag.pubads && typeof googletag.pubads === 'function') {
					var slots = googletag.pubads().getSlots();

					// Lista vacia: display() se ha llamado antes de definir nada,
					// asi que no hay con que comparar. Se deja pasar.
					if (slots && slots.length) {
						var existe = slots.some(function (s) {
							return s.getSlotElementId() === id;
						});
						if (!existe) { return; }
					}
				}
			} catch (e) {
				// Ante cualquier duda, se llama igual: mejor un aviso en consola
				// que perder un anuncio.
			}

			return original.apply(googletag, arguments);
		};

		googletag.__emEnvuelto = true;
	});
})();
</script>
