<script id="ecto-ticker-inline-script-js-after">
(function(){
  if (window.__ECTO_TICKER_NATIVE_INIT__) return;
  window.__ECTO_TICKER_NATIVE_INIT__ = true;

  var PX_PER_SECOND = 60;

  function setupTicker(root){
    if (!root || root.dataset.ectoReady === '1') return;

    var viewport = root.querySelector('.premium-post-ticker__posts-wrapper');
    var track    = root.querySelector('.ecto-ticker-track');

    if (!viewport || !track) return;

    var originals = Array.prototype.slice.call(track.children).filter(function(el){
      return !el.classList.contains('ecto-clone') && !el.classList.contains('ecto-gap');
    });

    if (!originals.length) return;

    root.dataset.ectoReady = '1';

    var pos = 0;
    var loopWidth = 0;
    var lastTs = 0;
    var rafId = 0;
    var resizeRaf = 0;
    var ro = null;

    function stop(){
      if (!rafId) return;
      window.cancelAnimationFrame(rafId);
      rafId = 0;
    }

    function start(){
      if (rafId || loopWidth <= 0) return;
      lastTs = 0;
      rafId = window.requestAnimationFrame(frame);
    }

    function clearExtras(){
      track.querySelectorAll('.ecto-clone, .ecto-gap').forEach(function(node){
        node.remove();
      });
    }

    function measureOriginalWidth(){
      var width = 0;
      originals.forEach(function(el){
        width += el.offsetWidth;
      });
      return width;
    }

    function buildTrack(){
      clearExtras();

      var originalWidth = measureOriginalWidth();
      var viewportWidth = viewport.offsetWidth || 0;

     
      var minGap = 0;
      var gapWidth = Math.max(minGap, viewportWidth - originalWidth + minGap);

      var gap = document.createElement('div');
      gap.className = 'ecto-gap';
      gap.setAttribute('aria-hidden', 'true');
      gap.style.flex = '0 0 ' + gapWidth + 'px';
      gap.style.width = gapWidth + 'px';
      gap.style.pointerEvents = 'none';

      track.appendChild(gap);

      originals.forEach(function(node){
        var clone = node.cloneNode(true);
        clone.classList.add('ecto-clone');
        clone.setAttribute('aria-hidden', 'true');

        clone.querySelectorAll('a').forEach(function(a){
          a.setAttribute('tabindex', '-1');
        });

        track.appendChild(clone);
      });

      return {
        originalWidth: originalWidth,
        gapWidth: gapWidth
      };
    }

    function recalc(){
      stop();

      track.style.transform = 'translate3d(0,0,0)';

      var sizes = buildTrack();
      loopWidth = sizes.originalWidth + sizes.gapWidth;

      if (loopWidth <= 0) {
        loopWidth = track.scrollWidth;
      }

      pos = 0;
      lastTs = 0;
      track.style.transform = 'translate3d(0,0,0)';

      start();
    }

    function frame(ts){
      if (!lastTs) lastTs = ts;
      var delta = (ts - lastTs) / 1000;
      lastTs = ts;

      pos -= PX_PER_SECOND * delta;

      if (Math.abs(pos) >= loopWidth) {
        pos += loopWidth;
      }

      track.style.transform = 'translate3d(' + pos + 'px,0,0)';
      rafId = window.requestAnimationFrame(frame);
    }

    function scheduleRecalc(){
      if (resizeRaf) return;
      resizeRaf = window.requestAnimationFrame(function(){
        resizeRaf = 0;
        recalc();
      });
    }

    recalc();

    viewport.addEventListener('mouseenter', stop);
    viewport.addEventListener('mouseleave', start);

    window.addEventListener('resize', scheduleRecalc);

    if (window.ResizeObserver) {
      ro = new ResizeObserver(function(){
        scheduleRecalc();
      });
      ro.observe(viewport);
    }

    document.addEventListener('visibilitychange', function(){
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    });
  }

  function boot(ctx){
    (ctx || document).querySelectorAll('.ecto-ticker').forEach(function(root){
      setupTicker(root);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function(){ boot(document); });
  } else {
    boot(document);
  }

  var mo = new MutationObserver(function(mutations){
    mutations.forEach(function(mutation){
      mutation.addedNodes.forEach(function(node){
        if (!node || node.nodeType !== 1) return;
        if (node.matches && node.matches('.ecto-ticker')) {
          boot(node.parentNode || document);
        } else if (node.querySelectorAll) {
          boot(node);
        }
      });
    });
  });

  mo.observe(document.body, {
    childList: true,
    subtree: true
  });
})();
//# sourceURL=ecto-ticker-inline-script-js-after
</script>
