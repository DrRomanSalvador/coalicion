/* Formulario soporte */
.cf7-contact-form {
  max-width: 760px !important;
  margin: 0 auto !important;
  background: #F9FAFB !important;
  padding: 24px !important;
  border-radius: 8px !important;
  border: 1px solid #e5e7eb !important;
}

.cf7-contact-form h3 {
  margin: 0 0 18px !important;
  font-size: 20px !important;
  font-weight: 700 !important;
  color: #1f2937 !important;
}

.cf7-contact-form .flex-item,
.cf7-contact-form .flex-max {
  margin-bottom: 14px !important;
}

.cf7-contact-form label {
  display: block !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  color: #374151 !important;
  margin-bottom: 6px !important;
}

.cf7-contact-form .wpcf7-form-control-wrap {
  display: block !important;
  margin-top: 4px !important;
}

.cf7-contact-form input[type="text"],
.cf7-contact-form input[type="email"],
.cf7-contact-form select,
.cf7-contact-form textarea {
  width: 100% !important;
  

  border-radius: 4px !important;
  padding: 10px 12px !important;
  font-size: 14px !important;
  box-sizing: border-box !important;
  outline: none !important;
}

.cf7-contact-form input[type="text"],
.cf7-contact-form input[type="email"],
.cf7-contact-form select {
  height: 32px !important;
  line-height: 32px !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

.cf7-contact-form textarea {
  min-height: 90px !important;
  resize: vertical !important;
  padding-top: 10px !important;
}

.cf7-contact-form ::placeholder {
  color: #b7bcc7 !important;
  opacity: 1 !important;
}

.cf7-contact-form input:focus,
.cf7-contact-form select:focus,
.cf7-contact-form textarea:focus {
  border-color: #3b82f6 !important;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
}

.cf7-contact-form input[type="submit"] {
  width: 100% !important;
  height: 42px !important;              
  display: block !important;
  padding: 0 16px !important;           
  line-height: 42px !important;        
  text-align: center !important;     
  background: #1f2b3d !important;
  color: #fff !important;
  border: none !important;
  border-radius: 4px !important;
  font-weight: 700 !important;
  font-size: 14px !important;
  letter-spacing: .4px !important;
  cursor: pointer !important;
  box-sizing: border-box !important;
  -webkit-appearance: none !important;
  appearance: none !important;
}

.cf7-contact-form input[type="submit"]:hover {
  background: #162234 !important;
}

.cf7-contact-form .wpcf7-not-valid-tip {
  font-size: 12px !important;
  margin-top: 6px !important;
}

.cf7-contact-form .wpcf7-response-output {
  margin: 12px 0 0 !important;
  border-radius: 4px !important;
  font-size: 13px !important;
}


.cf7-contact-form , .cf7-contact-form label{
    width: 100%  !important;
}


.p-iniciar a{
	width:100%  !important;
}





