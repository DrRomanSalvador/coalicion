/* De 767px hacia abajo: solo controlamos los posts secundarios */
@media  (max-width: 767px) {

	/* #n-iniciales - segundo y tercer artículo: ancho completo + imagen derecha AUTO */
#n-iniciales .jeg_posts_wrap {
  inline-size: 100% !important;
  max-inline-size: 100% !important;
  clear: both !important;
}

#n-iniciales .jeg_posts_wrap .jeg_posts {
  display: block !important;
  inline-size: 100% !important;
  max-inline-size: 100% !important;
  margin-right: 0 !important;
}

/* Artículos 2 y 3 */
#n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) auto !important;
  align-items: center !important;
  column-gap: clamp(16px, 2vw, 32px) !important;

  inline-size: 100% !important;
  max-inline-size: 100% !important;
  float: none !important;
  clear: both !important;
  margin: 0 0 24px 0 !important;
}

/* Imagen a la derecha */
#n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard > .jeg_thumb {
  grid-column: 2 !important;
  grid-row: 1 !important;

  inline-size: clamp(150px, 30vw, 480px) !important;
  max-inline-size: 100% !important;

  float: none !important;
  margin: 0 !important;
  padding: 3px !important;
}

/* Texto a la izquierda */
#n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard > .jeg_postblock_content {
  grid-column: 1 !important;
  grid-row: 1 !important;

  min-inline-size: 0 !important;
  width: auto !important;
  max-width: none !important;
  margin-left: 0 !important;
  padding-left: 0 !important;
}

/* Enlace de imagen */
#n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard > .jeg_thumb > a:not(.jnews-edit-post) {
  display: block !important;
  width: auto !important;
  max-width: 100% !important;
}

/* Contenedor de imagen */
#n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard .thumbnail-container {
  width: auto !important;
  max-width: 100% !important;
  aspect-ratio: 1.35 / 1 !important;
  height: auto !important;
  overflow: hidden !important;
  position: relative !important;
  padding-bottom: 0 !important;
}

/* Imagen */
#n-iniciales .jeg_posts_wrap .jeg_posts > article.jeg_post.jeg_pl_sm.format-standard .thumbnail-container img {
  position: static !important;
  max-width: 100% !important;
  height: auto !important;
  min-width: 0 !important;
  display: block !important;
  object-fit: cover !important;
}
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
  #n-iniciales .jeg_posts_wrap {
    width: 100% !important;
    max-width: 100% !important;
    clear: both !important;
    display: block !important;
  }
