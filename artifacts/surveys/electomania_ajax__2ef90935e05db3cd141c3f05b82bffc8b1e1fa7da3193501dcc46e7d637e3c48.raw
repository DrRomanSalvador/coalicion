/* ============================================================
   COMPATIBILIDAD SHORTCODE [ecto_ticker] 
   ============================================================ */





#u-noticias,
.u-noticias.ecto-ticker,
.ecto-ticker-wrap {
  width: 95% !important;
  max-width: 100% !important;
	margin-left:auto !important;
}

#u-noticias .premium-post-ticker__outer-wrapper,
#u-noticias .premium-post-ticker__content {
  width: 100% !important;
  max-width: 100% !important;
}

#u-noticias .premium-post-ticker__inner-wrapper {
  display: flex !important;
  align-items: center !important;
  width: 100% !important;
  gap: 12px !important;
}

#u-noticias .premium-post-ticker__title-wrapper {
  flex: 0 0 auto !important;
}

#u-noticias .premium-post-ticker__posts-wrapper {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  width: 100% !important;
  overflow: hidden !important;
}

#u-noticias .premium-post-ticker__posts-wrapper .slick-list {
  width: 100% !important;
}

#u-noticias .slick-track {
  display: flex !important;
  align-items: center !important;
}

#u-noticias .premium-post-ticker__post-wrapper {
  position: relative !important;
  padding-right: 18px !important;
  margin-right: 12px !important;
}

#u-noticias .premium-post-ticker__post-title {
  margin: 0 !important;
}

#u-noticias .premium-post-ticker__post-title a {
  display: inline-flex !important;
  align-items: center !important;
  gap: 10px !important;
  text-decoration: none !important;
}

#u-noticias .ecto-name {
  font-weight: 800 !important;
  letter-spacing: .2px !important;
  white-space: nowrap !important;
}

#u-noticias .ecto-actual {
  color: #6b7280 !important;
  font-weight: 700 !important;
  white-space: nowrap !important;
}

#u-noticias .ecto-delta {
  font-weight: 800 !important;
  white-space: nowrap !important;
}

#u-noticias .ecto-up {
  color: #16a34a !important;
}

#u-noticias .ecto-down {
  color: #dc2626 !important;
}

#u-noticias .ecto-flat {
  color: #6b7280 !important;
}

#u-noticias.is-empty {
  display: none !important;
}

/* El título dentro del acordeón, equivalente CSS viejo del widget Premium */
#acordeon #u-noticias .premium-post-ticker__title-wrapper,
#acordeon #u-noticias .premium-post-ticker__title-wrapper .premium-post-ticker__title,
#acordeon #u-noticias .premium-post-ticker__title {
  background-color: #1F2939 !important;
  color: white !important;
}


#acordeon #u-noticias .premium-post-ticker__title-wrapper {
  padding: 0 !important;
}




.u-noticias-ecto .premium-post-ticker__date-wrapper.premium-addons-element {
