.elementor-element.elementor-element-18f8cb0.e-con-full.e-flex.e-con.e-child,.elementor-element.elementor-element-9dd32e1.e-con-full.e-flex.e-con.e-child{    z-index: 9999;
}
/* COMENTARIO */
#wpdiscuz-comment-message.wpdiscuz-comment-message-auth,#wpdiscuz-loading-bar.wpdiscuz-loading-bar-auth {
    top: 50%;
    right: 25%;
	width:50%;
}
.submenu ul{  display: flex !important;
  flex-wrap: nowrap!important;
  overflow-x: auto!important;
  overflow-y: hidden!important;}

#wpdiscuz-comment-message .wpdiscuz-message-error{
	padding:25px !important;
}

#wpdiscuz-loading-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#wpdiscuz-loading-bar::before {
    content: "" !important;
    display: inline-block !important;
    width: 18px !important;
    height: 18px !important;
    border: 2px solid rgba(136, 136, 136, 0.25) !important;
    border-top-color: #888 !important;
    background: transparent !important;
    border-radius: 50% !important;
    box-shadow: none !important;
    animation: wpdSpinner 0.8s linear infinite !important;
}

@keyframes wpdSpinner {
    100% {
        transform: rotate(360deg);
    }
}


#wpdiscuz-loading-bar.loading-bar-movido {
	    width: 100%;
    padding: 0px;
       min-height: 42px !important;

    -webkit-backdrop-filter: blur(8px);
}
#wpdiscuz-loading-bar.loading-bar-movido {
    position: absolute;
    top: 0px;
    right: 0px;
    z-index: 1;
   
    min-height: 42px;

    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

}

#wpdcom {
    position: relative;
}

#wpdiscuz-comment-message {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 9999 !important;
}




.custom-sh.elementor-widget.elementor-widget-shortcode{
	width:100% !important;
}
.custom-ir{
	    width: 100%;
	text-align:center !important;
	    display: inline-block;
    font-size: 15px;
    line-height: 1;
    padding: 12px 24px;
	background-color: #D1D5DB;
    font-family: "Montserrat", Sans-serif;
    font-size: 16px;
    font-weight: 700;
    fill: #000000;
    color: #000000;
    border-radius: 8px 8px 8px 8px;
	
}
.custom-sh.active.elementor-widget.elementor-widget-shortcode > div > div > span{
	background:#1F2938 !important;
	color:white !important;
}


