<style id="em-inart-estilo">
/* Altura suficiente para el 336x280 y el 300x250, que son los formatos con más
   demanda entre contenido. Y margen generoso para que se distinga del texto. */
/* Dos clases y !important: en el personalizador hay un .anuncio con
   min-height:120px !important que si no gana él. */
/* 21-sep-2026: el hueco solo sirve 728x90 y 468x60 en escritorio, y
   320x100 / 300x100 en movil. Con 300px de alto sobraban mas de 200px
   por anuncio: con cinco anuncios, mas de mil pixeles de vacio. */
.anuncio.anuncio-inarticle {
	min-height: 110px !important;
	width: 100%;
	margin: 34px 0;
	clear: both;
}

@media (max-width: 767px) {
	.anuncio.anuncio-inarticle {
		min-height: 110px !important;
		margin: 26px 0;
	}
}
</style>
