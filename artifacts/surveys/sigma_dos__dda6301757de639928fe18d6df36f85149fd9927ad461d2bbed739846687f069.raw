<style id="wp-custom-css">
.menu-master-btn > a {
  background-color: #1B2A4A;
  color: #ffffff !important;
  padding: 6px 9px;
  border-radius: 5px;
  font-weight: 600;
  font-size: 14px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: background 0.3s;
}

.menu-master-btn > a:hover {
  background-color: #2E75B6;
  color: #ffffff !important;
}

/* Espaciado general y estilo del texto de las preguntas (Labels) */
.wpcf7-form label {
    display: block;
    font-weight: 500;
    color: #374151; /* Un gris oscuro más sofisticado */
    margin-bottom: 24px; /* Separación limpia entre cada bloque */
}

/* Diseño elegante para los campos de texto, email y selector */
.class-codasistencia, 
.class-email, 
.class-app {
    width: 100%;
    background-color: #ffffff; /* Fondo completamente blanco */
    border: 1px solid #d1d5db; /* Borde gris fino y elegante */
    border-radius: 4px; /* Curvas menos pronunciadas, más formales */
    padding: 14px 16px;
    margin-top: 8px; /* Acerca el input a su pregunta */
    font-size: 16px;
    color: #1f2937;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05); /* Sombra muy sutil para dar volumen */
    transition: all 0.3s ease;
    box-sizing: border-box;
}

/* Efecto focus: Cuando el usuario hace clic para escribir */
.class-codasistencia:focus, 
.class-email:focus, 
.class-app:focus {
    border-color: #1a2b4c; /* Azul oscuro de Sigma Dos */
    box-shadow: 0 0 0 3px rgba(26, 43, 76, 0.1); /* Resplandor azul corporativo */
    outline: none;
}

/* Ajuste del campo de archivo para que no desentone */
.class-file {
    margin-top: 8px;
    font-size: 15px;
    color: #4b5563;
    padding: 10px 0;
}

/* Botón: Más imponente y corporativo */
.class-submit {
    background-color: #1a2b4c; /* Azul oscuro extraído del botón "TÍTULO PROPIO" de tu menú */
    color: #ffffff;
    border: none;
    padding: 16px 24px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
    text-transform: uppercase; /* Le da un toque más formal y contundente */
    transition: background-color 0.3s ease, transform 0.1s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

/* Efecto hover del botón */
.class-submit:hover {
    background-color: #2a406d; /* Un tono ligeramente más claro al pasar el ratón */
    transform: translateY(-1px); /* Efecto sutil de elevación */
}
</style>
</head>

