<div class="post-thumbnail-wrap">
	<div class="post-thumbnail">
		<div class="fancy-date"><a title="9:22 am" href="https://www.gad3.com/2021/05/20/" rel="nofollow"><span class="entry-date updated">20</span><span class="entry-month">May</span><span class="entry-year">2021</span></a></div>
		
		<a href="https://www.gad3.com/barometro-la-prensa/" class="post-thumbnail-rollover layzr-bg layzr-bg" ><img decoding="async" class="iso-lazy-load preload-me iso-lazy-load aspect" src="data:image/svg+xml,%3Csvg%20xmlns%3D&#39;http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg&#39;%20viewBox%3D&#39;0%200%20600%20400&#39;%2F%3E" data-src="https://www.gad3.com/wp-content/uploads/2021/05/depositphotos_69256623-stock-photo-panama-city.jpg" data-srcset="https://www.gad3.com/wp-content/uploads/2021/05/depositphotos_69256623-stock-photo-panama-city.jpg 600w" loading="eager" style="--ratio: 600 / 400" sizes="(max-width: 600px) 100vw, 600px" alt="" title="depositphotos_69256623-stock-photo-panama-city" width="600" height="400"  /></a>	</div>
