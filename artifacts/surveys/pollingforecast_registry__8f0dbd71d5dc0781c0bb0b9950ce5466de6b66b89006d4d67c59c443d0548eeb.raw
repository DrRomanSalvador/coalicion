        <script>
            (function () {
                function get(n) { var m = document.cookie.match(new RegExp('(?:^|; )' + n + '=([^;]*)')); return m ? decodeURIComponent(m[1]) : null; }
                function set(n, v) { try { document.cookie = n + '=' + v + '; Max-Age=31536000; Path=/; SameSite=Lax'; } catch (e) { } }
                var names = { uk: 'United Kingdom', fr: 'France', de: 'Germany', es: 'Spain', it: 'Italy', nl: 'the Netherlands', pl: 'Poland', ca: 'Canada', au: 'Australia', us: 'the United States' };
return;                var home = get('pf_home'), mode = 'bar';
                var fromOutside = !document.referrer || document.referrer.indexOf(location.host) < 0;
                if (mode === 'redirect returning visitors' && home && names[home] && fromOutside && location.search.indexOf('stay') < 0) { location.replace('/' + home); return; }
                if (get('pf_geo') === 'x' || home) return;
                var bar = document.querySelector('[data-geo]'); if (!bar || !window.fetch) return;
                fetch('/api/where', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
                    if (!d || !d.cc || !names[d.cc]) return;
                    var n = names[d.cc], short = n.replace(/^the /, '');
                    bar.querySelector('[data-geo-text]').textContent = 'You seem to be in ' + n + '.';
                    var a = bar.querySelector('[data-geo-go]'); a.href = '/' + d.cc; a.textContent = 'Go to the ' + (short === 'United States' ? 'US' : short === 'United Kingdom' ? 'UK' : short) + ' forecast \u2192';
                    bar.hidden = false;
                    var sh = document.querySelector('[data-start-here]'); if (sh) sh.hidden = true;   // one bar at a time
                    if (window.gtag) try { gtag('event', 'geo_bar', { country: d.cc }); } catch (e) { }
                    bar.querySelector('[data-geo-x]').addEventListener('click', function () { bar.hidden = true; set('pf_geo', 'x'); });
                }).catch(function () { });
            })();
        </script>
