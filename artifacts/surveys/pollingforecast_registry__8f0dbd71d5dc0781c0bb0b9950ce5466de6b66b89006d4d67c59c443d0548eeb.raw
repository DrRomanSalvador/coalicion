        <script>
            (function () {
                var bar = document.querySelector('[data-start-here]'); if (!bar) return;
                var m = document.cookie.match(/(?:^|; )pf_start=(\d+)/), n = m ? +m[1] : 0;
                function set(v) { document.cookie = 'pf_start=' + v + '; Max-Age=31536000; Path=/; SameSite=Lax'; }
                if (n >= 5) return;
                bar.hidden = false; set(n + 1);
                bar.querySelector('[data-start-here-x]').addEventListener('click', function () { bar.hidden = true; set(5); });
            })();
        </script>

    
