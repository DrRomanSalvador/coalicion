{
  "$schema": "https://www.schemastore.org/wrangler",
  "name": "coalicion-telegram",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coalicion-telegram-state"
    }
  ]
}
